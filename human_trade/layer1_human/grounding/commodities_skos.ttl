<id/11/1181/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Tortoise Shell"@en ;
    skos:broader <id/grp/grp_fertilizers_animal_materials/#concept> ;
    skos:closeMatch aat:300011837 ;
    skos:definition "the imbricated plates covering the back of the sea-turtle, *Chelone imbricata* and *caretta*, used for making combs, and veneering on fancy cabinet-work. Five large plates are obtained from the middle of the carapace or upper buckler, and four large ones from the sides, called \"blades\" and twenty-five smaller plates from the edges called \"feet or noses.\" In an animal of the ordinary size, about three feet long and 2½ wide, the largest plates will weigh about 9 oz., and measure about 13 by 8 inches, and one-fourth of an inch thick in the middle. The belly shells are of a yellow colour, and are used for the purposes of horn. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 397]"@en ;
    skos:editorialNote "Curated classification (group=grp_fertilizers_animal_materials; land_basis=marine): Marine animal raw material (mother-of-pearl, tortoise/turtle shell, pearls) left in the residual bin. Layer-1 observations: 18 rows, 1866–1866. Series: HCPP_Annual Statement of Trade ×18. Units: Lbs. (Pounds) ×18. Top routes: France → United Kingdom ×1; Holland → United Kingdom ×1; World → United Kingdom ×1; Australia → United Kingdom ×1."@en ;
    skos:exactMatch wd:Q2141546 ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "1181" ;
    skos:prefLabel "Tortoise Shell"@en ;
    prov:hadPrimarySource <ontology/series_hcpp_annual_statement_of_trade/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n397>, <https://archive.org/details/generalcommercia00mort/page/n968>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/firstAttested/#resource> "1866"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "grounded_wikidata_lexical" ;
    <ontology/harvestMode/#resource> "wild_hunted_fished" ;
    <ontology/isAggregate/#resource> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    <ontology/landBasis/#resource> "marine" ;
    <ontology/lastAttested/#resource> "1866"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/mappingAuthority/#resource> "wikidata_slim:2026-11-09" ;
    <ontology/observationCount/#resource> "18"^^<http://www.w3.org/2001/XMLSchema#integer> ;
