    oe:sitcCode "SITC4_67_68_Metals" ;
    oe:isAggregate "false"^^xsd:boolean ;
    skos:definition "is one of the metals most anciently known. It was named from the island of Cyprus, where it was extensively mined and smelted by the Greeks. It has a reddish brown colour inclining to yellow; a faint but nauseous and rather disagreeable taste; and when rubbed between the fingers it imparts a smell somewhat analogous to its taste. Its specific gravity is from 8·8 to 8·9. It is much more malleable than it is ductile; so that far finer leaves may be obtained from it than wire.... [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    oe:dictionarySource <https://www.gutenberg.org/ebooks/44562>, <https://archive.org/details/b21780535/page/n117>, <https://archive.org/details/b21780535/page/n457> ;
    oe:firstAttested "1881"^^xsd:integer ;
    oe:lastAttested "1881"^^xsd:integer ;
    prov:hadPrimarySource oe:series_hcpp_annual_statement_of_trade ;
    oe:mappingAuthority "wikidata_slim:2026-11-09" ;
    skos:broadMatch htc1866:metal, wd:Q753, agrovoc:c_1868, stw:14299-5, aat:300011020 .

