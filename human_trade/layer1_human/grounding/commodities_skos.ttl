<ontology/series_kew_cust_5/#resource> a prov:Entity ;
    rdfs:label "KEW_CUST 5"@en .

<ontology/series_newfoundland_data/#resource> a prov:Entity ;
    rdfs:label "Newfoundland_data"@en .

<ontology/sitcCode/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "SITC Rev. 4 division code"@en ;
    rdfs:range xsd:string .

<ontology/sourceTaxon/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "biological source taxon (Wikidata/CoL)"@en ;
    owl:inverseOf <ontology/isSourceTaxonOf/#resource> .

<ontology/substanceHead/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "substance head"@en ;
    rdfs:range xsd:string .

<ontology/theodoridisBucket/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "Theodoridis (2018) 5-bucket rollup"@en ;
    rdfs:range xsd:string .
