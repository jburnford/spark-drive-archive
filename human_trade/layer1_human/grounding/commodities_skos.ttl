    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n186>, <https://archive.org/details/generalcommercia00mort/page/n467>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/firstAttested/#resource> "1800"^^<http://www.w3.org/2001/XMLSchema#integer> ;
