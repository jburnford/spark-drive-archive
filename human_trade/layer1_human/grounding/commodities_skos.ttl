<ontology/ScopedReading/#resource> a owl:Class ;
    rdfs:label "reading of a customs heading that holds only for a stated series, period or unit"@en .

<ontology/attestationBasis/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "attestation basis (customs_enumerated vs document_attested)"@en ;
    rdfs:range xsd:string .

<ontology/colId/#resource> a owl:DatatypeProperty ;
    rdfs:label "Catalogue of Life taxon ID"@en ;
    rdfs:range xsd:string .

<ontology/combinesConcept/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "merged customs line combining constituent archival concepts"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/isCombinedInConcept/#resource> .

<ontology/definesConcept/#resource> a owl:ObjectProperty ;
    rdfs:label "archival concept defined by this dictionary source page"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/dictionarySource/#resource> .

<ontology/dictionarySource/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "19th-century commercial dictionary source page"@en ;
    owl:inverseOf <ontology/definesConcept/#resource> .

<ontology/firstAttested/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "first attested ledger year"@en ;
    rdfs:range xsd:integer .

<ontology/ghostAcresDomain/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "Ghost Acres analytical domain"@en ;
    rdfs:range xsd:string .

<ontology/groundingStatus/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "Layer-B grounding status"@en ;
    rdfs:range xsd:string .

<ontology/harvestMode/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "harvest mode (wild_hunted_fished joins wild land animals to fisheries and whaling)"@en ;
    rdfs:range xsd:string .

<ontology/inferredPrimarySource/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "series attributed by inference: the series cell is blank in the transcription"@en ;
    rdfs:range prov:Entity .

<ontology/isAggregate/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "is printed total/aggregate heading"@en ;
    rdfs:range xsd:boolean .

<ontology/isCombinedInConcept/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "merged customs heading combining this archival concept"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/combinesConcept/#resource> .

<ontology/isMaterialConceptOf/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "derived ore/semi-finished/manufactured concept using this base material"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/materialConcept/#resource> .

<ontology/isMaterialOf/#resource> a owl:ObjectProperty ;
    rdfs:label "archival commodity concept made from this base material"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/madeOfMaterial/#resource> .

<ontology/isSourceTaxonOf/#resource> a owl:ObjectProperty ;
    rdfs:label "archival commodity concept derived from this biological taxon"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/sourceTaxon/#resource> .

<ontology/landBasis/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "ecological land/marine/mineral basis"@en ;
    rdfs:range xsd:string .

<ontology/lastAttested/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "last attested ledger year"@en ;
    rdfs:range xsd:integer .

<ontology/madeOfMaterial/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "base material of manufactured article or ore (Wikidata)"@en ;
    owl:inverseOf <ontology/isMaterialOf/#resource> .

<ontology/mappingAuthority/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "Layer-B mapping authority snapshot"@en ;
    rdfs:range xsd:string .

<ontology/matchedObservationCount/#resource> a owl:DatatypeProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "Layer-1 rows falling inside the scope of a reading"@en ;
    rdfs:range xsd:integer .

<ontology/materialConcept/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "canonical base-material archival concept in htc:scheme"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/isMaterialConceptOf/#resource> .

<ontology/observationCount/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "Layer-1 human observation count"@en ;
    rdfs:range xsd:integer .

<ontology/processingState/#resource> a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "processing state facet"@en ;
    rdfs:range xsd:string .

<ontology/readingOf/#resource> a owl:ObjectProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "customs heading that a scoped reading interprets"@en ;
    rdfs:range skos:Concept .

<ontology/readingStatus/#resource> a owl:DatatypeProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "supported | probable | unresolved"@en ;
    rdfs:range xsd:string .

<ontology/scopeSeries/#resource> a owl:DatatypeProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "series (regular expression) to which a scoped reading applies"@en ;
    rdfs:range xsd:string .

<ontology/scopeUnit/#resource> a owl:DatatypeProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "printed unit (regular expression) to which a scoped reading applies"@en ;
    rdfs:range xsd:string .

<ontology/scopeYearFrom/#resource> a owl:DatatypeProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "first year of a scoped reading"@en ;
    rdfs:range xsd:integer .

<ontology/scopeYearTo/#resource> a owl:DatatypeProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "last year of a scoped reading"@en ;
    rdfs:range xsd:integer .

