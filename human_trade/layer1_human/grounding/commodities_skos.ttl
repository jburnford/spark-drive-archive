<id/09/0991/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Copper Unenumerated"@en ;
    skos:broadMatch agrovoc:c_1868, aat:300011020, wd:Q753, stw:14299-5, <customs-1866/metal/#concept> ;
    skos:broader <id/sub/sub_metals_sem_wd_q753/#concept> ;
    skos:definition "is one of the metals most anciently known. It was named from the island of Cyprus, where it was extensively mined and smelted by the Greeks. It has a reddish brown colour inclining to yellow; a faint but nauseous and rather disagreeable taste; and when rubbed between the fingers it imparts a smell somewhat analogous to its taste. Its specific gravity is from 8·8 to 8·9. It is much more malleable than it is ductile; so that far finer leaves may be obtained from it than wire. It melts at the 27th degree of Wedgewood’s pyrometer, and at a higher temperature it evaporates in fumes which tinge the fire of a bluish green. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0991" ;
    skos:prefLabel "Copper Unenumerated"@en ;
    prov:hadPrimarySource <ontology/series_hcpp_annual_statement_of_trade/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n117>, <https://archive.org/details/b21780535/page/n457>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/firstAttested/#resource> "1881"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "grounded_wikidata_v4" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/isAggregate/#resource> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/lastAttested/#resource> "1881"^^<http://www.w3.org/2001/XMLSchema#integer> ;
