<id/00/0003/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Oats"@en ;
    skos:broader <id/sub/sub_cereals_gr_wd_q24265484/#concept> ;
    skos:definition "the seed of the *Avena sativa*, the hardest of all the cereal grasses, of which there are many cultivated varieties: it is extensively used as a horse-food, and also for bread and porridge in the northern counties, being hardy and containing a large amount of nutritive matter. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 274]"@en ;
