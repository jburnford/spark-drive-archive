<id/13/1374/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Anchovies"@en ;
    skos:broader <id/grp/grp_fish_seafood/#concept> ;
    skos:definition "(GER. *Anschovis*. DU. and Sw. *Ansjovis*. DA. *Ansios*. FR. *Anchois*. IT. *Acciughe*. SR. and PORT. *Anchovas*. RUS. *Antshofischi*. LAT. *Encrasicoli*,) the name of a small sea-fish common in the Mediterranean. The fishing for anchovies is carried on chiefly in the night-time; when a light being put on the stern of the vessels, the fish flock round, and are caught in the nets. The anchovy is much used in sauces from the excellency of its taste. The importation of anchovies is especially provided for by sect. 14. of 10 & 11 W. 5. c. 24., by an exception to the prohibitions contained in the navigation act of Car. 2. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 55]"@en ;
    skos:exactMatch wd:Q4589261 ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "1374" ;
    skos:prefLabel "Anchovies"@en ;
    prov:hadPrimarySource <ontology/series_kew_cust_4/#resource>, <ontology/series_kew_cust_5/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n55> ;
    <ontology/firstAttested/#resource> "1800"^^<http://www.w3.org/2001/XMLSchema#integer> ;
