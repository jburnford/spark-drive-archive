htc:0002 a skos:Concept ;
    skos:inScheme htc:scheme ;
    skos:notation "0002" ;
    skos:prefLabel "Butter"@en ;
    skos:broader htc:sub_dairy_eggs_wd_q34172 ;
    oe:observationCount "2148"^^xsd:integer ;
    oe:groundingStatus "grounded_wikidata_v4" ;
    oe:substanceHead "Butter" ;
    oe:processingState "dairy_processed" ;
    oe:ghostAcresDomain "food_animal" ;
    oe:landBasis "terrestrial_pasture" ;
    oe:theodoridisBucket "animals_and_animal_products" ;
    oe:sitcCode "SITC4_02_Dairy_and_Eggs" ;
    oe:isAggregate "false"^^xsd:boolean ;
    skos:definition "a common name for all animal and vegetable solid oils and fats, but popularly applied to that from the milk of the cow, used for food. The home production of butter is very considerable; but we also import large quantities from the United States, the Continent, and Ireland. Fresh butter is sold in printed pats, or one pound rolls—salted butter in bulk. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 69]"@en ;
    oe:dictionarySource <https://archive.org/details/b21780535/page/n69>, <https://archive.org/details/generalcommercia00mort/page/n187>, <https://www.gutenberg.org/ebooks/44562> ;
    oe:firstAttested "1800"^^xsd:integer ;
    oe:lastAttested "1940"^^xsd:integer ;
