<id/06/0600/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Walnuts"@en ;
    skos:altLabel "walnut"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:closeMatch aat:300266426 ;
    skos:definition "The fruit of the *Juglans*, or walnut-tree, of which there are several varieties. The walnut is a large handsome tree, with strong spreading branches. The fruit is a pretty large smooth, ovate nut, containing an oily kernel, divided into four lobes. The nut has been always held in high estimation: it was called by the Romans *Jovis glans*, the acorn or mast of Jove, and hence the name of the tree. The walnut tree is indigenous to Persia and the countries bordering on the Caspian Sea. It has long been introduced into Great Britain; but the fruit seldom ripens in the more northerly parts of the island. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1622]"@en ;
    skos:exactMatch wd:Q208021 ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0600" ;
    skos:prefLabel "Walnuts"@en ;
    prov:hadPrimarySource <ontology/series_hcpp_annual_statement_of_trade/#resource>, <ontology/series_kew_cust_4/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/dictionaryprac00mccu/page/n1622> ;
    <ontology/firstAttested/#resource> "1819"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "grounded_wikidata_v4" ;
