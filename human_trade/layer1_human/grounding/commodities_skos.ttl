<id/02/0204/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Meal Unenumerated"@en ;
    skos:broadMatch aat:300389812, wd:Q36465 ;
    skos:broader <id/sub/sub_cereals_gr_wd_q36465/#concept> ;
    skos:definition "(GER. *Mehl.* DU. and DA. *Meal.* SW. *Mjöl.* FR. and IT. *Farine.* SP. *Harina.* PORT. *Farinha.* RUS. *Muka.* POL. *Maka.* LAT. *Farina,*) the edible part of wheat, oats, rye, barley, and pulse of different kinds, ground into a species of flour. The difference between flour, properly so called, and meal, is, that the former is freed from the husky part, and other impurities of the species of corn whereof it is made, but the latter is not. Meal is denominated according to the kind of grain that affords it; such as oat-meal, rye-meal, barley-meal, &c. Scotland is famous for oat-meal; England, America, and Normandy in France, excel most in meal of wheat. See CORN. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 628]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0204" ;
    skos:prefLabel "Meal Unenumerated"@en ;
    prov:hadPrimarySource <ontology/series_csp_canadian_trade_and_navigation/#resource>, <ontology/series_hcpp_annual_statement_of_trade/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n628> ;
    <ontology/firstAttested/#resource> "1861"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/ghostAcresDomain/#resource> "food_grain" ;
    <ontology/groundingStatus/#resource> "grounded_wikidata_v4" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/inferredPrimarySource/#resource> <ontology/series_csp_canadian_exports_blankseries/#resource> ;
    <ontology/isAggregate/#resource> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/lastAttested/#resource> "1901"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/mappingAuthority/#resource> "wikidata_slim:2026-11-09" ;
    <ontology/observationCount/#resource> "175"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/processingState/#resource> "milled_ground" ;
    <ontology/sitcCode/#resource> "SITC4_04_Cereals_and_Preparations" ;
    <ontology/substanceHead/#resource> "Meal" ;
    <ontology/theodoridisBucket/#resource> "grain_and_flour" .

<id/02/0205/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Stone"@en ;
    skos:broader <id/sub/sub_industrial_wd_q22731/#concept> ;
    skos:closeMatch aat:300011176 ;
    skos:definition "is earthy matter, condensed into so hard a state as to yield only to the blows of a hammer, and therefore well adapted to the purposes of building. Such was the care of the antients to provide strong and durable materials for their public edifices, that but for the desolating hands of modern barbarians, in peace and in war, most of the temples and other public monuments of Greece and of Rome would have remained perfect at the present day, uninjured by the elements during 2000 years. The contrast, in this respect, of the works of modern architects, especially in Great Britain, is very humiliating to those who boast so loudly of social advancement; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:editorialNote "Curated fields — definition use: Auto-match had picked the weight 'stone' (14 lbs); heading is building stone."@en ;
    skos:exactMatch wd:Q22731 ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0205" ;
    skos:prefLabel "Stone"@en ;
    prov:hadPrimarySource <ontology/series_csp_canadian_trade_and_navigation/#resource>, <ontology/series_kew_cust_4/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n374>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/firstAttested/#resource> "1822"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "grounded_wikidata_v4" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/inferredPrimarySource/#resource> <ontology/series_csp_canadian_exports_blankseries/#resource> ;
    <ontology/isAggregate/#resource> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
