<id/00/0001/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Wheat"@en ;
    skos:broadMatch <customs-1866/corn/#concept> ;
    skos:broader <id/sub/sub_cereals_gr_wd_q15645384/#concept> ;
    skos:closeMatch stw:14098-1 ;
    skos:definition "a name for species of *Triticum*, one of the most important of the food grains, and that most generally cultivated in Europe; the flour being the most nutritious and platable of all the cereal grasses. The quantity raised in this country is very large, amounting to about 19,000,000 quarters, and we also import 7,000,000 or 8,000,000 quarters a year. See **FLOUR**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 422]"@en ;
    skos:editorialNote "Curated fields — definition use: Previous text was only a cross-reference ('See BREAD, GLUTEN, and STARCH')."@en ;
    skos:exactMatch wd:Q15645384 ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0001" ;
    skos:prefLabel "Wheat"@en ;
    prov:hadPrimarySource <ontology/series_csp_canadian_trade_and_navigation/#resource>, <ontology/series_hcpp_annual_statement_of_trade/#resource>, <ontology/series_hcpp_annual_statement_of_trade_1910_1940_ext/#resource>, <ontology/series_hcpp_other/#resource>, <ontology/series_kew_cust_4/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n422>, <https://archive.org/details/dictionaryprac00mccu/page/n1643>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/firstAttested/#resource> "1807"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/ghostAcresDomain/#resource> "food_grain" ;
    <ontology/groundingStatus/#resource> "grounded_wikidata_v4" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/inferredPrimarySource/#resource> <ontology/series_csp_canadian_exports_blankseries/#resource> ;
    <ontology/isAggregate/#resource> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/lastAttested/#resource> "1940"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/mappingAuthority/#resource> "wikidata_slim:2026-11-09" ;
    <ontology/observationCount/#resource> "2633"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/processingState/#resource> "raw_unprocessed" ;
    <ontology/sitcCode/#resource> "SITC4_04_Cereals_and_Preparations" ;
