    oe:theodoridisBucket "raw_materials" ;
    oe:sitcCode "SITC4_54_Medicinal_Pharmaceutical" ;
    oe:isAggregate "false"^^xsd:boolean ;
    skos:definition "*Linn.*; *Fl. Br. Ind.*, vi., 264; *Pharmacog. Ind.*, iii., 467-76; *Rept. Cent. Indig. Drugs Comm.*, i., 116, 126, 149, 158; HÆMODORACEÆ. **D.E.P.**, i., 179-80. **Aloes.** Several species of ALOE and diverse methods of extracting, drying and preserving the juice result in the supply of the different known qualities of this drug. The following species may be specially mentioned as affording the major portions of the aloes of Indian commerce:— **A. abyssinica**, *Lam.*;... [Sir George Watt, The Commercial Products of India (1908), scan p. 71]"@en ;
    oe:dictionarySource <https://archive.org/details/b31361584/page/n71> ;
    oe:firstAttested "1800"^^xsd:integer ;
