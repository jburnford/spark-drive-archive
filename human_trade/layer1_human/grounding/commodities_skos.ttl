    oe:isAggregate "false"^^xsd:boolean ;
    skos:definition "(GER. *Bug-* 162 *sprit*. DU. *Boegsprit*. DA. *Bougsprid*. SW. *Bogsprit*. FR. *Beaupré*. IT. *Buonpresso*, *Copresso*. SP. *Baupres*. PORT. *Gurupes*. RUS. *Buckschprit*,) a kind of mast, resting slopewise on the head of the main stem, and having its lower end fastened to the partners of the foremast, and farther supported by the fore-stay. It carries the sprit-sail, sprit-top-sail, and jack-staff; and its length is usually the same with that of the fore-mast. BOWYERS,... [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 172]"@en ;
    oe:dictionarySource <https://archive.org/details/generalcommercia00mort/page/n172> ;
    oe:firstAttested "1807"^^xsd:integer ;
    oe:lastAttested "1814"^^xsd:integer ;
    prov:hadPrimarySource oe:series_csp_canadian_exports_blankseries .

