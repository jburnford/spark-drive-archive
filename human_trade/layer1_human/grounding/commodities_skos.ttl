<id/06/0684/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Turpentine"@en ;
    skos:broader <id/sub/sub_gums_resin_wd_q201382/#concept> ;
    skos:closeMatch aat:300015288, aat:300375603 ;
    skos:definition "(_Térébinthine_, Fr.; _Terpenthin_, Germ.); is a substance which flows out of incisions made in the stems of several species of pines. It has the consistence and gray-yellow colour of honey. It has a smell which is not disagreeable to many persons, a warm, sharp, bitterish taste; dries into a solid in the air, with the evaporation of its volatile oil. It becomes quite fluid at a moderate elevation of temperature, and burns at a higher heat, with a bright but very fuliginous flame. There are several varieties of turpentine. 1. _Common turpentine_, is extracted from incisions in the _Pinus abies_ and _Pinus silvestris_. It has little smell; but a bitter burning taste. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:exactMatch wd:Q201382 ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0684" ;
    skos:prefLabel "Turpentine"@en ;
    prov:hadPrimarySource <ontology/series_hcpp_annual_statement_of_trade/#resource>, <ontology/series_hcpp_other/#resource>, <ontology/series_kew_cust_4/#resource>, <ontology/series_kew_cust_5/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n405>, <https://archive.org/details/b21780535/page/n515>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/firstAttested/#resource> "1800"^^<http://www.w3.org/2001/XMLSchema#integer> ;
