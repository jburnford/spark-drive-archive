oe:substanceHead a owl:DatatypeProperty ; rdfs:label "substance head"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:processingState a owl:DatatypeProperty ; rdfs:label "processing state facet"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:ghostAcresDomain a owl:DatatypeProperty ; rdfs:label "Ghost Acres analytical domain"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:landBasis a owl:DatatypeProperty ; rdfs:label "ecological land/marine/mineral basis"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:theodoridisBucket a owl:DatatypeProperty ; rdfs:label "Theodoridis (2018) 5-bucket rollup"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:sitcCode a owl:DatatypeProperty ; rdfs:label "SITC Rev. 4 division code"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:isAggregate a owl:DatatypeProperty ; rdfs:label "is printed total/aggregate heading"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:boolean .
oe:observationCount a owl:DatatypeProperty ; rdfs:label "Layer-1 human observation count"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:integer .
oe:firstAttested a owl:DatatypeProperty ; rdfs:label "first attested ledger year"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:integer .
oe:lastAttested a owl:DatatypeProperty ; rdfs:label "last attested ledger year"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:integer .
oe:groundingStatus a owl:DatatypeProperty ; rdfs:label "Layer-B grounding status"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:mappingAuthority a owl:DatatypeProperty ; rdfs:label "Layer-B mapping authority snapshot"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string .
oe:dictionarySource a owl:ObjectProperty ; rdfs:label "19th-century commercial dictionary source page"@en ; rdfs:domain skos:Concept .
oe:combinesConcept a owl:ObjectProperty ; rdfs:label "merged customs line combining constituent archival concepts"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept .
oe:sourceTaxon a owl:ObjectProperty ; rdfs:label "biological source taxon (Wikidata/CoL)"@en ; rdfs:domain skos:Concept .
oe:madeOfMaterial a owl:ObjectProperty ; rdfs:label "base material of manufactured article or ore (Wikidata)"@en ; rdfs:domain skos:Concept .
oe:materialConcept a owl:ObjectProperty ; rdfs:label "canonical base-material archival concept in htc:scheme"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept .
oe:colId a owl:DatatypeProperty ; rdfs:label "Catalogue of Life taxon ID"@en ; rdfs:range xsd:string .

htc:scheme a skos:ConceptScheme ;
    dcterms:title "Open Empire Layer-1 Human-Transcribed Trade Commodities Ontology (v4)"@en ;
    dcterms:description "Four-tier historical archival SKOS ontology (9 Macro-Sectors -> 43 Commodity Groups -> Canonical Substance Groups -> 2,066 persistent verbatim British & Canadian customs headings) enriched with definitions, synonyms, cross-references, and verified Linnaean source taxa mined from six 19th-century commercial dictionaries (Simmonds 1892/1854, Mortimer 1823, McCulloch 1880, Watt 1908, Ure) and linked via reversible multi-anchor SKOS mappings to Wikidata (2026-11-09), FAO AGROVOC, ZBW STW Economics, Getty AAT, Catalogue of Life, SITC Rev. 4, and Theodoridis (2018)."@en ;
    dcterms:creator "Dr. Jim Clifford & HGIS Lab, University of Saskatchewan"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-11-25"^^xsd:date ;
    owl:versionInfo "4.0-layer1-human-dict-enriched" ;
    skos:hasTopConcept htc:sec_botanicals_dyes_chemicals, htc:sec_fibres_textiles, htc:sec_food_and_drink, htc:sec_forestry_timber, htc:sec_hides_skins_tanning, htc:sec_livestock_fodder, htc:sec_minerals_metals_manufactures, htc:sec_oils_fats_waxes, htc:sec_unclassified_residuals .

htc1866:scheme a skos:ConceptScheme ;
    dcterms:title "1866 British Customs Curated Broader Concepts (SKOS_from_Custom_Records.xlsx)"@en ;
    skos:hasTopConcept htc1866:animal, htc1866:animal_byproduct, htc1866:animal_part, htc1866:bark, htc1866:birds, htc1866:chemical, htc1866:corn, htc1866:dairy, htc1866:dairy_product, htc1866:drug, htc1866:extract_from_lichens, htc1866:fat, htc1866:fiber, htc1866:fish, htc1866:fish_part_collagen, htc1866:flower, htc1866:forest_product, htc1866:fruit, htc1866:fungus, htc1866:grain_corn, htc1866:human_hair, htc1866:hydrocarbon, htc1866:latex, htc1866:meat, htc1866:meat_animal, htc1866:metal, htc1866:mineral, htc1866:oleoresin, htc1866:pigment, htc1866:plant, htc1866:plant_root, htc1866:resin, htc1866:resin_from_insects, htc1866:sap, htc1866:sea_life, htc1866:seafood, htc1866:seed, htc1866:tannins, htc1866:tarred_fiber, htc1866:timber, htc1866:tree_sap, htc1866:tuber, htc1866:vegetable .

