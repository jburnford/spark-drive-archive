<id/05/0597/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Tamarinds"@en ;
    skos:broadMatch aat:300011868, wd:Q1364, <customs-1866/fruit/#concept> ;
    skos:broader <id/sub/sub_fruits_nut_wd_q1364/#concept> ;
    skos:definition "(Ger. tamarinden; Fr. tamarins; Ital. and Span. tamarindo; Arab. umblie; Hind. tintiri), the preserved pulp of the *Tamarindus Indica*, a tree which grows in the East and West Indies, in Arabia, and Egypt. In the West Indies the pods or fruit, being gathered when ripe, and freed from the shelly fragments, are placed in layers in a cask, and boiling syrup poured over them till the cask be filled; the syrup pervades every part quite down to the bottom; and when cool, the cask is headed for sale. The East India tamarinds are darker coloured and drier, and are said to be preserved without sugar. When good, tamarinds are free from any degree of mustiness; the seeds are hard, flat, and clean; the strings tough and entire; [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1476]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0597" ;
    skos:prefLabel "Tamarinds"@en ;
    prov:hadPrimarySource <ontology/series_hcpp_annual_statement_of_trade/#resource>, <ontology/series_kew_cust_4/#resource>, <ontology/series_kew_cust_5/#resource> ;
    <ontology/attestationBasis/#resource> "customs_enumerated" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/dictionaryprac00mccu/page/n1476>, <https://archive.org/details/generalcommercia00mort/page/n955> ;
    <ontology/firstAttested/#resource> "1800"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "grounded_wikidata_v4" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/isAggregate/#resource> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/lastAttested/#resource> "1866"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/mappingAuthority/#resource> "wikidata_slim:2026-11-09" ;
    <ontology/observationCount/#resource> "59"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <ontology/processingState/#resource> "unspecified" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/sourceTaxon/#resource> wd:Q80235 ;
    <ontology/substanceHead/#resource> "Tamarinds" ;
    <ontology/theodoridisBucket/#resource> "other_food_drink_spices" .

