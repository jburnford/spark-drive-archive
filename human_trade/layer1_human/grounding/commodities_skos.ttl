<id/00/0002/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Butter"@en ;
    skos:broadMatch <customs-1866/dairy/#concept> ;
    skos:broader <id/sub/sub_dairy_eggs_wd_q34172/#concept> ;
    skos:closeMatch agrovoc:c_1162, aat:300389819 ;
    skos:definition "a common name for all animal and vegetable solid oils and fats, but popularly applied to that from the milk of the cow, used for food. The home production of butter is very considerable; but we also import large quantities from the United States, the Continent, and Ireland. Fresh butter is sold in printed pats, or one pound rolls—salted butter in bulk. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 69]"@en ;
    skos:exactMatch wd:Q34172 ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0002" ;
    skos:prefLabel "Butter"@en ;
    prov:hadPrimarySource <ontology/series_csp_canadian_trade_and_navigation/#resource>, <ontology/series_hcpp_annual_statement_of_trade/#resource>, <ontology/series_hcpp_annual_statement_of_trade_1910_1940_ext/#resource>, <ontology/series_hcpp_other/#resource>, <ontology/series_kew_cust_4/#resource>, <ontology/series_kew_cust_5/#resource> ;
