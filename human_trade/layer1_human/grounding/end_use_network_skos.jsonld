    {
      "@id": "oe:ind_woollen_silk_dyeing",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Woollen, Silk & Worsted Dyeing",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "oe:industry_scheme"
      },
      "skos:topConceptOf": {
        "@id": "oe:industry_scheme"
      },
      "skos:prefLabel": {
        "@value": "Woollen, Silk & Worsted Dyeing",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Woollen, worsted, and silk scouring, fulling, and dyeing — employing raw wool and silk with scarlet/crimson insect dyes (cochineal, lac dye, kermes), lichen dyes (orchal, archil, cudbear), indigo/woad vats, alum/tartar/tin mordants, olive oil, and fuller's earth.",
        "@language": "en"
      },
