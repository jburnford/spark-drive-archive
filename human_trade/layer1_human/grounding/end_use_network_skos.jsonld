      "skos:prefLabel": {
        "@value": "Glassmaking, Pottery & Porcelain",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Crown, plate, bottle, and flint glassmaking plus earthenware and bone-china porcelain — fusing sand/flint and kaolin/china clay with soda ash, barilla, kelp, potash, lime, red lead/litharge, manganese, borax, cobalt/smalt, and calcined bone ash.",
