      "skos:prefLabel": {
        "@value": "Leather Tanning, Tawing & Currying",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Tanning, tawing, and currying raw ox/calf/sheep/goat hides into sole, harness, morocco, Russia, and chamois leather — using oak, hemlock, and mimosa barks, valonia, sumach, cutch, myrabolans, divi-divi, lime, alum, salt, tallow, and fish/train oils.",
