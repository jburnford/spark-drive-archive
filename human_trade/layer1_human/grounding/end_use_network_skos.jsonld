    {
      "@id": "oe:ind_leather_tanning",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Leather Tanning, Tawing & Currying",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "oe:industry_scheme"
      },
