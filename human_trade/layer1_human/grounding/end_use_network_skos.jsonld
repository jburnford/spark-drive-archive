      "skos:topConceptOf": {
        "@id": "oe:industry_scheme"
      },
      "skos:prefLabel": {
        "@value": "Soap Manufacture",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Hard, soft, yellow, mottled, curd, Castile, and toilet soap manufacture — combining animal tallow and tropical/vegetable oils with caustic alkalis (barilla, kelp, soda ash, potash, lime), rosin, salt for salting out, and essential oils for scenting.",
        "@language": "en"
      },
