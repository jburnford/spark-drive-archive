        "@id": "oe:industry_scheme"
      },
      "skos:prefLabel": {
        "@value": "Paper Making & Cardboard",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Paper, pasteboard, and millboard manufacture — pulping linen/cotton rags, esparto grass, wood pulp, straw, hemp, and jute, bleached with chloride of lime, sized with rosin/alum/gelatine/starch, and loaded or tinted with kaolin, smalt, and ultramarine.",
