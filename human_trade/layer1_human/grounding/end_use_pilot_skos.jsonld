    {
      "@id": "oe:ind_calico_printing",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Calico Cloth & Calico Printing",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "oe:industry_scheme"
      },
      "skos:topConceptOf": {
        "@id": "oe:industry_scheme"
      },
      "skos:prefLabel": {
        "@value": "Calico Cloth & Calico Printing",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "19th-century cotton weaving, bleaching, dyeing, and calico printing — combining raw cotton with bleaching powder and alkalis, natural, insect, mineral, and coal-tar dyestuffs (madder, garancine, munjeet, alizarine, indigo, cochineal, lac dye, kermes, logwood, quercitron, fustic, brazil wood, safflower, orchal/archil, persian berries, prussian blue, chrome yellow, aniline), metallic mordants (alum, copperas, tin/lead/copper salts, sumach, galls, cutch), and thickeners (gum senegal, gum arabic, tragacanth, starch, British gum, flour, albumen).",
        "@language": "en"
      },
