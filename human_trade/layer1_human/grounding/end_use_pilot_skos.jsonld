    {
      "@id": "oe:ind_chocolate_confectionery",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Chocolate & Confectionery",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "oe:industry_scheme"
      },
      "skos:topConceptOf": {
        "@id": "oe:industry_scheme"
      },
      "skos:prefLabel": {
        "@value": "Chocolate & Confectionery",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "19th-century chocolate bars, drinking chocolate, cocoa preparations, and sugar confectionery — combining roasted cacao beans and cocoa butter with cane sugar, aromatic spices (vanilla, cinnamon, cassia, cloves, cardamom, nutmeg), farinaceous thickeners/admixtures (arrowroot, sago, starch, flour), gums, almonds, and condensed milk.",
        "@language": "en"
      },
