    {
      "@id": "oe:ind_soap_manufacture",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Soap Manufacture",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "oe:industry_scheme"
      },
      "skos:topConceptOf": {
        "@id": "oe:industry_scheme"
      },
      "skos:prefLabel": {
        "@value": "Soap Manufacture",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "19th-century hard, soft, yellow, mottled, curd, Castile, and toilet soap manufacture — combining animal tallow and tropical/vegetable oils with caustic alkalis (barilla, kelp, soda ash, potash, lime), rosin, common salt for salting out, and essential oils for scenting.",
        "@language": "en"
      },
