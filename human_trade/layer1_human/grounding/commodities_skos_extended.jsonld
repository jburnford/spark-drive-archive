      "oe:ghostAcresDomain/#resource": "minerals_metals_energy",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_27_Crude_Fertilizers_and_Minerals",
      "skos:definition": {
        "@value": "(GER. *Walkererde*. DU. *Volluarde*. DA. *Walkejorde*. SW. *Valklera*, *Valkjord*. FR. *Terre à foulon*. IT. *Terra da purgatori*. SP. *Tierra de batan*. PORT. *Greda de pizoeiro*. RUS. *Schiffernaia glina*. LAT. *Terra fullonum*,) a species of clay, of a greyish ash-coloured brown, in all degrees from very pale to almost black, and it has generally something of a greenish cast. It is very hard and firm, of a compact texture, of a rough and somewhat dusty surface that adheres slightly to the tongue. It is very soft to the touch, not staining the hands, nor breaking easily between the fingers. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 441]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1905 (Minerals Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 441, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 176.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n441"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n176"
        }
      ]
    },
