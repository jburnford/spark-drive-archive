      "oe:attestationBasis": "document_attested",
      "oe:subsumedInCustomsHeading": {
        "@id": "htc:0012"
      },
      "oe:groundingStatus": "document_attested_local",
      "oe:ghostAcresDomain": "fats_oils_soap",
      "oe:landBasis": "terrestrial_crop",
      "oe:sitcCode": "SITC4_07_Coffee_Tea_Cocoa_Spices",
      "skos:definition": {
        "@value": "the *Cuminum Cuminum*, a plant grown for its aromatic seeds and for the yellow essential oil they yield. The fruit is mildly stimulant and carminative, and is used in the preparation of plasters in veterinary practice, and in liquors. The pungent seeds of *Nigella sativa*, known as black cummin, are used as a condiment instead of pepper, and pounded as a stimulatory. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 128]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds, Nuts & Kernels for Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 128.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n128"
        }
      ],
      "oe:sourceTaxon": [
        {
          "@id": "http://www.wikidata.org/entity/Q160575"
        }
      ]
    },
