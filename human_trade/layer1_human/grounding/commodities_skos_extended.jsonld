      "oe:theodoridisBucket": "manufactured_articles",
      "oe:sitcCode": "SITC4_65_84_85_Textiles_Apparel_Footwear",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "(*GER. Handschuhe. DU. Handschoenen. DA. Handsker. SW. Handskar. FR. Gants. IT. Guanti. SP. Guantes. PORT. Luvas. RUS. Rukawizii, Petschatki, Golizii. POL. Rekawicee*,) with respect to commerce, are distinguished into wash or tan leather, silk, thread, cotton, worsted, &c. Leather gloves are made of chamois, kid, lamb, doe, elk, buff, &c. The leather of gloves is not tanned, properly speaking, but cured with alum, which renders it soft and pliable, and therefore more proper... [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 467]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n467"
        }
      ],
      "oe:firstAttested": 1856,
