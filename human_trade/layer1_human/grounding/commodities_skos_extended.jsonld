      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "(_Ambregric_, Fr.; _Ambra_, Germ.).--A morbid secretion of the liver of the spermaceti whale (physeter macrocephalus), found usually swimming upon the sea. It occurs upon the coasts of Coromandel, Japan, the Moluccas, and Madagascar, and has sometimes been extracted from the rectum of whales in the South Sea fishery. It has a gray-white colour, often with a black streak, or is marbled, yellow and black; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0071 (Furs Unenumerated Undressed). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "skos:closeMatch": [
