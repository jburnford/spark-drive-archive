      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "an empyreumatic medicinal oil obtained from *Erythroxylon areolatum*; deodar is also the name for a species of pine of the Himalayas, the turpentine of which is used as a stimulant to foul ulcers. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 136]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 136.",
