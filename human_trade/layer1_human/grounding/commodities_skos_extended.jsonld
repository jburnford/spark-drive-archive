    {
      "@id": "htc:20/2028/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Bear",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "2028",
      "skos:prefLabel": {
        "@value": "Bear",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_customs_residuals/#concept"
      },
      "oe:observationCount/#resource": 1,
      "oe:groundingStatus/#resource": "local_concept_only",
      "oe:substanceHead/#resource": "Bear",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "other",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_wild_hunted",
      "oe:harvestMode/#resource": "wild_hunted_fished",
      "oe:theodoridisBucket/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "There are several species of this quadruped; the most important, however, are the brown and black bears, *Ursus Arctos et Americanus*, and the Polar bear, *Ursus maritimus*. The bear is an object of commercial utility for man-geries and zoological collections, and also for its skin and grease. The flesh of the black bear is extremely delicate, the hams in particular being much esteemed. The white bear is eaten by the Esquimaux and the Danes of Greenland, and, when young and cooked after the manner of a beefsteak, is by no means to be despised, although rather insipid; [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 44]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — source_taxon remove: Only the polar bear had been attached; single Canadian row (1839). | source_taxon add: American black bear, the common bear of the Canadian trade.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n44"
        }
      ],
      "oe:firstAttested/#resource": 1839,
      "oe:lastAttested/#resource": 1839,
      "oe:inferredPrimarySource/#resource": [
        {
          "@id": "oe:series_csp_canadian_exports_blankseries/#resource"
        }
      ],
      "oe:sourceTaxon/#resource": [
