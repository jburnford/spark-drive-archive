      "oe:ghostAcresDomain/#resource": "tannins_leather",
      "oe:landBasis/#resource": "terrestrial_pasture",
      "oe:harvestMode/#resource": "animal_husbandry",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "skos:definition": {
        "@value": "a name given to the calcareous plate which strengthens the back of the cuttle fish (*Sepia officinalis*). It was formerly much prized in medicine as an absorbent; it is now almost solely employed for polishing of paint, varnish, wood, or the softer metals, and for making pounce and tooth powder. Large supplies are received at Bombay from the Persian gulf. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 131]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0071 (Furs Unenumerated Undressed). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 131.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n131"
        }
      ]
    },
