      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "a succulent shrub or tree, the *Musa Paradisiaca*, largely cultivated in the tropics for its fruit, eaten boiled or roasted, or prepared into dough and meal; bags are made of the leaves, and the stalk furnishes a large quantity of useful fibre for paper making or for cordage. Another species, *M. textilis*, furnishes a valuable fibre for rope. See MANILA-HEMP. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 303]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0402 (Fruit Raw unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 303.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n303"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q123458126"
        }
      ]
    },
    {
