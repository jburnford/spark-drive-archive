      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_54_Medicinal_Pharmaceutical",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "a genus of plants, the *Rheum*, of extensive use, the stalks of some British varieties being used for making ples and wine. As much as 100,000 dozen bundles are annually sold in London; while the roots of many exotic varieties form an important drug. In 1855 we imported 65,591 lbs. of rhubarb. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 330]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n330"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n863"
        }
      ],
      "oe:firstAttested/#resource": 1800,
      "oe:lastAttested/#resource": 1866,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_other/#resource"
        },
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade/#resource"
        },
        {
          "@id": "oe:series_kew_cust_5/#resource"
        },
        {
          "@id": "oe:series_kew_cust_4/#resource"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "htc1866:vegetable/#concept"
        }
      ]
    },
