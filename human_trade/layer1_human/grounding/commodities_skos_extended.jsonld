      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "egg as food",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the ovum of domestic poultry, which are largely used as food by all nations, and form considerable articles of commerce in most countries. Besides our home produce, from 100 to 120 millions of eggs are annually imported from the Continent. Eggs are used in glove-making, tanning, [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 150]",
        "@language": "en"
      },
      "skos:editorialNote": [
