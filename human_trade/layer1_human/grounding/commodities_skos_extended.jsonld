      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "in the tropics a piece of ground set apart for the cultivation of species of *Musa*, the plantain and banana. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 495]",
        "@language": "en"
      },
      "skos:scopeNote": {
