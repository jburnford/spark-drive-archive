      "oe:sitcCode": "SITC4_54_Medicinal_Pharmaceutical",
      "oe:isAggregate": false,
      "skos:altLabel": [
        {
          "@value": "castoreum",
          "@language": "en"
        },
        {
          "@value": "beaver castor",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "an animal substance possessing a disagreeable odour, obtained from the beaver, *Castor fiber*, and once much used as an antispasmodic in medicine. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 87]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Historical boundary object: in 1800–1852 British/Canadian customs ledgers (measured in lbs from Canada/Hudson's Bay), 'Castor' denotes beaver castoreum (Castor fiber), not castor oil.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n87"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
