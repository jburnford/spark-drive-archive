      "oe:sitcCode/#resource": "SITC4_26_Textile_Fibres",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "hemp fiber",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "a fibre obtained from the *Cannabis sativa*, which is stronger and coarser than flax. It is used for making cordage, canvas for sail-cloth, towelling, &c. The foreign imports are very large. In 1856, we received, chiefly from Russia, 777,998 cwts. of dressed and undressed hemp, besides 15,233 cwts. of tow or codilla. In previous years we had received much more than this, but jute and several other foreign fibrous substances now come in in immense quantities. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 204]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
