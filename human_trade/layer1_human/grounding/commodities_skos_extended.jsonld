      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a name in Mexico for broom-root, this is largely exported for brush-making from the port of Vera Cruz, to the extent of about 90,000 tons yearly: *see* BROOM ROOT. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 522]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 522.",
        "@language": "en"
      },
