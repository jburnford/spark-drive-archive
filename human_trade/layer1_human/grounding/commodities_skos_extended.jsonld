      "skos:definition": {
        "@value": "a name for the birch gum-tree (*Bursera gumifera*). [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 405]",
        "@language": "en"
      },
      "skos:scopeNote": {
