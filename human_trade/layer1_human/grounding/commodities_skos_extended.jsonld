      "oe:sitcCode/#resource": "SITC4_04_Cereals_and_Preparations",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "a name for species of *Triticum*, one of the most important of the food grains, and that most generally cultivated in Europe; the flour being the most nutritious and platable of all the cereal grasses. The quantity raised in this country is very large, amounting to about 19,000,000 quarters, and we also import 7,000,000 or 8,000,000 quarters a year. See **FLOUR**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 422]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — definition use: Previous text was only a cross-reference ('See BREAD, GLUTEN, and STARCH').",
          "@language": "en"
        }
      ],
