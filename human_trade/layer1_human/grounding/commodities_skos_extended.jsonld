      "oe:landBasis": "terrestrial_crop",
      "oe:sitcCode": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "the dried unripe berries of the *Rhamnus infectorius*, imported in large quantities from the South of Europe and the Levant, for the use of dyers. They are also known as Persian berries, and Avignon berries. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 431]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs & Dye Woods Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 431.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n431"
        }
      ]
    },
