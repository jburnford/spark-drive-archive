      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "the fruit of the *Punica Granatum*, the juice of which is acridulous and sweet, and makes a pleasant sherbet for fever patients. The tree is common now in almost all warm climates. *See DALIM. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0402 (Fruit Raw unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1210.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
