      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_51_52_Chemicals",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Varec_, Fr.; _Wareck_, Germ.), is the crude alkaline matter produced by incinerating various species of fuci, or _sea-weed_. They are cut with sickles from the rocks in the summer season, dried and then burned, with much stirring of the pasty ash. I have analyzed many specimens of kelp, and found the quantity of soluble matter in 100 parts of the best to be from 53 to 62, while the insoluble was from 47 to 38. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n225"
        },
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n886"
        }
      ],
