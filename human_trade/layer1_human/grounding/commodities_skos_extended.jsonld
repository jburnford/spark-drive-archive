      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a medicinal product obtained from some species of *Barosma* indigenous to the Cape colony, which have an aromatic smell, and are esteemed in pharmacy for their diuretic properties. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 65]",
        "@language": "en"
      },
      "skos:scopeNote": {
