      "oe:groundingStatus": "document_attested_grounded",
      "oe:ghostAcresDomain": "fibres_textiles",
      "oe:landBasis": "terrestrial_crop",
      "oe:sitcCode": "SITC4_26_Textile_Fibres",
      "skos:altLabel": [
        {
          "@value": "coconut husk",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the commercial name of the short fibre obtained from the dry husk or covering of the cocoa-nut, which is now largely used in the manufacture of cordage, matting, &c., and to stuff beds, chair bottoms, &c. From Ceylon alone more than 60,000 cwt. is shipped annually. The varieties of coir entering the market are coir yarn, coir junk and coir fibre. Matting is made here of coir. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 110]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Vegetable Fibres Unenumerated (incl. Esparto, Cordage & Brush Fibres)). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 110.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n110"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q1029620"
        }
      ]
    },
