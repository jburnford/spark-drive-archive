      "skos:altLabel": [
        {
          "@value": "river rat",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the commercial name for the fur of the coypu (*Myopotamus coypus*), which is imported from South America, sometimes in large quantities. Formerly, upwards of a million skins were received annually from the River Plate, but of late years the imports have declined below 200,000. The skin is either dressed as a peltry, or shorn as a hatting fur. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 274]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0071 (Furs, Skins & Marine Products Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 274.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n274"
        }
      ]
    },
