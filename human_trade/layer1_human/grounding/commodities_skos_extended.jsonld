      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "A genus of erect or climbing shrubs or trees which comprises about 40 species, all tropical. Of these seven are natives of India. *M. angustifolia*, Roxb. ; *Rec. Bot. Surv. Ind.*, i., 248, 347. The *dáru haridrá*, *asugach*, *chenung*, *ban hardi*, *yiyo*, etc. An evergreen bush of the Eastern Himalaya ascending the hills to 6,000 feet in altitude ; Assam ; [Sir George Watt, The Commercial Products of India (1908), scan p. 794]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 794.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b31361584/page/n794"
        }
      ]
    },
