      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "There is a plant called chay, the _Oldenlandia umbellata_, which is extensively cultivated as a dye plant in the East, especially on the coasts of Coromandel, Nellore, Masulipatam, Malabar, and other parts of India. The outer bark of the roots furnishes the coloring matter for the durable red for which the chintzes of India are famous. [P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854, Project Gutenberg #15191)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854, Project Gutenberg #15191).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/15191"
        }
      ],
      "oe:sourceTaxon/#resource": [
        {
          "@id": "http://www.wikidata.org/entity/Q7085552"
        }
      ]
    },
