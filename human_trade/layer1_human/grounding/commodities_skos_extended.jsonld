      "oe:sitcCode/#resource": "SITC4_08_Animal_Feeding_Stuff",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the stalks or culms on which corn and other grasses grow, and from which the grain has been thrashed. Straw is cut into chaff for feeding cattle and other purposes and used as a litter. Some straw is plaited into braids for hats and bonnets; and artificial flowers, mats, and baskets, are made of it: it is also twisted into straw ropes, and cigar-cases. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 375]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
