      "oe:theodoridisBucket": "raw_materials",
      "oe:sitcCode": "SITC4_53_Dyeing_Tanning_Colouring",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "(_Outremer_, Fr.; _Ultramarins_, Germ.); is a beautiful blue pigment obtained from the variegated blue mineral, called lazulite (_lapis lazuli_), by the following process:--Grind the stone to fragments, rejecting all the colourless bits, calcine at a red heat, quench in water, and then grind to an impalpable powder along with water, in a paint-mill, (see PAINTS, GRINDING OF,) or with a porphyry slab and muller. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n406"
        }
      ],
      "oe:firstAttested": 1855,
      "oe:lastAttested": 1869,
      "prov:hadPrimarySource": [
