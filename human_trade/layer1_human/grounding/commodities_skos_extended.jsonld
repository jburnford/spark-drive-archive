      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a name for the various condiments used to form curries, many of which are transported from place to place in the East, forming extensive articles of commerce. The principal ingredients used by the lower classes for their rice is red pepper, salt, lime juice, and the dried skin of the gorka. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 129]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 129.",
        "@language": "en"
      },
