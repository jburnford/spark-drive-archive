      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a commercial name for the large capsules or acorn cups of the *Quercus agilops*, which are imported in considerable quantities for the use of tanners, being much more portable and concentrated in tanning properties than bark. In 1862, there were imported 29,720 tons of valonea. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 409]",
        "@language": "en"
      },
      "skos:scopeNote": {
