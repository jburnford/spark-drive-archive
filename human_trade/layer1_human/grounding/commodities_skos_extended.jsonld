          "@id": "http://www.wikidata.org/entity/Q674"
        }
      ]
    },
    {
      "@id": "htc:doc/doc_physic_nut/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Physic Nut",
        "@language": "en"
