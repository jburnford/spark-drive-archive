    {
      "@id": "htc:doc_abaca",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Abaca",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme"
      },
      "skos:notation": "doc_abaca",
      "skos:prefLabel": {
        "@value": "Abaca",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp_bast_plant_fibres"
      },
      "oe:attestationBasis": "document_attested",
      "oe:subsumedInCustomsHeading": {
        "@id": "htc:0822"
      },
      "oe:groundingStatus": "document_attested_local",
      "oe:ghostAcresDomain": "fibres_textiles",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "The Indian name of the hemp of the Philippine Islands. [HEMP MANILLAS.] ABANDONMENT (Fr. *délaissement*). In Commerce and Navigation, this term is used to express the abandoning or surrendering of the ship or goods insured to the insurer. It is held, by the law of England, that the insured has the right to abandon, and to compel the insurers to pay the whole value of the thing  [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 43]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Vegetable Fibres Unenumerated (incl. Esparto, Cordage & Brush Fibres)). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 43.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n43"
        }
      ]
    },
    {
      "@id": "htc:doc_absintii",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Absintii",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme"
      },
      "skos:notation": "doc_absintii",
      "skos:prefLabel": {
        "@value": "Absintii",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp_drugs_medicinal_botanicals"
      },
      "oe:attestationBasis": "document_attested",
      "oe:subsumedInCustomsHeading": {
        "@id": "htc:0122"
      },
      "oe:groundingStatus": "document_attested_local",
      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "or wormwood, is the produce of *Artemisia absinthium*, which is much used in medicine for its bitter properties. \\* [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 14]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 14.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n14"
        }
      ],
      "oe:sourceTaxon": [
        {
          "@id": "http://www.wikidata.org/entity/Q25686"
        }
      ]
    },
    {
      "@id": "htc:doc_acacia",
