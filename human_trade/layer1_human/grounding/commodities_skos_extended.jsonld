      "oe:landBasis": "mineral",
      "oe:theodoridisBucket": "raw_materials",
      "oe:sitcCode": "SITC4_67_68_Metals",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "is one of the metals most anciently known. It was named from the island of Cyprus, where it was extensively mined and smelted by the Greeks. It has a reddish brown colour inclining to yellow; a faint but nauseous and rather disagreeable taste; and when rubbed between the fingers it imparts a smell somewhat analogous to its taste. Its specific gravity is from 8·8 to 8·9. It is much more malleable than it is ductile; so that far finer leaves may be obtained from it than wire.... [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
