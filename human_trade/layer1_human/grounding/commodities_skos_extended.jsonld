      },
      "oe:observationCount/#resource": 59,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Walnuts",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "other_food_drink_spices",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "walnut",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "The fruit of the *Juglans*, or walnut-tree, of which there are several varieties. The walnut is a large handsome tree, with strong spreading branches. The fruit is a pretty large smooth, ovate nut, containing an oily kernel, divided into four lobes. The nut has been always held in high estimation: it was called by the Romans *Jovis glans*, the acorn or mast of Jove, and hence the name of the tree. The walnut tree is indigenous to Persia and the countries bordering on the Caspian Sea. It has long been introduced into Great Britain; but the fruit seldom ripens in the more northerly parts of the island. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1622]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n1622"
        }
      ],
      "oe:firstAttested/#resource": 1819,
      "oe:lastAttested/#resource": 1872,
