      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_42_Fixed_Vegetable_Fats_and_Oils",
      "skos:definition": {
        "@value": "a bland drylag oil, obtained from poppy-seed, which is more extensively used in the Madras presidency, and some other parts of India, than any other, both in meals and for food. Exposed to the rays of the sun, it becomes perfectly colourless. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 308]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 308.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
