      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the *Ocymum basilicum*, a favourite pot-herb among French cooks, being used, from its aromatic odour and pungency, to give a further zest to highly seasoned dishes, and for flavouring soups and salads; an aromatic ethereal oil is obtained from the root. Tanned sheep's skin; also the angle at which a cutting tool is ground. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 40]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 40, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 115.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n40"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n115"
        }
      ]
    },
