      "skos:definition": {
        "@value": "is the finest kind of pottery-ware. It is considered under that title. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
