      "oe:ghostAcresDomain/#resource": "timber_forestry",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the produce of *Piscidia erythrina*, a deciduous tree indigenous to the tropics; the bark of the roots is used as a narcotic to stupefy fish. The dogwood of America (*Cornus florida*) is used for inlaying by cabinet-makers; the bark is also an esteemed tonic, and used in the manufacture of ink and false quinine. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 141]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 141, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 462.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n141"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n462"
        }
      ],
