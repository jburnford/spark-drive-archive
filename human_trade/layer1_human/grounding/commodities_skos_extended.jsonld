      "skos:altLabel": [
        {
          "@value": "calaban",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "a small rodent, a species of *Sciurus*. The fur of several varieties of squirrel is much used for linings, for tippets, for cuffs, and other articles of ladies' dress. From fifteen to twenty millions are said to be killed in Russia annually. In the trade returns they are sometimes called Calabarskins. In 1856, about 2,200,000 squirrel-skins were imported, and chiefly used up in [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 369]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0071 (Furs, Skins & Marine Products Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 369, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 508.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n369"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n508"
        }
      ]
    },
