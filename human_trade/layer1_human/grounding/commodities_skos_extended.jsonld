      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "a name given in the West Indies to the *Abelmoschus esculentus*, cultivated in gardens for its mucilage; the young capsules being used to thicken soups. The seeds may also be added like barley to soups, and have been roasted as a substitute for coffee. The bark of the plant furnishes, like all the tribe, a strong fibre. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 275]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0085 (Vegetables Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 275.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n275"
        }
      ],
      "oe:sourceTaxon/#resource": [
        {
          "@id": "http://www.wikidata.org/entity/Q80531"
        }
      ]
    },
