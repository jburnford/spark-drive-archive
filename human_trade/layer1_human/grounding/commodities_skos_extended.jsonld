      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "oil obtained by expression from the pericarp of the fruit of *Olea Europæa*, which forms an extensive article of commerce, and is used largely for food, in liniments, and in calico-printing. The average imports of 1855 and 1856 were 23,400 tons. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 277]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
