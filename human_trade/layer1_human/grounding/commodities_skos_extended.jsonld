      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_06_Sugars_and_Honey",
      "skos:definition": {
        "@value": "properly _Acetate of lead_, (_Acetate de plomb_; _Sel de Saturne_, Fr.; _Essigsaures Bleioxyd_, _Bleizucker_, Germ.) is prepared by dissolving pure litharge, with heat, in strong vinegar, made of malt, wood, or wine, till the acid be saturated. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 378.",
        "@language": "en"
      },
