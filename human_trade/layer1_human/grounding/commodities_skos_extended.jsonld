      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a fragrant resinous gum which in India exudes from the tops of the branches of the *Gardenia lucida*. It is extensively used as a dressing for slight injuries and wounds, and is sold in some parts as googul. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 139]",
        "@language": "en"
      },
      "skos:scopeNote": {
