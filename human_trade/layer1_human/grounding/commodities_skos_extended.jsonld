        }
      ],
      "oe:sourceTaxon/#resource": [
        {
          "@id": "http://www.wikidata.org/entity/Q17813478"
        }
      ]
    },
    {
      "@id": "htc:doc/doc_shagreen/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
