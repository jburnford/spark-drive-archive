      },
      "skos:notation": "0296",
      "skos:prefLabel": {
        "@value": "Copper",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:sub/sub_metals_sem_wd_q753/#concept"
      },
      "oe:observationCount/#resource": 128,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Copper",
      "oe:processingState/#resource": "smelted_semi",
      "oe:ghostAcresDomain/#resource": "minerals_metals_energy",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_67_68_Metals",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "is one of the metals most anciently known. It was named from the island of Cyprus, where it was extensively mined and smelted by the Greeks. It has a reddish brown colour inclining to yellow; a faint but nauseous and rather disagreeable taste; and when rubbed between the fingers it imparts a smell somewhat analogous to its taste. Its specific gravity is from 8·8 to 8·9. It is much more malleable than it is ductile; so that far finer leaves may be obtained from it than wire. It melts at the 27th degree of Wedgewood’s pyrometer, and at a higher temperature it evaporates in fumes which tinge the fire of a bluish green. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
