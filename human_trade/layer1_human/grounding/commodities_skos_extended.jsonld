      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "is a resin obtained from the _Fagura octandra_, a tree which grows in Mexico and the West Indies. It occurs in yellowish pieces, of a strong smell, and a bitterish aromatic taste. That from the island of Madagascar has a greenish tint. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum, Resin & Elastic-Gum Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1471.",
        "@language": "en"
      },
