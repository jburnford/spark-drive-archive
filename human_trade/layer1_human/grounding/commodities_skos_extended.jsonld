      },
      "oe:attestationBasis/#resource": "document_attested",
      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:03/0352/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "a species of walnut, the produce of *Juglans cinerea*, imported from North America. The kernels of the hard oblong nuts are very oily; the Indians formerly pounded and boiled them, and separating the oily substance which floated on the surface, mixed it with their food; hence the name. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 69]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0352 (Nuts and Kernels Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 69.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n69"
        }
      ],
      "oe:sourceTaxon/#resource": [
