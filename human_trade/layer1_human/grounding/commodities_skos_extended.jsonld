      "oe:sitcCode": "SITC4_27_Crude_Fertilizers_and_Minerals",
      "oe:isAggregate": false,
      "skos:altLabel": [
        {
          "@value": "table salt",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "chloride of soda, an efflorescence, also found in beds and masses. Its uses for culinary purposes, for manure, for cattle, and for metallurgic operations, are well known. It also enters largely into the manufacture of soda, soap, earthenware, &c. The principal commercial varieties are rock-salt, common white salt, and stoved salt. See **SALTS**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 339]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n339"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "oe:firstAttested": 1809,
      "oe:lastAttested": 1901,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_csp_canadian_exports_blankseries"
        },
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade"
