      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a name for the root of *Anthemis Pyrethrum*, which is used as a masticatory to relieve toothache; it enters into the composition of certain snuffs, and the powder is used in large quantities by the Mohammedans to excite transpiration, being rubbed upon the skin. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 293]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 293, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1152.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
