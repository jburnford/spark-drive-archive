      },
      "oe:attestationBasis": "document_attested",
      "oe:subsumedInCustomsHeading": {
        "@id": "htc:0506"
      },
      "oe:groundingStatus": "document_attested_local",
      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "mineral",
      "oe:sitcCode": "SITC4_51_52_Chemicals",
      "skos:definition": {
        "@value": "is a salt sometimes formed by saturating the ammonia liquor of the gas-works with sulphuric acid; and it is employed for making carbonate of ammonia. See AMMONIA and SAL AMMONIAC. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ]
    },
    {
      "@id": "htc:doc_sulphate_of_soda",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Sulphate of Soda",
        "@language": "en"
      },
      "skos:inScheme": {
