      "oe:sitcCode/#resource": "SITC4_07_Coffee_Tea_Cocoa_Spices",
      "skos:definition": {
        "@value": "the *Illicium anisatum*, a native of China and Japan, the aromatic and carminative fruit of which is used in the preparation of liqueurs. The star-shaped capsules and seeds abound in an essential oil, easily procured by distillation with water. See **ANISEED**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 371]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 371.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n371"
        }
      ],
