      "oe:observationCount": 40,
      "oe:groundingStatus": "grounded_wikidata_v4",
      "oe:substanceHead": "Carts",
      "oe:processingState": "manufactured",
      "oe:ghostAcresDomain": "manufactured_goods",
      "oe:landBasis": "industrial_manufactured",
      "oe:theodoridisBucket": "manufactured_articles",
      "oe:sitcCode": "SITC4_69_7_Metalwares_and_Machinery",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "Every cart &c. for the carriage of anything to and from any place, where the streets are paved, within the bills of mortality, shall contain 6 inches in the felly. No person shall drive any cart, waggon &c. within 5 miles of the General Post Office, unless the name, surname, and place of abode of the owner be painted in conspicuous letters, at least 1 inch in height, on the right or off side thereof, under a penalty of 5*l.* Any person may seize and detain any cart, waggon... [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 340]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n340"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n206"
        }
      ],
