    {
      "@id": "htc:17/1768/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Bark",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1768",
      "skos:prefLabel": {
        "@value": "Bark",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_customs_residuals/#concept"
      },
      "oe:observationCount/#resource": 5,
      "oe:groundingStatus/#resource": "grounded_wikidata_lexical",
      "oe:substanceHead/#resource": "Bark",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "other",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:theodoridisBucket/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "The outer rind of trees. There is an immense variety of barks known in commerce as cinnamon, Peruvian bark, oak bark, quercitron &c. The term *bark* is, however, generally employed to express either Peruvian bark, or oak bark and quercitron, and it is these only we here notice. Peruvian bark (Fr. quinquina; Ger. kronchina; Dutch, china-bast; Span. quina, quenina; Lat. quenina, Cortex Peruvianus). There are several sorts of this bark known in commerce. The first sort is the *pale* bark of the shops. It is the original cinchona of Peru, and is the produce of different varieties of the *Chinchona officinalis* of Linnaeus. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 195]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — source_taxon remove: Generic bark heading; the 1866 bridge treats it as tanning bark.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n38"
        },
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n195"
        }
      ],
      "oe:firstAttested/#resource": 1818,
      "oe:lastAttested/#resource": 1833,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_kew_cust_4/#resource"
        }
      ],
