    {
      "@id": "htc:00/0001/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Wheat",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0001",
      "skos:prefLabel": {
        "@value": "Wheat",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:sub/sub_cereals_gr_wd_q15645384/#concept"
      },
      "oe:observationCount/#resource": 2633,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Wheat",
      "oe:processingState/#resource": "raw_unprocessed",
      "oe:ghostAcresDomain/#resource": "food_grain",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "grain_and_flour",
      "oe:sitcCode/#resource": "SITC4_04_Cereals_and_Preparations",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "a name for species of *Triticum*, one of the most important of the food grains, and that most generally cultivated in Europe; the flour being the most nutritious and platable of all the cereal grasses. The quantity raised in this country is very large, amounting to about 19,000,000 quarters, and we also import 7,000,000 or 8,000,000 quarters a year. See **FLOUR**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 422]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — definition use: Previous text was only a cross-reference ('See BREAD, GLUTEN, and STARCH').",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n422"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
