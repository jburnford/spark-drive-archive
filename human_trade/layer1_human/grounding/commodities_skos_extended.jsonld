      },
      "oe:observationCount/#resource": 903,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Shingles",
      "oe:processingState/#resource": "sawn_hewn",
      "oe:ghostAcresDomain/#resource": "timber_forestry",
      "oe:attestationBasis/#resource": "customs_enumerated",
