      "oe:sitcCode/#resource": "SITC4_54_Medicinal_Pharmaceutical",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the roots of *Glycyrrhiza glabra*, a perennial plant common in the south of Europe, considerable quantities of which are imported. Liquorice is much used in the Levant in making a decoction which is drunk cold in summer, and liquorice water is a favourite beverage in this country with children. *See GOONCH. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 242]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n242"
        },
        {
