      "oe:sitcCode": "SITC4_12_Tobacco",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a wild plant, the *Arnica montana*, which has acrid and emetic properties, and causes constipation. It is used medicinally in typhoid fevers, dysentery, and other cases. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 394]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Verbatim 19th-century British customs appellation retained strictly for archival fidelity and source provenance; contains an archaic colonial racialized trade term ('Negrohead', denoting dark plug-pressed Cavendish tobacco). Analytically grouped under neutral Tobacco, Cigars & Snuff.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n394"
