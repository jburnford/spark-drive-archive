      "oe:ghostAcresDomain": "timber_forestry",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the *Eperua falcata* of Aublet, a tree abundant in British Guiana, the wood of which is of a deep red colour; it is hard and heavy, but splits freely and smoothly, and is much used for shingles, staves, pallings, posts, house-frances, &c. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 416]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood & Cabinet Timber Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 416.",
