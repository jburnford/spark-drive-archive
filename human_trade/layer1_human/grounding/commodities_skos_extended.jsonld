      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the root of *Leontodon taraxacum*, which is used medicinally, and coffee is made from it when torriified. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 460]",
        "@language": "en"
