      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_27_Crude_Fertilizers_and_Minerals",
      "skos:definition": {
        "@value": "a vesicular species of lava which floats on water; a volcanic product obtained principally from one of the Lipari islands. It is employed in various branches of the arts. The dome of the church or mosque of St. Sophia is built of pumice-stone for lightness. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 318]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1905 (Minerals Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 318, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
