      "skos:notation": "0061",
      "skos:prefLabel": {
        "@value": "Hay",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_fodder_oilcakes/#concept"
      },
      "oe:observationCount/#resource": 455,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Hay",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "fodder_feed",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_08_Animal_Feeding_Stuff",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(Ger. hew; Dutch, hovi; Fr. foin; Ital. fieno; Span. heno; Lat. fenum). Any kind of grass, cut and dried for the food of cattle. The business of hay-making is said to be better understood in Middlesex than in any other part of the kingdom. The great object is to preserve the green colour of the grass as much as possible, and to have it juicy, fresh, and free from all sorts of mustiness. The sale of hay within the bills of mortality, and 30 miles of the cities of London and Westminster, is regulated by the Act 36 Geo. III. c. 88; 4 & 5 Wm. IV. c. 21; and 19 & 20 Vict. c. 114. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 787]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n787"
