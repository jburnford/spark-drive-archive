      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "(GER. *Striegel*. DU. *Roskammen*. DA. *Strigler*, *Hesteskraber*. SW. *Hüstskrapor*. FR. *Etrilles*. IR. *Striglie*, *Strogghie*. SR. *Almohazas*, *Bruzas*. PORT. *Almofacas*. RUS. *Skreblizu*. POL. *Grzebla*,) are iron combs, used for dressing the coats of horses, and principally manufactured at Birmingham, Wolverhampton and Walsal. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 258]",
        "@language": "en"
      },
      "skos:scopeNote": {
