      "oe:ghostAcresDomain": "timber_forestry",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "an empyreumatic medicinal oil obtained from *Erythroxylon areolatum*; deodar is also the name for a species of pine of the Himalayas, the turpentine of which is used as a stimulant to foul ulcers. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 136]",
        "@language": "en"
      },
      "skos:scopeNote": {
