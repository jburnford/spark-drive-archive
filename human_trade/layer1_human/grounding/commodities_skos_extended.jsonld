      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "bowsprit",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "a kind of mast, resting slopewise on the head of the main stem, and having its lower end fastened to the partners of the foremast, and farther supported by the fore-stay. It carries the sprit-sail, sprit-top-sail, and jack-staff; and its length is usually the same with that of the fore-mast. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 172]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (group=grp_cooperage_ship_timber; wd_term=bowsprit; wd_relation=skos:closeMatch): Naval/cooperage woodware (anchor stocks, capstan bars, boat-hook staffs, bowsprits, empty casks). Verified Wikidata anchor retained as closeMatch (the heading is the plural trade article). Layer-1 observations: 6 rows, 1807–1814. Series: CSP_Canadian_Exports_BlankSeries (inferred, series not printed) ×6. Units: Pieces ×6. Top routes: Quebec QC → Great Britain ×6.",
          "@language": "en"
        },
        {
          "@value": "Curated fields — definition excerpt: Definition ran on into the next entry (BOWYERS).",
          "@language": "en"
        }
      ],
