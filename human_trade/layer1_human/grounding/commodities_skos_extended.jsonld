    {
      "@id": "htc:1377",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Turmeric",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme"
      },
      "skos:notation": "1377",
      "skos:prefLabel": {
        "@value": "Turmeric",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp_natural_dyestuffs"
      },
      "oe:observationCount": 12,
      "oe:groundingStatus": "grounded_wikidata_v4",
      "oe:substanceHead": "Turmeric",
      "oe:processingState": "unspecified",
      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "terrestrial_crop",
      "oe:theodoridisBucket": "raw_materials",
      "oe:sitcCode": "SITC4_53_Dyeing_Tanning_Colouring",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a name for the tubers of the *Curcuma longa*, which are bitter and aromatic, and largely used in the East as an ingredient in curries. Turmeric is imported into this country as a dye-stuff, and used to colour butter. The colouring matter of the dried root is bright yellow. White paper, dyed by an alcoholic turmeric, is a very sensitive test for alkalies. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 404]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n404"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/15191"
