      "oe:groundingStatus": "document_attested_local",
      "oe:ghostAcresDomain": "fats_oils_soap",
      "oe:landBasis": "terrestrial_crop",
      "oe:sitcCode": "SITC4_22_Oil_Seeds_and_Oleaginous_Fruits",
      "skos:definition": {
        "@value": "a plant, the *Sesamum orientale*, universally cultivated in the East Indies for the oil expressed from its seeds. We imported, in 1855, 652 quarters of sesame seed. In 1856, 22,790 cwt. of this seed were shipped from Madras alone, besides 2214 cwt. of oil. It is there called Gingely or Gingelle, and the seed is also known in commerce under its vernacular name of teel and til. * [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 349]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds, Nuts & Kernels for Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 349.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n349"
        }
      ],
      "oe:sourceTaxon": [
        {
          "@id": "http://www.wikidata.org/entity/Q17813478"
        }
      ]
    },
