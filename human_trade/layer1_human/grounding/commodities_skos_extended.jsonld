      "skos:altLabel": [
        {
          "@value": "Tacamahaca",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "A resin obtained chiefly from the *Fagara ootandra*; and formerly in use for fumigation and plasters. There are two sorts, the West and East Indian, the latter being, however, uncommon. It is of a light brown colour, very brittle, and easily melted when heated. When pure, it has an aromatic smell, between that of lavender and musk; [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1471]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1471, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
