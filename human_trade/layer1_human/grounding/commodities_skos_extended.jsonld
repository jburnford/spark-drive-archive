      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the name given to the essential oil, or substance to which the smell and a great part of the taste of many wines are due, and which, being volatile, is distilled over in the manufacture of brandy from such wines, contributing largely to the flavour of cognac. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 275]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 275.",
