      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the commercial name for the root of *Anchusa tinctoria*, a species of bugloss, from the South of Europe and the Levant, which imparts an elegant red colour to oils, and is used for staining wood. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 20]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs & Dye Woods Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 20, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 36.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n20"
