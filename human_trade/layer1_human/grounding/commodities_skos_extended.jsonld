      "oe:theodoridisBucket": "raw_materials",
      "oe:sitcCode": "SITC4_54_Medicinal_Pharmaceutical",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a sweet gummy exudation from several plants: the Calabrian manna is produced in tears from a species of ash, the *Fraxinus rotundifolia*, while some is obtained from another species, the *F. florifera*. The oriental manna of the desert is from *Alhagi Maurorum*. Manna is used medicinally. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 251]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Historical materia medica heading: sweet medicinal exudate from manna ash (Fraxinus ornus) imported from Italy and Spain.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n251"
