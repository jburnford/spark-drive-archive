      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a fragrant resinous gum which in India exudes from the tops of the branches of the *Gardenia lucida*. It is extensively used as a dressing for slight injuries and wounds, and is sold in some parts as googul. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 139]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 139.",
