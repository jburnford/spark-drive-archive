        "@id": "htc:00/0054/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:sitcCode/#resource": "SITC4_24_Cork_and_Wood",
      "skos:altLabel": [
        {
          "@value": "Sandal",
          "@language": "en"
        },
        {
          "@value": "Sanders Wood",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "an East Indian dye-wood, the produce of the *Pterocarpus santalinus*, a hard heavy wood imported from Madras and Calcutta. In 1856 117,901 Indian maunds (86,426 tons) of this wood were shipped from Madras. Besides its use as a dye-wood it is employed as the basis of various dentifrice mixtures. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 328]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 328.",
        "@language": "en"
      },
