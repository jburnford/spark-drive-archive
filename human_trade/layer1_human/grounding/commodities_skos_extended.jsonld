      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_51_52_Chemicals",
      "skos:definition": {
        "@value": "a tar creosote, which possesses extraordinary antiseptic properties, and has been used to preserve bodies for dissection, and the skins of animals intended to be stuffed. A valuable dye-stuff is also made from it, called carboazotic acid, which gives magnificent straw-coloured yellows on silk and woolen fabrics. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 81]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 81.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n81"
        }
      ]
