      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_07_Coffee_Tea_Cocoa_Spices",
      "skos:definition": {
        "@value": "the leaflets of a species of *Cyclopia*, probably *C. latifolia*, native of the Cape of Good Hope, supposed to possess expectorant and restorative properties; a few bags of this drug have been imported into London. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 68]",
        "@language": "en"
      },
      "skos:scopeNote": {
