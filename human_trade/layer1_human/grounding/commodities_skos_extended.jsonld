      "oe:landBasis": "terrestrial_crop",
      "oe:sitcCode": "SITC4_53_Dyeing_Tanning_Colouring",
      "skos:definition": {
        "@value": "A purple or violet coloured powder used in dyeing violet, purple, and crimson, prepared from a species of lichen (*Lecanora tartarea*), or crustaceous moss, growing commonly on limestone rocks in Sweden, Scotland, the north of England &c. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 555]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs & Dye Woods Unenumerated). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 555, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 127.",
        "@language": "en"
      },
