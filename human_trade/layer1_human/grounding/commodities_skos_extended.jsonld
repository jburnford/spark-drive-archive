      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "(_Iode_, Fr.; _Iod_, Germ.) is one of the archæal undecompounded chemical bodies, which was discovered accidentally in 1812 by M. Courtois, a manufacturer of saltpetre, in the mother-waters of that salt. Its affinities for other substances are so powerful as to prevent it from existing in an insulated state. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q1103"
        }
      ]
    },
