      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "castoreum",
          "@language": "en"
        },
        {
          "@value": "beaver castor",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "an animal substance possessing a disagreeable odour, obtained from the beaver, *Castor fiber*, and once much used as an antispasmodic in medicine. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 87]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Historical boundary object: in 1800–1852 British/Canadian customs ledgers (measured in lbs from Canada/Hudson's Bay), 'Castor' denotes beaver castoreum (North American beaver, Castor canadensis), not castor oil.",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — source_taxon remove: Eurasian beaver; the rows are Canadian. | source_taxon add: North American beaver, source of the castoreum exported from Canada and Hudson's Bay. | bridge_1866 drop: The 1866 'Castor' concept is the castor-oil seed; this heading is castoreum.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n87"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
