      "oe:ghostAcresDomain/#resource": "fisheries_marine",
      "oe:landBasis/#resource": "marine",
      "oe:harvestMode/#resource": "wild_hunted_fished",
      "oe:sitcCode/#resource": "SITC4_03_Fish_and_Seafood",
      "skos:definition": {
        "@value": "a preparation of the dried spawn or salted roe of fish; a single sturgeon will sometimes yield as much as 120 lbs. of roe. Caviar is principally consumed in Russia, Germany, and Italy, by the Greeks during their long fasts; and also in England. The black caviar is made from the roe of the sturgeon; [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 89]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0351 (Fisheries Articles Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 89.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
