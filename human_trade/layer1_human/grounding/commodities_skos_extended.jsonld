      "oe:sitcCode/#resource": "SITC4_42_Fixed_Vegetable_Fats_and_Oils",
      "skos:definition": {
        "@value": "a concrete oil, obtained in India from the dried fruit of the *Garcinia purpurea*. It is used as an article of food, and as a medicine. *See* **COCUM BUTTER**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 229]",
        "@language": "en"
      },
      "skos:scopeNote": {
