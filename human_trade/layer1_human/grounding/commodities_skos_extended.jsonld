      },
      "oe:observationCount/#resource": 11,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Glue",
      "oe:processingState/#resource": "manufactured",
      "oe:ghostAcresDomain/#resource": "manufactured_goods",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "industrial_manufactured",
      "oe:harvestMode/#resource": "manufacture",
      "oe:theodoridisBucket/#resource": "manufactured_articles",
      "oe:sitcCode/#resource": "SITC4_64_66_89_Paper_Glass_Misc_Manufactures",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Colle forte_, Fr.; _Leim_, _Tischlerleim_, Germ.) is the chemical substance gelatine in a dry state. The preparation and preservation of the skin and other animal matters employed in the manufacture of glue, constitute a peculiar branch of industry. Those who exercise it should study to prevent the fermentation of the substances, and to diminish the cost of carriage by depriving them of as much water as can conveniently be done. They may then be put in preparation by macerating them in milk of lime, renewed three or four times in the course of a fortnight or three weeks. This process is performed in large tanks of masonry. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
