    {
      "@id": "htc:03/0331/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Cranberries",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0331",
      "skos:prefLabel": {
        "@value": "Cranberries",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_fruits_nuts_vegetables/#concept"
      },
      "oe:observationCount/#resource": 116,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Cranberries",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "other_food_drink_spices",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "cranberry",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the acid red fruit of *Oxycoccus palustris*, and other species of the same genus, imported preserved in spring water from Newfoundland and the United States. They are largely used for tarts and puddings. Cranberries are cultivated in many parts of North America; they are sown broadcast on wet land, and on drier soils the plants are drilled in and bear fruit the third year, yielding on the average about 150 bushels to the acre, which sell at 8s. or 9s. the bushel. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 124]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n124"
        }
      ],
      "oe:firstAttested/#resource": 1807,
      "oe:lastAttested/#resource": 1852,
