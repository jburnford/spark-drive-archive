      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:sitcCode/#resource": "SITC4_24_Cork_and_Wood",
      "skos:definition": {
        "@value": "a light wood obtained in Guiana from the *Carapa Guianensis*, which takes a high polish, and is used for masts and spars, floorings, partitions, and doors of houses. There are two varieties, the red and the white. It may be cut from 40 to 60 feet in length, with a square of 14 or 16 inches. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 124]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 124.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
