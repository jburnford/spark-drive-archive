      ],
      "skos:definition": {
        "@value": "Cardamom is a spice made from the dried seed capsules of cardamom plants. It is used in an assortment of remedies, and is listed in the Compendium as a Stomachic and Cordial. [Danika Drugs Project: British Pharmacopoeia (1867) / Savory (1865)]",
        "@language": "en"
      },
      "skos:scopeNote": {
