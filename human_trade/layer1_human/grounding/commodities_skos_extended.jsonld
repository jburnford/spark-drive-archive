      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "other_food_drink_spices",
      "oe:sitcCode/#resource": "SITC4_11_Beverages",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "or _Geneva_, from _Genievre_ (juniper), is a kind of ardent spirits manufactured in Holland, and hence called Hollands gin in this country, to distinguish it from British gin. The materials employed in the distilleries of Schiedam, are two parts of unmalted rye from Riga, weighing about 54 lbs. per bushel, and one part of malted bigg, weighing about 37 lbs. per bushel. The mash tun, which serves also as the fermenting tun, has a capacity of nearly 700 gallons, being about five feet in diameter at the mouth, rather narrower at the bottom, and 4-1/2 feet deep; the stirring apparatus is an oblong rectangular iron grid, made fast to the end of a wooden pole. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n184"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n459"
        }
      ],
      "oe:firstAttested/#resource": 1815,
      "oe:lastAttested/#resource": 1898,
      "prov:hadPrimarySource": [
