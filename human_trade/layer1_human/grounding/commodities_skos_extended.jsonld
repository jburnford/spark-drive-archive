      "oe:observationCount/#resource": 400,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Galls",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "tannins_leather",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "gall",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "spherical concretions and excrescences formed upon the leaves and leaf stalks of several species of oak and tamarisk in the South of Europe. They are made by the puncture of the female gall fly. There are blue or black, green and white galls; the last are of little value. Those from Aleppo are the best. In India, myrobalans and the fruit of different species of *Terminalia*, are called galls. The imports of galls have been increasing lately, and about 1300 bags of 1 or 2 cwt. are imported in some years. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 179]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n179"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n468"
        },
        {
