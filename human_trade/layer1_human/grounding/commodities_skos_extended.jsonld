    {
      "@id": "htc:05/0597/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Tamarinds",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0597",
      "skos:prefLabel": {
        "@value": "Tamarinds",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:sub/sub_fruits_nut_wd_q1364/#concept"
      },
      "oe:observationCount/#resource": 59,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Tamarinds",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "other_food_drink_spices",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(Ger. tamarinden; Fr. tamarins; Ital. and Span. tamarindo; Arab. umblie; Hind. tintiri), the preserved pulp of the *Tamarindus Indica*, a tree which grows in the East and West Indies, in Arabia, and Egypt. In the West Indies the pods or fruit, being gathered when ripe, and freed from the shelly fragments, are placed in layers in a cask, and boiling syrup poured over them till the cask be filled; the syrup pervades every part quite down to the bottom; and when cool, the cask is headed for sale. The East India tamarinds are darker coloured and drier, and are said to be preserved without sugar. When good, tamarinds are free from any degree of mustiness; the seeds are hard, flat, and clean; the strings tough and entire; [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1476]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n1476"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n955"
        }
      ],
      "oe:firstAttested/#resource": 1800,
      "oe:lastAttested/#resource": 1866,
      "prov:hadPrimarySource": [
