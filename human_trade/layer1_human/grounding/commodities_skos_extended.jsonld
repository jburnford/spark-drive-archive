      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:sitcCode/#resource": "SITC4_24_Cork_and_Wood",
      "skos:definition": {
        "@value": "the bark of the slippery elm of the United States (*Ulmus fulva*), sold by herbalists as an emollient, diuretic, and tonic; that of the British elm (*U. campestris*), is stated to have analogous properties, but much less active. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 464]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 464.",
        "@language": "en"
      },
