      "oe:sitcCode/#resource": "SITC4_65_Textile_Yarn_and_Fabrics",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "a strong kind of flaxen fabric, used for ship's sails, awnings, tents, &c., manufactured in Ireland and Scotland. No. 1. is the coarsest and strongest kind. There are some other more open kinds of canvas made for tapestry and buckram. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 79]",
        "@language": "en"
      },
