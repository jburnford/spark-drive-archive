      "oe:ghostAcresDomain": "fats_oils_soap",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "is the name given by perfumers to the essential oil of orange flowers. It is procured by distillation with water, in the same way as the other volatile oils. Since in distilling water from neroli, an aroma is obtained different from that of the orange-flower, it has been concluded that the distilled water of orange-flowers owes its scent to some principle different from an esse [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil & Essential Oil Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
