      "oe:groundingStatus": "document_attested_grounded",
      "oe:ghostAcresDomain": "food_colonial_grocery",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a succulent shrub or tree, the *Musa Paradisiaca*, largely cultivated in the tropics for its fruit, eaten boiled or roasted, or prepared into dough and meal; bags are made of the leaves, and the stalk furnishes a large quantity of useful fibre for paper making or for cordage. Another species, *M. textilis*, furnishes a valuable fibre for rope. See MANILA-HEMP. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 303]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated (incl. Condiments & Minor Foods)). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 303.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n303"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q123458126"
        }
      ]
    },
