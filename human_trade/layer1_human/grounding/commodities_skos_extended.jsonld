      "oe:sitcCode": "SITC4_05_Vegetables_and_Fruit",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "the fruit of the date palm (*Phoenix dactylifera*, Linn.), largely used as food in Africa and the East. They enter into commerce as a succade or dried. Wine, spirit, and sugar are made from the date by the Arabs. The hard stones are even ground up as food for their camels, and of the leaves they make baskets and bags. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 132]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n132"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n263"
        }
      ],
      "oe:firstAttested": 1861,
      "oe:lastAttested": 1906,
      "prov:hadPrimarySource": [
