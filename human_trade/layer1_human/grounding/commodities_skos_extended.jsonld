      "oe:sitcCode": "SITC4_64_66_89_Paper_Glass_Misc_Manufactures",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "sheets of a superior kind of thick glass, used for silvering for mirrors, and also for large panes in drawing-room windows, shop-fronts, &c. It contains about 76 per cent. of silica. A superficial foot, one-tenth of an inch in thickness, is considered to weigh 1 lb. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 304]",
        "@language": "en"
      },
