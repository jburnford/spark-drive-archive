      "oe:ghostAcresDomain": "other",
      "oe:landBasis": "unclassified",
      "oe:theodoridisBucket": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "(Eng. and Fr.; _Bittererde_, _Talkerde_, Germ.), is one of the primitive earths, first proved by Sir H. Davy to be the oxide of a metal, which he called _magnesium_. It is a fine, light, white powder, without taste or smell, which requires 5150 parts of cold water, and no less than 36,000 parts of boiling water, for its solution. Its specific gravity is 2·3. It is fusible only by the heat of the hydroxygen blowpipe. A natural hydrate is said to exist which contains 30 per... [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n248"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n608"
        }
      ],
      "oe:firstAttested": 1807,
      "oe:lastAttested": 1807,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_csp_canadian_exports_blankseries"
        }
      ]
    },
