      "oe:sitcCode/#resource": "SITC4_42_Fixed_Vegetable_Fats_and_Oils",
      "skos:definition": {
        "@value": "a fragrant fixed oil obtained in India from the seeds of the Alexandrian laurel (*Calophyllum inophyllum*). It is used for burning and for medicinal purposes, being considered a cure for the itch. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 142]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 142, P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854, Project Gutenberg #15191).",
        "@language": "en"
