      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:sitcCode/#resource": "SITC4_24_Cork_and_Wood",
      "skos:definition": {
        "@value": "a name for the wood of several trees coming from South America and the West Indies. The West Indian is the produce of *Heisteria coccinea*. It is used for walking-sticks, umbrellas and parasol handles, and a variety of it in cabinet-work and turning. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 289]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 289.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
