      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "an extract prepared at Singapore from the *Uncaria Gambir*, and used as a dye and tanning substance. It is misnamed in trade circles *Terra Japonica*. The imports in the last few years have averaged 6000 tons per annum. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Historical Southeast Asian vegetable tanning extract (Uncaria gambir); closely allied in 19th-century British trade ledgers with Cutch and Terra Japonica.",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (wd_term=gambier; wd_relation=skos:exactMatch): Gambier (Uncaria gambir extract) has its own Wikidata item; it had been close-matched to catechu (Acacia cutch). Layer-1 observations: 108 rows, 1861–1920. Series: HCPP_Annual Statement of Trade ×108. Units: Tons ×84; CWTS (Hundredweights) ×24. Top routes: World → United Kingdom ×29; Straits Settlements → United Kingdom ×14; Singapore and Eastern Straits Settlements → United Kingdom ×13; Other Foreign Countries → United Kingdom ×8.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
