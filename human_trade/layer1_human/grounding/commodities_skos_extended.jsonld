    {
      "@id": "htc:16/1656/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Ink",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1656",
      "skos:prefLabel": {
        "@value": "Ink",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_glass_ceramics_paper_woodware/#concept"
      },
      "oe:observationCount/#resource": 7,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Ink",
      "oe:processingState/#resource": "manufactured",
      "oe:ghostAcresDomain/#resource": "manufactured_goods",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "industrial_manufactured",
      "oe:harvestMode/#resource": "manufacture",
      "oe:theodoridisBucket/#resource": "manufactured_articles",
      "oe:sitcCode/#resource": "SITC4_64_66_89_Paper_Glass_Misc_Manufactures",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Encre_, Fr.; _Tinte_, Germ.) is a coloured liquid for writing on paper, parchment, linen, &c. with a pen. _Black ink._--Nut-galls, sulphate of iron, and gum, are the only substances truly useful in the preparation of ordinary ink; the other things often added merely modify the shade, and considerably diminish the cost to the manufacturer upon the great scale. Many of these inks contain little gallic acid, or tannin, and are therefore of inferior quality. To make 12 gallons of ink we may take,-- 12 pounds of nutgalls, 5 pounds of green sulphate of iron, 5 pounds of gum senegal, 12 gallons of water. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (group=grp_glass_ceramics_paper_woodware; processing_state=manufactured; wd_term=ink; wd_relation=skos:closeMatch): Named manufactured sundry (furniture, bedding, printed matter, jewellery, plated and ceramic wares, pianos) left in the residual bin. Verified Wikidata anchor retained as closeMatch (the heading is the plural trade article). Layer-1 observations: 7 rows, 1871–1881. Series: HCPP_Annual Statement of Trade ×7. Units: (no unit) ×7. Top routes: World → United Kingdom ×3; All Countries → United Kingdom ×2; France → United Kingdom ×1; Other Countries → United Kingdom ×1.",
          "@language": "en"
        },
        {
          "@value": "Curated fields — definition use: Homonym: Japanese long measure 'ink'.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n213"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n215"
        }
      ],
      "oe:firstAttested/#resource": 1871,
      "oe:lastAttested/#resource": 1881,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade/#resource"
        }
      ],
