      "oe:sitcCode/#resource": "SITC4_54_Medicinal_Pharmaceutical",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the inspissated juice of the white poppy (*Papaver somniferum*), which is exclusively prepared in India, for shipment to China: the exports from Bombay and Calcutta are about 11,500,000 lbs. In 1856, the consumption of Indian opium in China was about 82,000 chests of 140 lbs. The average imports of opium into Great Britain are about 100,000 lbs. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 278]",
        "@language": "en"
      },
