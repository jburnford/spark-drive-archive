    {
      "@id": "htc:0919",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Yeast",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme"
      },
      "skos:notation": "0919",
      "skos:prefLabel": {
        "@value": "Yeast",
        "@language": "en"
      },
      "skos:broader": {
