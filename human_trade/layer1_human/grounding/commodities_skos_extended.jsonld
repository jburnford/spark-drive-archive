      "oe:ghostAcresDomain": "timber_forestry",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the Hindustani name for the *Cedrela Toona*, a valuable tree, of large size, abundant in Travancore, and other parts of India. The reddish-coloured wood, used all over India in cabinet-making, is scarcely inferior to mahogany, but lighter, and not so close in the grain. It is often sold under the general name of Chittagong wood. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 396]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood & Cabinet Timber Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 396.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n396"
        }
      ],
      "oe:sourceTaxon": [
        {
          "@id": "http://www.wikidata.org/entity/Q50838988"
        }
      ]
