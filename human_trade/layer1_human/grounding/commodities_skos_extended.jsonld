      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_53_Dyeing_Tanning_Colouring",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "a vitreous substance obtained by melting together zaffres, a regulus of cobalt, potash and siliceous matter, and grinding the produce to a fine powder, commercially known as powder-blue. It is employed to give a blue tinge to writing-paper, linen, and starch, and, not being affected by fire, is much employed in painting earthenware. Some is made in this country, but the bulk used, about 60 tons a-year, comes from Holland. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 362]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
