      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a name for the fragrant leaves of *Murraya koenigii*, largely used in India, fresh or dried, as a condiment in seasoning native curries. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 460]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 460.",
