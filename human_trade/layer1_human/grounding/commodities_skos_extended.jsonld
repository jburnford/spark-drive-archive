      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "is the generic name, in France, of _liqueurs_ compounded with alcohol, sugar, and the odoriferous or flavouring principles of vegetables. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
