      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "an Eastern name for the roots of *Aucklandia Costus*, the *Costus Arabicus* of the ancients. About two million pounds are annually collected on the mountains of Cashmere. It is chiefly exported to China, where it is used as incense. \\* [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 319]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 319, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 497.",
        "@language": "en"
      },
