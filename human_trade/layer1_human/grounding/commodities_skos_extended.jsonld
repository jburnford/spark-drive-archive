      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "*Linn.*; *Fl. Br. Ind.*, iv., 241; **SOLANACEÆ.** Deadly Nightshade, *sangangúr*, *angúr-shéfa*, *súchí*, *girbúti*, *ustrung*, *yebraj*, *luckmuna*. A coarse glabrous herb native of the Western Himalaya from Simla to Kashmir at altitudes of 6,000 to 12,000 feet; distributed to Europe and North Persia. D.E.P., i., 351-3. [Sir George Watt, The Commercial Products of India (1908), scan p. 107]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 107.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b31361584/page/n107"
        }
      ]
    },
