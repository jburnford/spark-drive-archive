      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_26_Textile_Fibres",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the soft curly hair or fleece covering of sheep—one of the most important of animal fibres, in which the trade, home and foreign, reaches nearly 100,000 tons a year. The kinds of wool raised at home, and received from abroad, are very numerous. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 427]",
        "@language": "en"
      },
      "skos:editorialNote": [
