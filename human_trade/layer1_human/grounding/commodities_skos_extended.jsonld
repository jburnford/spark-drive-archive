      "oe:sitcCode": "SITC4_04_Cereals_and_Preparations",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "(GER. *Mehl.* DU. and DA. *Meal.* SW. *Mjöl.* FR. and IT. *Farine.* SP. *Harina.* PORT. *Farinha.* RUS. *Muka.* POL. *Maka.* LAT. *Farina,*) the edible part of wheat, oats, rye, barley, and pulse of different kinds, ground into a species of flour. The difference between flour, properly so called, and meal, is, that the former is freed from the husky part, and other impurities of the species of corn whereof it is made, but the latter is not. Meal is denominated according to... [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 628]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n628"
        }
      ],
