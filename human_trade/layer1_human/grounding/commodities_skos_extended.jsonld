      },
      "oe:attestationBasis/#resource": "document_attested",
      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:01/0124/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "fats_oils_soap",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:altLabel": [
        {
          "@value": "Cajeput",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "is obtained from the leaves of the tree called Melaleuca Leucadendron by Linnæus, which grows upon the mountains of Amboyna, and in other of the Molucca islands. It is procured by distillation of the dried leaves along with water, is prepared in great quantities in the island of Banda, and sent to Holland in copper flasks. Hence as it comes to us, it has a green colour. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "skos:closeMatch": [
