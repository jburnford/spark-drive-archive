      "oe:theodoridisBucket": "animals_and_animal_products",
      "oe:sitcCode": "SITC4_03_Fish_and_Seafood",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a general name for marine swimming animals, in the capture and sale of which a large trade is carried on; a sea term for strengthening a weakened spar by fastening another piece on; to raise the flukes of an anchor on the gunwale, or vessel's side; to catch fish by net, or by hook and line. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 166]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n166"
        }
      ],
      "oe:firstAttested": 1850,
      "oe:lastAttested": 1897,
      "prov:hadPrimarySource": [
