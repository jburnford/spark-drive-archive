      },
      "oe:attestationBasis/#resource": "document_attested",
      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:08/0822/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "fibres_textiles",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a viscid silky fibre produced by the wing-shell mollusc (*Pinna angusta*) in the Mediterranean and West Indies, &c. The filaments are extremely fine and strong, and often reach 3 feet in length. The colour, which is a reddish brown, never fades. Stockings, gloves, and other articles have been woven of it, but more as a curiosity than for use. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 70]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 70, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 190.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n70"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n190"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q780486"
        }
      ]
    },
