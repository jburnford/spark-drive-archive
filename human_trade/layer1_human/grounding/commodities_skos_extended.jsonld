      "oe:sitcCode/#resource": "SITC4_63_Cork_and_Wood_Manufactures",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(GER. *Riemen* (zu *fahreugen*). DU. *Riemen*. DA. *Aarer*. SW. *Avor*. FR. *Avirons*, *Rames*. IT. *Remi*. SP. and PORT. *Remos*.) Oar, in navigation, a long piece of wood, for moving a vessel by rowing. Oars for ships are generally cut out of fir-timber, those for barges are made out of New England or Dantzic rafters, and those for boats out of English ash, or Norway fir-rafters. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 678]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
