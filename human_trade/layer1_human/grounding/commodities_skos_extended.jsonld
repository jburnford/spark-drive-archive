      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a wild plant, the *Asperula odorata*, found in woods in Europe. The herb while drying has the scent of new hay, approaching to bitter almonds or heliotrope. This pleasant scent has been used for flavouring wine, perfuming clothes, &c. It is deemed diuretic, and used as a substitute for tea. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 427]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 427.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n427"
        }
      ],
      "oe:sourceTaxon/#resource": [
