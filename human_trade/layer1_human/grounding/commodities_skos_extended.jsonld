      "oe:sitcCode": "SITC4_07_Coffee_Tea_Cocoa_Spices",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a general name for an infusion of herbs used as a beverage, but specially applied in commerce to the dried leaves of the *Thea Bohea* and *T. viridis*. Black tea is the leaf more fermented than green-tea. Our imports of tea in 1856 were, 86,159,517 lbs. of which 63,295,727 lbs. were taken for home consumption. See BRICK-TEA. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 386]",
        "@language": "en"
      },
