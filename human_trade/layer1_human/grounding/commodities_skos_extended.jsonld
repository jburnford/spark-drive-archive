      "oe:groundingStatus": "document_attested_local",
      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "**BROWN RED**, or **SPANISH RED**, (GER. *Braunroth*. DU. *Bruinrood*. DA. *Bruunrødt*. Sw. *Brunröd*. FR. *Brun rouge, Rouge brun. It. Rosso bruno. Sr. Almagre colorado, Almazarron. PORT. Almagre, Almagra,*) is produced by subjecting the species of earth called yellow ochre, to the action of fire, till it becomes perfectly red or nearly brown. Red ochre is much used by painter [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 848]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs & Dye Woods Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 848.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n848"
        }
      ]
    },
