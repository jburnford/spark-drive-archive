      "skos:notation": "doc_citric_acid",
      "skos:prefLabel": {
        "@value": "Citric Acid",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_industrial_chemicals_alkalis/#concept"
      },
      "oe:attestationBasis/#resource": "document_attested",
      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:05/0506/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_51_52_Chemicals",
      "skos:definition": {
        "@value": "(_Acide citrique_, Fr.; _Citronensäure_, Germ.) Scheele first procured this acid in its pure state from lemon juice, by the following process. The juice put into a large tub, is to be saturated with dry chalk in fine powder, noting carefully the quantity employed. The citrate of lime which precipitates being freed from the supernatant foul liquor, is to be well washed with repeated affusion and decantation of water. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 103.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n103"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q159683"
        }
      ]
    },
