      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_24_Cork_and_Wood",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "sawn softwood lumber",
          "@language": "en"
        },
        {
          "@value": "timber deals",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "(GER. *Dislen*. DU. *Deelen*. DA. *Dæler*. SW. *Tiljor*. FR. *Planches minces*. IT. *Tavole*, *Piane*. SR. *Tablas poco gruesas*. PORT. *Taboinhas*. RUS. *Dogki*. POL. *Taroice*,) a thin kind of fir-planks, of great use in carpentry: they are formed by sawing the trunk of a tree into a great many longitudinal divisions, of more or less thickness, according to the purposes they are intended to serve. Deals are rendered much harder, by throwing them into salt water as soon as they are sawed, keeping them there three or four days, and afterwards drying them in the air or sun; but neither this, nor any other, method yet known will preserve them from shrinking. Deals are imported by us from Dantzic, Petersburg, Narva, and many other ports in the Baltic, and from North America; [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 263]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n263"
        }
      ],
