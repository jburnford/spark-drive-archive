      "skos:definition": {
        "@value": "a name given in commerce to the fibre of the wild plantain, *Musa textilis*, brought from the Philippines, and from which the white rope so much prized is made. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 251]",
        "@language": "en"
      },
      "skos:scopeNote": {
