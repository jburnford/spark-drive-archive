      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "is a tenacious, resinous concrete; while fresh, it is ductile like pitch, but hard and friable when it has been kept for any time; outwardly of an ash colour inclining to black; inwardly of an obscure brown. It is brought to us from New Spain and other parts of America in little masses rolled up in leaves of flag. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 201]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 201.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n201"
        }
      ]
