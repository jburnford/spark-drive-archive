    {
      "@id": "htc:10/1099/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Rabbits",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1099",
      "skos:prefLabel": {
        "@value": "Rabbits",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_meats_provisions/#concept"
      },
      "oe:observationCount/#resource": 21,
      "oe:groundingStatus/#resource": "local_concept_only",
      "oe:substanceHead/#resource": "Rabbits",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "food_animal",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_pasture",
      "oe:harvestMode/#resource": "animal_husbandry",
      "oe:theodoridisBucket/#resource": "animals_and_animal_products",
      "oe:sitcCode/#resource": "SITC4_01_Meat_and_Preparations",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "In addition to the large number taken at home, we import 124,000 cwt. of rabbits yearly for food, valued at £342,000. Many millions of rabbit and hare skins are used annually in England. So numerous have these rodents become since their introduction to Australia, that in the 12 years ending 1888, 25 million rabbit skins were exported from Victoria alone. About two million hare skins come into the market here, half of which are exported. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 498]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (group=grp_meats_provisions): Rabbits here are imported by weight (cwt, Annual Statement 1886–1900, from Holland, Belgium, New Zealand), i.e. carcasses, not live animals. Layer-1 observations: 21 rows, 1886–1900. Series: HCPP_Annual Statement of Trade ×21. Units: CWTS (Hundredweights) ×21. Top routes: Holland → United Kingdom ×3; World → United Kingdom ×3; Belgium → United Kingdom ×3; New Zealand → United Kingdom ×2.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n498"
        }
      ],
      "oe:firstAttested/#resource": 1886,
      "oe:lastAttested/#resource": 1900,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade/#resource"
        }
      ]
    },
