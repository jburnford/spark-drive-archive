    {
      "@id": "htc:11/1142/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Tartaric Acid",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1142",
      "skos:prefLabel": {
        "@value": "Tartaric Acid",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_industrial_chemicals_alkalis/#concept"
      },
      "oe:observationCount/#resource": 19,
      "oe:groundingStatus/#resource": "grounded_wikidata_lexical",
      "oe:substanceHead/#resource": "Tartaric Acid",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_51_52_Chemicals",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Acide tartarique_, Fr.; _Weinsteinsäure_, Germ.) This is prepared by adding gradually to a boiling-hot solution of 100 parts of tartar, in a large copper boiler, 26 of chalk, made into a smooth pap with water. A brisk effervescence ensues, by the disengagement of the carbonic acid of the chalk, while its base combines with the acid excess in the tartar, and forms an insoluble precipitate of tartrate of lime. The supernatant liquor, which is a solution of neutral tartrate of potassa, must be drawn off by a syphon, and decomposed by a solution of chloride of calcium (muriate of lime). 28-1/2 parts of the dry chloride are sufficient for 100 of tartar. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n386"
        }
      ],
      "oe:firstAttested/#resource": 1845,
      "oe:lastAttested/#resource": 1911,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade/#resource"
        },
        {
          "@id": "oe:series_kew_cust_4/#resource"
        }
