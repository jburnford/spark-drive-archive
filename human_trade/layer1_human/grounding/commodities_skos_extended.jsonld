      },
      "skos:broader": {
        "@id": "htc:grp/grp_natural_dyestuffs/#concept"
      },
      "oe:observationCount/#resource": 64,
      "oe:groundingStatus/#resource": "grounded_wikidata_lexical",
      "oe:substanceHead/#resource": "Ultramarine",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_53_Dyeing_Tanning_Colouring",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Outremer_, Fr.; _Ultramarins_, Germ.); is a beautiful blue pigment obtained from the variegated blue mineral, called lazulite (_lapis lazuli_), by the following process:--Grind the stone to fragments, rejecting all the colourless bits, calcine at a red heat, quench in water, and then grind to an impalpable powder along with water, in a paint-mill, (see PAINTS, GRINDING OF,) or with a porphyry slab and muller. The paste being dried, is to be rubbed to powder, and passed through a silk sieve. 100 parts of it are to be mixed with 40 of rosin, 20 of white wax, 25 of linseed oil, and 15 of Burgundy pitch, previously melted together. This resinous compound is to be poured hot into cold water; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n406"
        },
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n1611"
        }
      ],
      "oe:firstAttested/#resource": 1855,
      "oe:lastAttested/#resource": 1869,
      "prov:hadPrimarySource": [
