      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the impure spirit in the process of distillation passing over at first and at last from the still; the former being called strong and the latter weak faints. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 159]",
        "@language": "en"
