      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "the *Dioscorea trifylla*, which is a native of Java and the Eastern Archipelago, and is also grown in the West Indies for its tubers. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 66]",
        "@language": "en"
      },
      "skos:scopeNote": {
