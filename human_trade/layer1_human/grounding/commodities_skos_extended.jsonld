      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "other_food_drink_spices",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "lemon",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "(GER. *Limonen*. DU. *Limoenen*. - DA. *Limoner*. - SW. *Lemoner*. FR. *Lemons*, *Citrons*. IT. *Limoni*. SP. *Limones*. PORT. *Limões*. RUS. *Limoni*. POL. *Limoni*. LAT. *Citrea mala*,) the fruit of the lemon-tree, growing in great abundance in Spain and Portugal, whence we import them, packed in chests and boxes. The ports of Lisbon and Malaga are the principal shipping places of lemons; the shipping of fruit from these places commences about the middle of September, and continues until the February following, after which time the article becomes scarce and dear. The lemon-tree is a native of Media and Assyria, and thrives extremely well in warm climates. Besides the two countries already mentioned, this tree is cultivated in Italy, Provence, Languedoc, and other parts of the south of France. The varieties of the lemon are numerous. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 572]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n572"
        }
