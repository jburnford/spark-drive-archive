      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1181",
      "skos:prefLabel": {
        "@value": "Tortoise Shell",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_fertilizers_animal_materials/#concept"
      },
      "oe:observationCount/#resource": 18,
      "oe:groundingStatus/#resource": "grounded_wikidata_lexical",
      "oe:substanceHead/#resource": "Tortoise Shell",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "marine",
      "oe:harvestMode/#resource": "wild_hunted_fished",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the imbricated plates covering the back of the sea-turtle, *Chelone imbricata* and *caretta*, used for making combs, and veneering on fancy cabinet-work. Five large plates are obtained from the middle of the carapace or upper buckler, and four large ones from the sides, called \"blades\" and twenty-five smaller plates from the edges called \"feet or noses.\" In an animal of the ordinary size, about three feet long and 2½ wide, the largest plates will weigh about 9 oz., and measure about 13 by 8 inches, and one-fourth of an inch thick in the middle. The belly shells are of a yellow colour, and are used for the purposes of horn. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 397]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (group=grp_fertilizers_animal_materials; land_basis=marine): Marine animal raw material (mother-of-pearl, tortoise/turtle shell, pearls) left in the residual bin. Layer-1 observations: 18 rows, 1866–1866. Series: HCPP_Annual Statement of Trade ×18. Units: Lbs. (Pounds) ×18. Top routes: France → United Kingdom ×1; Holland → United Kingdom ×1; World → United Kingdom ×1; Australia → United Kingdom ×1.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
