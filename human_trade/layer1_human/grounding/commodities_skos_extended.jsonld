        "@id": "htc:grp/grp_fertilizers_animal_materials/#concept"
      },
      "oe:observationCount/#resource": 130,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Isinglass",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "marine",
      "oe:harvestMode/#resource": "wild_hunted_fished",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "or Fish-glue, called in Latin _ichthyocolla_, is a whitish, dry, tough, semi-transparent substance, twisted into different shapes, often in the form of a lyre, and consisting of membranes rolled together. Good isinglass is unchangeable in the air, has a leathery aspect, and a mawkish taste nearly insipid; when steeped in cold water it swells, softens, and separates in membranous laminæ. At the boiling heat it dissolves in water, and the solution, on cooling, forms a white jelly, which is semi-transparent, soluble in weak acids, but is precipitated from them by alkalies. It is gelatine nearly pure; and if not brittle, like other glue, this depends on its fibrous and elastic texture. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b31361584/page/n707"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n218"
        }
      ],
      "oe:firstAttested/#resource": 1800,
      "oe:lastAttested/#resource": 1906,
      "prov:hadPrimarySource": [
