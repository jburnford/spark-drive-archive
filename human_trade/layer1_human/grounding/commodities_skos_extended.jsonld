      "oe:sitcCode/#resource": "SITC4_27_Crude_Fertilizers_and_Minerals",
      "skos:definition": {
        "@value": "popularly CORNELIAN (Ger. *achat*; Dutch, *achaat*; Fr. *agate*; Ital. *agata*; Russ. *agat*; Lat. *achates*). A genus of semi-pellucid gems, so called from the Greek *ἀγάτης*, because originally found on the banks of the river of that name in Italy. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 58]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0653 (Precious Stones Unset). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 58, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 28.",
        "@language": "en"
      },
