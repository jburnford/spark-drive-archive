      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "fats_oils_soap",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "a name for the *Andropogon citratum* of Decandolle. From its fragrant smell and pleasant taste, it is in common use in the West Indies as a substitute for Chinese tea, and is frequently employed as a sudorific in febrile diseases. The white succulent centre or pith of the leaves is used in India to give an agreeable flavour to curries. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 238]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 238, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 480.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n238"
        },
        {
