      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the small almonds or nuts in the drupe of the *Pistacia vera*, and its varieties, natives of Syria, which are imported in small quantities from Messina, Sicily, and other ports in the Mediterranean, either shelled or unshelled. The kernels are small, pale green, with a flavour like sweet almonds. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 301]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 301.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
