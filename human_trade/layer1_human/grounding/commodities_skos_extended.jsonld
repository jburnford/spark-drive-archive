      "skos:definition": {
        "@value": "the Venetina ducat; a gold coin passing in Malta for about 7s.; in Egypt for 140 medial or paras. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 433]",
        "@language": "en"
      },
      "skos:scopeNote": {
