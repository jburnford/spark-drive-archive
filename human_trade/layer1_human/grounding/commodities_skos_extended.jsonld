      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "beeswax",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the wax-comb after the honey is removed, which is used for making candles, sealing-wax, polishing furniture, &c. We import quantities from India, Africa, and other parts of the world. Two kinds occur in commerce, the yellow and the white or bleached. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 45]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
