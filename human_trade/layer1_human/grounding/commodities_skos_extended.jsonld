      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:definition": {
        "@value": "the fruit of the *Attalea funifera*, a South American palm. These hard mottled nuts, which take a fine polish, are largely imported for the purposes of the turner, who shapes them into various small ornamental and useful articles, especially the handles of bell-pulls, the knobs of walking-sticks, umbrellas, &c. The same palm furnishes the piassaba fibre of commerce. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 118]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0352 (Nuts and Kernels Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 118.",
        "@language": "en"
      },
