    {
      "@id": "htc:05/0572/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Whalebone",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0572",
      "skos:prefLabel": {
        "@value": "Whalebone",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:sub/sub_fertilizer_wd_q275426/#concept"
      },
      "oe:observationCount/#resource": 63,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Whalebone",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "marine",
      "oe:harvestMode/#resource": "wild_hunted_fished",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "baleen",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the commercial name for the baleen plates in the mouth of the whale, of which there are about 300. They are chiefly obtained from the Greenland and Southern whales, *Balaena mysticetus*, and *australis*. It is softened by boiling, and is dyed black. The principal use of whalebone is for the ribs or stretchers for umbrellas, for canes, whips, and as a substitute for bristles in common brushes. In the form of shavings, it is sometimes braided into hats and bonnets. See **FIXNER-WHALE**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 422]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (land_basis=marine): Marine origin (whalebone, shells, sea otter, marine-animal and fish skins). Layer-1 observations: 63 rows, 1886–1906. Series: HCPP_Annual Statement of Trade ×63. Units: CWTS (Hundredweights) ×63. Top routes: France → United Kingdom ×5; World → United Kingdom ×5; Belgium → United Kingdom ×5; Other British Possessions → United Kingdom ×5.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n422"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "oe:firstAttested/#resource": 1886,
      "oe:lastAttested/#resource": 1906,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade/#resource"
        }
      ],
