      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "grain_and_flour",
      "oe:sitcCode/#resource": "SITC4_04_Cereals_and_Preparations",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(GER. *Mehl.* DU. and DA. *Meal.* SW. *Mjöl.* FR. and IT. *Farine.* SP. *Harina.* PORT. *Farinha.* RUS. *Muka.* POL. *Maka.* LAT. *Farina,*) the edible part of wheat, oats, rye, barley, and pulse of different kinds, ground into a species of flour. The difference between flour, properly so called, and meal, is, that the former is freed from the husky part, and other impurities of the species of corn whereof it is made, but the latter is not. Meal is denominated according to the kind of grain that affords it; such as oat-meal, rye-meal, barley-meal, &c. Scotland is famous for oat-meal; England, America, and Normandy in France, excel most in meal of wheat. See CORN. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 628]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n628"
        }
      ],
