      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:altLabel": [
        {
          "@value": "poison nut",
          "@language": "en"
        },
        {
          "@value": "semen strychnos",
          "@language": "en"
        },
        {
          "@value": "quaker buttons",
          "@language": "en"
        },
        {
          "@value": "Strychnos Nux Vomica",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Nux vomica is better known as the strychnine tree. The seeds contain roughly 1.5% strychnine. The dried blossoms of nux vomica contain 1%, and while the bark contains no strychnine, other poisonous compounds such as brucine are present.( https://en.wikipedia.org/wiki/Strychnos_nux-vomica) Three preparations are listed in the Pharmacopeia (extract, strychnia, and tincture), and the only mention in the Compendium comes [Danika Drugs Project: British Pharmacopoeia (1867) / Savory (1865)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Danika Drugs.xlsx (British Pharmacopoeia 1867 / Savory 1865), Danika Drugs.xlsx (SKOS Sheet), 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 274, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 678. Research note: CDM1865: another form for Strychnine? (167).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n274"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n678"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ]
    },
    {
