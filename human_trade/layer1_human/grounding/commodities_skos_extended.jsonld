      "oe:ghostAcresDomain/#resource": "fats_oils_soap",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:sitcCode/#resource": "SITC4_42_Fixed_Vegetable_Fats_and_Oils",
      "skos:definition": {
        "@value": "an empyreumatic oil obtained by distillation in a retort, from the wood of *Juniperus Oxycedrus*. It is much used in France in veterinary medicine. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 72]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 72.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
