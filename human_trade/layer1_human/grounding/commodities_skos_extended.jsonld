      "oe:sitcCode/#resource": "SITC4_26_Textile_Fibres",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the waste fibres or refuse after carding flax and bemp which is made into bags, sheeting, and yarn, and used for various other purposes; some kinds are called codilia; wo imported, in 1856, about 11,000 tons; to draw a vessel along by means of a rope. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 398]",
        "@language": "en"
      },
