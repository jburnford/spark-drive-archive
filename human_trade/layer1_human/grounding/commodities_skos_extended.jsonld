    {
      "@id": "htc:02/0275/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Cutch",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0275",
      "skos:prefLabel": {
        "@value": "Cutch",
        "@language": "en"
      },
      "skos:broader": {
