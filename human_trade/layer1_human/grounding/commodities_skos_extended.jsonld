      "oe:sitcCode": "SITC4_64_66_89_Paper_Glass_Misc_Manufactures",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a bluish-white metal, which may be rolled or hammered out to a certain extent. The ores yielding it are various, and brought from different localities. It comes in chiefly from Germany under the name of spelter, the imports being 18,000 or 19,000 tons annually; in 1856 they were 18,213 tons. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 433]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
