      },
      "oe:attestationBasis": "document_attested",
      "oe:subsumedInCustomsHeading": {
        "@id": "htc:0506"
      },
      "oe:groundingStatus": "document_attested_grounded",
      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "mineral",
      "oe:sitcCode": "SITC4_51_52_Chemicals",
      "skos:altLabel": [
        {
          "@value": "sodium sulfate",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "is commonly called Glauber’s salt, from the name of the chemist who first prepared it. It is obtained by igniting and then crystallizing the residuum of the distillation of muriatic acid from common salt. It crystallizes in channelled 6-sided prisms. See SODA MANUFACTURE. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
