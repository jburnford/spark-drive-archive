      },
      "oe:attestationBasis/#resource": "document_attested",
      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:00/0054/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:altLabel": [
        {
          "@value": "verdigres",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the acetate of copper; obtained by exposing thin plates of copper, for some time, to the action of the air or more of the wine-presses in the South of France. Besides the French verdigris, there are green distilled, common, and crystallized verdigris. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 411]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Danika Drugs.xlsx (British Pharmacopoeia 1867 / Savory 1865), 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 411, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1621. Research note: Subacetate of copper of commerce, used in pigment, and chemical testing. Not much else for drugs..",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n411"
        },
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n1621"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q2351119"
        }
      ]
    },
    {
