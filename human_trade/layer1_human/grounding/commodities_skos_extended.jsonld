      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a simple substance, much resembling wax in consistence; when pure, it is nearly of the transparency of gum-copal, varying from amber-red to the faintest straw colour, highly combustible, and when oxygenated, producing a strong and peculiar acid. It was discovered by a German chemist, of the name of Brandt, about 160 years since. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 750]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 750.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n750"
        }
      ],
      "skos:closeMatch": [
