      "oe:theodoridisBucket": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "small shaped plates or large slabs of slate, chiefly used for roofing. For commercial purposes slates are classed into the following principal varieties:—Doubles, measuring 13 inches by 7, and smaller, 11 by 7; ladies, 16 by 10, 16 by 8, 14 by 8, or 12 by 8; countesses, 20 by 10; viscountesses, 18 by 10; marchionesses, 22 by 12; duchesses, 24 by 12; princesses, 24 inches long, various breadths. A thousand slates... [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 360]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n360"
        },
