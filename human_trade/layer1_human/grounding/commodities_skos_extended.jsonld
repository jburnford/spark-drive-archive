      },
      "oe:attestationBasis/#resource": "document_attested",
      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:01/0124/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "fats_oils_soap",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:altLabel": [
        {
          "@value": "Croton",
          "@language": "en"
        },
        {
          "@value": "Oil (not seed)",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "The expressed oil from the seeds of the *Croton tiglium*, a small tree growing in Hindostan, Ceylon, and the Moluccas, and belonging to the Natural Order *Euphorbiaceæ*. The whole plant contains an acrid, purgative principle. The seeds have been known in Europe from the beginning of the 17th century, under the name of *grana Molucca* and *grana tiglia*. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 555]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 555.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n555"
        }
      ],
