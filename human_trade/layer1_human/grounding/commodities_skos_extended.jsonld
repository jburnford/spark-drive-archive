      "skos:definition": {
        "@value": "a name for *Smilax rotundifolia*, the root of which is much used for howls of tobacco pipes. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 447]",
        "@language": "en"
      },
      "skos:scopeNote": {
