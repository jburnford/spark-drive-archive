        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:sub/sub_dairy_eggs_wd_q34172/#concept"
      },
      "oe:observationCount/#resource": 2148,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Butter",
      "oe:processingState/#resource": "dairy_processed",
      "oe:ghostAcresDomain/#resource": "food_animal",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_pasture",
      "oe:harvestMode/#resource": "animal_husbandry",
      "oe:theodoridisBucket/#resource": "animals_and_animal_products",
      "oe:sitcCode/#resource": "SITC4_02_Dairy_and_Eggs",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "a common name for all animal and vegetable solid oils and fats, but popularly applied to that from the milk of the cow, used for food. The home production of butter is very considerable; but we also import large quantities from the United States, the Continent, and Ireland. Fresh butter is sold in printed pats, or one pound rolls—salted butter in bulk. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 69]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n69"
        },
