    {
      "@id": "htc:17/1726/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Manganese",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1726",
      "skos:prefLabel": {
        "@value": "Manganese",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_metals_semi_finished/#concept"
      },
      "oe:observationCount/#resource": 6,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Manganese",
      "oe:processingState/#resource": "smelted_semi",
      "oe:ghostAcresDomain/#resource": "minerals_metals_energy",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_67_68_Metals",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "is a grayish-white metal, of a fine-grained fracture, very hard, very brittle, with considerable lustre, of spec. grav. 8·013, and requiring for fusion the extreme heat of 160° Wedgewood. It should be kept in closely stoppered bottles, under naphtha, like potassium, because with contact of air it speedily gets oxidized, and falls into powder. It decomposes water slowly at common temperatures, and rapidly at a red heat. Pure oxide of manganese can be reduced to the metallic state only in small quantities, by mixing it with lamp black and oil into a dough, and exposing the mixture to the intense heat of a smith’s forge, in a luted crucible; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n612"
        },
        {
          "@id": "https://archive.org/details/b31361584/page/n774"
        }
      ],
      "oe:firstAttested/#resource": 1871,
      "oe:lastAttested/#resource": 1888,
