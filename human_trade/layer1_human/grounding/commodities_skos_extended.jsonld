      "oe:observationCount/#resource": 14,
      "oe:groundingStatus/#resource": "local_concept_only",
      "oe:substanceHead/#resource": "Pearls",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "marine",
      "oe:harvestMode/#resource": "wild_hunted_fished",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Perles_, Fr.; _Perlen_, Germ.); are the productions of certain shell-fish. These molluscæ are subject to a kind of disease caused by the introduction of foreign bodies within their shells. In this case, their pearly secretion, instead of being spread in layers upon the inside of their habitation, is accumulated round these particles in concentric layers. Pearl consists of carbonate of lime, interstratified with animal membrane. The oysters whose shells are richest in mother of pearl, are most productive of these highly prized spherical concretions. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (group=grp_fertilizers_animal_materials; land_basis=marine): Marine animal raw material (mother-of-pearl, tortoise/turtle shell, pearls) left in the residual bin. Layer-1 observations: 14 rows, 1856–1866. Series: HCPP_Annual Statement of Trade ×14. Units: (no unit) ×14. Top routes: World → United Kingdom ×3; Other Parts → United Kingdom ×3; Egypt → United Kingdom ×3; St. Thomas → United Kingdom ×3.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n740"
        }
      ],
      "oe:firstAttested/#resource": 1856,
      "oe:lastAttested/#resource": 1866,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade/#resource"
        }
      ]
