      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a scarce and expensive medicinal resin, obtained from the surface of the leaves of *Cistus Creticus* in Candia, &c. It is used in plasters, in perfumery, for pastilles, and as an expectorant. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 231]",
        "@language": "en"
      },
      "skos:scopeNote": {
