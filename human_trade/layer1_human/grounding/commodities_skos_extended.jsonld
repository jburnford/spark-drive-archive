      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "minerals_metals_energy",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_27_Crude_Fertilizers_and_Minerals",
      "skos:definition": {
        "@value": "a mineral only found on the west coast of Greenland, lately imported as a source of aluminium; which it is said can be afforded at a price as low as silver. Besides this metal and crystals of soda, a clay is obtainable which will be valuable to calico printers as a substitute for a compound of alum and sugar of lead. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 127]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1905 (Minerals Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 127.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n127"
        }
      ],
      "skos:closeMatch": [
