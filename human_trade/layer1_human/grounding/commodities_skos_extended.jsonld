      "oe:groundingStatus": "document_attested_grounded",
      "oe:ghostAcresDomain": "tannins_leather",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a name for two distinct animals, the land-otter, *Lutra vulgaris* and *L. Canadensis*, and the sea-otter, *Enhydra marina*. Both are caught for their fur: of the former we receive about 20,000 skins a-year. The latter, more like the seal in its habits, is obtained in much smaller numbers, but being the royal fur of China is highly valued there and in Russia. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 280]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0071 (Furs, Skins & Marine Products Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 280.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n280"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q15837862"
        }
      ]
    },
