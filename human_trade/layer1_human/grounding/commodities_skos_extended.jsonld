      "rdfs:label": {
        "@value": "Mustard",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1950",
      "skos:prefLabel": {
        "@value": "Mustard",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_spices_condiments/#concept"
      },
      "oe:observationCount/#resource": 2,
      "oe:groundingStatus/#resource": "grounded_wikidata_lexical",
      "oe:substanceHead/#resource": "Mustard",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "other_food_drink_spices",
      "oe:sitcCode/#resource": "SITC4_07_Coffee_Tea_Cocoa_Spices",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(Ger. mustert, senf; Fr. moutarde; Ital. mostarda; Span. mostaza; Russ. gortschiza; Lat. sinapis; Arab. khirdal; Hin. rai). A plant (*Sinapis*) of which there are several species, some of them indigenous to Great Britain. It was formerly extensively cultivated in Durham, but it is now seldom seen in that county. It is, however, raised in the neighbourhood of York, and throughout other parts of the North Riding; and being manufactured in the city of York, is afterwards sold under the name of Durham mustard. Mustard is of considerable importance in the materia medica, and is extensively used as a condiment. Its greenish-yellow hue, acrid taste, and pungent irritating odour when mixed, are familiar to all. It was not, however, known in its present form, at our tables, till 1720. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 999]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n999"
