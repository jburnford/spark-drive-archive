      "oe:processingState/#resource": "raw_unprocessed",
      "oe:ghostAcresDomain/#resource": "food_grain",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "grain_and_flour",
      "oe:sitcCode/#resource": "SITC4_04_Cereals_and_Preparations",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the seed of the *Avena sativa*, the hardest of all the cereal grasses, of which there are many cultivated varieties: it is extensively used as a horse-food, and also for bread and porridge in the northern counties, being hardy and containing a large amount of nutritive matter. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 274]",
        "@language": "en"
      },
