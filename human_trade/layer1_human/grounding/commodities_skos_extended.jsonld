    {
      "@id": "htc:14/1426/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Capers",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "1426",
      "skos:prefLabel": {
        "@value": "Capers",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_spices_condiments/#concept"
      },
      "oe:observationCount/#resource": 11,
      "oe:groundingStatus/#resource": "grounded_wikidata_lexical",
      "oe:substanceHead/#resource": "Capers",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "other_food_drink_spices",
      "oe:sitcCode/#resource": "SITC4_07_Coffee_Tea_Cocoa_Spices",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(*Capers*. GER. *Kapern*. DU. *Kappers*. DA. *Kapers, Kappers*. SW. *Kapris, Capris*. FR. *Capres*. IT. *Cappari*. SP. *Alcapparras*. PORT. *Alcapparras*. RUS. *Kaperszii*. POL. *Kapary*.) *Caparis spinosa*, or common caper, a low shrub, generally growing out of the joints of old walls or fissures of rocks in the warm parts of Europe. This plant is with great difficulty preserved in England. It grows in great perfection in the southern parts of France, and in Italy. The capers sold in the shops are the full-grown buds of the flowers gathered before they blow, and spread in the shade till they begin to grow flaccid. Then they are put in a vessel, vinegar added to them, covered with a board, and let to remain for eight days; then being taken out of the vessel, they are squeezed gently; and fresh vinegar added, and let to stand for eight days more. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 199]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (group=grp_spices_condiments): Capers / pickled cucumbers are condiments (cf. Pickles, htc:1062). Layer-1 observations: 11 rows, 1800–1800. Series: KEW_CUST 5 ×11. Units: Lbs. (Pounds) ×11. Top routes: France → United Kingdom ×1; Holland → United Kingdom ×1; Italy → United Kingdom ×1; World → United Kingdom ×1.",
          "@language": "en"
        },
        {
          "@value": "Curated fields — definition use: Homonym: Scots 'caper' = oat-cake; heading is pickled caper buds.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n199"
        },
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n329"
        }
      ],
      "oe:firstAttested/#resource": 1800,
      "oe:lastAttested/#resource": 1800,
