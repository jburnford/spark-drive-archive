      "oe:sitcCode/#resource": "SITC4_05_Vegetables_and_Fruit",
      "skos:altLabel": [
        {
          "@value": "Tonquin Bean",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the fruit of the _Dipterix odorata_, affords a concrete crystalline volatile oil (_stearoptène_), called _coumarine_ by the French. It is extracted by digestion with alcohol, which dissolves the stearoptène, and leaves a fat oil. It has an agreeable smell, and a warm taste. It is fusible at 122° Fahrenheit, and volatile at higher heats. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "skos:closeMatch": [
