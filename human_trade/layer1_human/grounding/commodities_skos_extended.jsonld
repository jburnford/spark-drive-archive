      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a concrete oil, obtained in India from the dried fruit of the *Garcinia purpurea*. It is used as an article of food, and as a medicine. *See* **COCUM BUTTER**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 229]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 229.",
        "@language": "en"
      },
