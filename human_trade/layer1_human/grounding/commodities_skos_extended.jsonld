      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "*Gaertn.*; *Fl. Br. Ind.*, ii., 45; *Talbot, List Trees, etc.*, 1902, 118-9; *Gamble, Man. Ind. Timbs.*, 1902, 224-5; *Duthie, Fl. Upper Gang. Plain*, 1903, 192-3; *Cooke, Fl. Pres. Bomb.*, 1903, i., 282; **MORINGÆ**. The Horse-radish Tree, *sajuna* (or *sajina*), *shájnah, sunjna, munigha, munga arak, saragvo, sekto, muna-gácha jháda, músing, murungai, dándalon bín*, etc. [Sir George Watt, The Commercial Products of India (1908), scan p. 796]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 796.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
