      },
      "oe:groundingStatus": "document_attested_grounded",
      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a mineral only found on the west coast of Greenland, lately imported as a source of aluminium; which it is said can be afforded at a price as low as silver. Besides this metal and crystals of soda, a clay is obtainable which will be valuable to calico printers as a substitute for a compound of alum and sugar of lead. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 127]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 127.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n127"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "http://www.wikidata.org/entity/Q193502"
        }
      ]
    },
    {
      "@id": "htc:doc_cubibs",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Cubibs",
