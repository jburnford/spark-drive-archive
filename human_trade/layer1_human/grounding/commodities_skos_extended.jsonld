      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "an insect produced on the *Quercus coccifera*, which furnishes a red colouring matter. Also the name for a brick-red mineral powder, a fictitious sulphuret of antimony, for dyeing, and formerly used in medicine. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 225]",
        "@language": "en"
      },
      "skos:scopeNote": {
