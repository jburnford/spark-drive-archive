      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a slender tree, the *Duquetia quitarensis*, of Lindley, the *Guatteria virgata* of others; found in tolerable abundance in the interior of Guiana, and also imported from Cuba and Jamaica. The wood possesses much toughness and elasticity, and is used for gig shafts, archery bows, billiard cues, and other purposes. Its native name is yarri-yarri. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 233]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 233.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n233"
        }
      ],
      "oe:sourceTaxon/#resource": [
        {
          "@id": "http://www.wikidata.org/entity/Q110883808"
        }
      ]
