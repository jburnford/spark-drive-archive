      "oe:theodoridisBucket": "raw_materials",
      "oe:sitcCode": "SITC4_27_Crude_Fertilizers_and_Minerals",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a commercial weight varying with the article weighed, but legally 14 lbs. The stone of butcher's meat or fish is usually reckoned at 8 lbs.; of cheese 16 lbs.; of hemp 32 lbs.; of glass 5 lbs. In Hamburg a stone of flax is 20 lbs.; of feathers 10 lbs. The Prussian stone of 22 lbs. is equal to 22 $\\frac{1}{2}$ lbs. avoirdupois, 5 stone making 1 trade centner, of 110 lbs. = 113 lbs. avoirdupois, nearly. \\* [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 374]",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n374"
        },
