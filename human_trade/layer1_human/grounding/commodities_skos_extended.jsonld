      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "(Eng. and Fr., _Yellow sulphuret of arsenic_; _Operment_, _Rauschgelb_, Germ.); occurs in indistinct crystalline particles, and sometimes in oblique rhomboidal prisms; but for the most part, in kidney and other imitative forms; it has a scaly and granular aspect; texture foliated, or radiated; fracture small granular, passing into conchoidal; splintery, opaque, shining, with a weak diamond lustre; lemon, orange, or honey yellow; sometimes green; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ],
      "skos:closeMatch": [
