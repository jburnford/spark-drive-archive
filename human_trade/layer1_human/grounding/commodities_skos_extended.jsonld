      "oe:attestationBasis": "document_attested",
      "oe:subsumedInCustomsHeading": {
        "@id": "htc:0041"
      },
      "oe:groundingStatus": "document_attested_local",
      "oe:ghostAcresDomain": "tannins_leather",
      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "*Willd.*; *Fl. Br. Ind.*, ii., 292-8; *Agric. Ledg.*, 1902, No. 2; LEGUMINOSÆ. A genus of spinose or prickly climbing shrubs or trees, which constitutes the most characteristic group of plants in the Sub-order MIMOSEÆ. There are in all 430 species, of which two- thirds are peculiar to Australia. India possesses only some 22, and these are distributed throughout the plains, two  [Sir George Watt, The Commercial Products of India (1908), scan p. 14]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0041 (Tanning Barks & Extracts Unenumerated). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 14, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 12.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b31361584/page/n14"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n12"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n14"
        }
      ],
      "oe:sourceTaxon": [
        {
          "@id": "http://www.wikidata.org/entity/Q15289503"
        }
      ]
    },
