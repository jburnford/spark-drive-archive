      },
      "oe:observationCount/#resource": 140,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Cutch",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "tannins_leather",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "catechu",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "absurdly called Terra Japonica, is an extract made from the wood of the tree _mimosa catechu_, which grows in Bombay, Bengal, and other parts of India. It is prepared by boiling the chips of the interior of the trunk in water, evaporating the solution to the consistence of syrup over the fire, and then exposing it in the sun to harden. It occurs in flat rough cakes, and under two forms. The first, or the Bombay, is of uniform texture, of a dark red colour, and of specific gravity 1·39. The second is more friable and less solid. It has a chocolate colour, and is marked inside with red streaks. Its specific gravity is 1·28. According to Sir H. Davy, these two species are composed as follows:-- [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Historical South/Southeast Asian vegetable tanning and dyeing extract (Senegalia catechu); 19th-century customs clerks frequently conflated cutch and gambier under 'Terra Japonica'.",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — definition use: Auto-match had picked an export-statistics sentence; Ure's CATECHU entry defines cutch.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n128"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n460"
        }
      ],
      "oe:firstAttested/#resource": 1855,
      "oe:lastAttested/#resource": 1918,
      "prov:hadPrimarySource": [
