    {
      "@id": "htc:01/0182/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Mahogany - Furniture, Hardwoods or Veneers",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0182",
      "skos:prefLabel": {
        "@value": "Mahogany - Furniture, Hardwoods or Veneers",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_sawn_lumber/#concept"
      },
      "oe:observationCount/#resource": 189,
      "oe:groundingStatus/#resource": "local_concept_only",
      "oe:substanceHead/#resource": "Mahogany",
      "oe:processingState/#resource": "manufactured",
      "oe:ghostAcresDomain/#resource": "timber_forestry",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "manufactured_articles",
      "oe:sitcCode/#resource": "SITC4_24_Cork_and_Wood",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "a well-known valuable furniture wood, chiefly imported from Honduras, where it is obtained from a large forest tree, the *Swietenia Mahagoni*. African mahogany is the wood of *Khaya senegalensis*. The wood of the Toon-tree (*Cedrela Toona*) is sometimes called Indian mahogany. Our imports of mahogany average about 33,000 tons per annum. The stringent bark is used in the West Indies as a substitute for cinchona, but contains no alkaline principle. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 249]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n249"
