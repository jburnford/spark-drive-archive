      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_27_Crude_Fertilizers_and_Minerals",
      "skos:definition": {
        "@value": "a valuable gem for ornamental purposes. The finest stones, which are of a pure green, come either from Peru or the East Indies; a new kind of prluting type, intermediate between minion and noaparell. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 152]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0653 (Precious Stones Unset). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 152, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
