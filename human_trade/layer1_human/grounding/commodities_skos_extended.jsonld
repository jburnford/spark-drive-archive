      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a valuable furniture wood obtained in Malabar, the best being from the *Dalbergia latifolia*. It is locally called rose-wood. The blackwood of New South Wales, also known as light wood, is the *Acacia melanoxylon*. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 52]",
        "@language": "en"
      },
      "skos:scopeNote": {
