      "oe:ghostAcresDomain/#resource": "timber_forestry",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a well-known tree. The wood of the European species, *Taxus baccata*, and its varieties, is occasionally used for the construction of bows, handles to furniture and cabinet work. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 432]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 432.",
