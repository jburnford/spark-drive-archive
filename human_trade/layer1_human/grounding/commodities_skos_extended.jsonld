      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "(GER. *Amerikanische Grieswurzels*. DU. *Graveelwortel*. DA. *Amerikansk grususrod*. SW. *Grusrot*. FR. and IT. *Pareira-brava*. SP. *Parreira-brava*, *Butua*. PORT. and LAT. *Pareira brava*.) a hard, woody, crooked root, of a dark colour on the outside, and marked with various wrinkles, which run longitudinally and circularly. Its internal substance is of a dull yellowish colour, and interwoven with ligneous fibres. This root has no smell, but a little bitterish taste, blended with a sweetness, like that of licorice. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 732]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 732.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n732"
        }
      ]
    },
