    {
      "@id": "htc:scheme/#resource",
      "@type": "skos:ConceptScheme",
      "rdfs:label": {
        "@value": "Open Empire Layer-1 Human-Transcribed Trade Commodities SKOS Vocabulary (LINCS / CIDOC CRM E55_Type Compatible)",
        "@language": "en"
      },
      "dcterms:title": {
        "@value": "Open Empire Layer-1 Human-Transcribed Trade Commodities SKOS Vocabulary (LINCS / CIDOC CRM E55_Type Compatible)",
        "@language": "en"
      },
      "dcterms:description": {
        "@value": "Four-tier historical archival SKOS vocabulary and thesaurus (9 Macro-Sectors -> 44 Commodity Groups -> Canonical Substance Groups -> 2,066 persistent verbatim British & Canadian customs headings, dual-typed as skos:Concept and crm:E55_Type for LINCS/CIDOC CRM interoperability) enriched with definitions, scopeNotes, synonyms, cross-stage material chains, and verified Linnaean source taxa mined from six 19th-century commercial dictionaries (Simmonds 1892/1854, Mortimer 1823, McCulloch 1880, Watt 1908, Ure) and linked via reversible multi-anchor SKOS mappings to Wikidata (2026-11-09), FAO AGROVOC, ZBW STW Economics, Getty AAT, Catalogue of Life, SITC Rev. 4, and Theodoridis (2018).",
        "@language": "en"
      },
      "dcterms:creator": {
        "@value": "Dr. Jim Clifford & HGIS Lab, University of Saskatchewan",
        "@language": "en"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:created": {
        "@value": "2026-11-25",
        "@type": "xsd:date"
      },
      "owl:versionInfo": "7.0",
