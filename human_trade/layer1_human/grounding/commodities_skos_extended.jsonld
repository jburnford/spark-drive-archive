      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a massive mineral pigment, used by painters as a brown colour, and to make varnish dry quickly. It is used either in its natural state, or burnt. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 406]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 406, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
