      "oe:groundingStatus": "document_attested_grounded",
      "oe:ghostAcresDomain": "drugs_botanicals_chemicals",
      "oe:landBasis": "mineral",
      "oe:sitcCode": "SITC4_51_52_Chemicals",
      "skos:definition": {
        "@value": "(_Acide Acétique_, Fr.; _Essigsäure_, Germ.) is the name of the sour principle which exists in vinegar. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
