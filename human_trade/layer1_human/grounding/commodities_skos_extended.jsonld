      "oe:sitcCode": "SITC4_11_Beverages",
      "oe:isAggregate": false,
      "skos:definition": {
        "@value": "a distillation from light-coloured wines and the skins of grapes, manufactured chiefly in the South of Europe; the trade in this spirit being very large. Cognac is the purest, oldest, and palest brandy. British brandy is a cheaper compound of rectified spirits. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 61]",
        "@language": "en"
      },
      "oe:dictionarySource": [
