      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(GER. *Glasperlen, Glaskoralen*. DU. *Venetiaanse parlen*. DA. *Glaskoraller*. SW. *Glaspärlor*. FR. *Verroterie, Rassade, Rocaille*. IT. *Contaria, Margheretine*. SP. *Abalorios, Rocalla, Vidrieria*. PORT. *Missanga, Aljofar*. RUS. *Bisser i Dekui*. POL. *Koraliki sklane*,) are small glass beads of different colours, of which large quantities are exported to Africa, and there bartered on the coast, for slaves, ivory, gums, &c. &c. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 181]",
        "@language": "en"
      },
