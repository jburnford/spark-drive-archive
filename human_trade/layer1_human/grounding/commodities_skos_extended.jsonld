      },
      "skos:notation": "0684",
      "skos:prefLabel": {
        "@value": "Turpentine",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:sub/sub_gums_resin_wd_q201382/#concept"
      },
      "oe:observationCount/#resource": 49,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Turpentine",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Térébinthine_, Fr.; _Terpenthin_, Germ.); is a substance which flows out of incisions made in the stems of several species of pines. It has the consistence and gray-yellow colour of honey. It has a smell which is not disagreeable to many persons, a warm, sharp, bitterish taste; dries into a solid in the air, with the evaporation of its volatile oil. It becomes quite fluid at a moderate elevation of temperature, and burns at a higher heat, with a bright but very fuliginous flame. There are several varieties of turpentine. 1. _Common turpentine_, is extracted from incisions in the _Pinus abies_ and _Pinus silvestris_. It has little smell; but a bitter burning taste. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
