      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:03/0382/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_grounded",
      "oe:ghostAcresDomain/#resource": "minerals_metals_energy",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_28_Metalliferous_Ores",
      "skos:definition": {
        "@value": "(Eng. and Fr.; _Wolfram_, Germ.); is a peculiar metal, which occurs in the state of an acid (the _tungstic_), combined with various bases, as with lime, the oxides of iron, manganese, and lead. The metal is obtained by reduction of the ore, or the deoxidizement of the acid, in the form of a dark steel-gray powder, which assumes under the burnisher a feeble metallic lustre. Its specific gravity is 17·22. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0382 (Ore Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 515.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
