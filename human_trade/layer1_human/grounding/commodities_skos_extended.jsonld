      },
      "oe:observationCount/#resource": 2,
      "oe:groundingStatus/#resource": "local_concept_only",
      "oe:substanceHead/#resource": "Benjamin",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "an odoriferous gum-resin, obtained in Siam, and the Eastern Archipelago, from *Styrax Benzoin*, and used in perfume and license. It is of a yellowish gold colour with occasionally white almond-like masses in it; there are, however, two or three varieties which enter into commerce. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 46]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated classification (group=grp_gums_resins_naval_stores): Named gum-resin under an archaic spelling (olibanum; 'Benjamin' = benzoin, Simmonds 1892 s.v. BENJAMIN; 'camphire' = camphor) left in the residual bin. Layer-1 observations: 2 rows, 1800–1800. Series: KEW_CUST 5 ×2. Units: Lasts ×2. Top routes: World → United Kingdom ×1; East Indies and China → United Kingdom ×1.",
          "@language": "en"
        }
