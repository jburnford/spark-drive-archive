      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "Musk is used to denote a class of substances that emit a strong scent that is commonly used as a base note in perfumes. The name was originally derived from the gland secretions from the mush deer, but can now also be used to refer to scents obtained from other animals and plants. (https://en.wikipedia.org/wiki/Musk) Musk is used as an antispasmodic and stimulant in the Compendium, being noted as “one of the stronges [Danika Drugs Project: British Pharmacopoeia (1867) / Savory (1865)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Danika Drugs.xlsx (British Pharmacopoeia 1867 / Savory 1865), 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 267, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 651.",
        "@language": "en"
      },
      "oe:dictionarySource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n267"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n651"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        }
      ]
    },
