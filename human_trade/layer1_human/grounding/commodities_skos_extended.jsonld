        "@id": "htc:sub/sub_woven_fabr_wd_q169031/#concept"
      },
      "oe:observationCount/#resource": 11,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Gloves",
      "oe:processingState/#resource": "manufactured",
      "oe:ghostAcresDomain/#resource": "manufactured_goods",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "industrial_manufactured",
      "oe:harvestMode/#resource": "manufacture",
      "oe:theodoridisBucket/#resource": "manufactured_articles",
      "oe:sitcCode/#resource": "SITC4_65_84_85_Textiles_Apparel_Footwear",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(Ger. handschuhe; Fr. gants; Ital. guanti; Span. guantes; Russ. rukawizii, pertschatki, golizii). Well-known articles of dress used for covering the hands, usually made of leather, but frequently also of cotton, wool, silk &c. The leather used in the manufacture of gloves is not, properly speaking, tanned, but prepared by a peculiar process that renders it soft and pliable. Some sorts of leather gloves admit of being washed, and others not. Woodstock and Worcester, but particularly the former, are celebrated for the manufacture of leather gloves of a superior quality, in which a great number of women and girls, as well as men, are employed. Besides Worcester and Woodstock, London, Yeovil, Ludlow, and Leominster are the principal seats of the leather glove manufacture. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 737]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n737"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n467"
        }
      ],
      "oe:firstAttested/#resource": 1856,
      "oe:lastAttested/#resource": 1881,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_annual_statement_of_trade/#resource"
        }
      ],
