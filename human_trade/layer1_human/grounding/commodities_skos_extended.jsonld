    {
      "@id": "htc:02/0264/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Wax",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0264",
      "skos:prefLabel": {
        "@value": "Wax",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:sub/sub_waxes_soap_wd_q124695/#concept"
      },
      "oe:observationCount/#resource": 145,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Wax",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "fats_oils_soap",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_55_Oils_Perfumes_Cleansing",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "(_Cire_, Fr.; _Wachs_, Germ.); is the substance which forms the cells of bees. It was long supposed to be derived from the pollen of plants, swallowed by these insects, and merely voided under this new form; but it has been proved by the experiments, first of Mr. Hunter, and more especially of M. Huber, to be the peculiar secretion of a certain organ, which forms a part of the small sacs, situated on the sides of the median line of the abdomen of the bee. On raising the lower segments of the abdomen, these sacs may be observed, as also scales or spangles of wax, arranged in pairs upon each segment. There are none, however, under the rings of the males and the queen. Each individual has only eight wax sacs, or pouches; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n420"
        }
      ],
      "oe:firstAttested/#resource": 1871,
      "oe:lastAttested/#resource": 1906,
