      "skos:definition": {
        "@value": "**KALO**, *Colocasia antiquorum* var. *esculenta*, an edible root of the Pacific Isles. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 511]",
        "@language": "en"
      },
