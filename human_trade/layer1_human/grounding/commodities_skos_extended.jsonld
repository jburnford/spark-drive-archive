      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the *Sambucus nigra*, a tree common in Britain and the South of Europe. The wood, which is remarkable for its hardness, is often used for carpenters' rules, weavers' shuttles, meat-skewers, &c. The light pith of the branches is used for electrical purposes. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 151]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 151.",
