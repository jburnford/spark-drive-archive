      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "the common name for a genus of plants which have stimulant and aromatic qualities. The true valerian (*Valeriana officinalis*), is a remarkable feline stimulant. All the species have some medicinal properties. *V. celtica* is largely employed as a substitute for spikenard (*Nardostachys Jatamansi*) by Eastern nations. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 409]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 409, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 975.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n409"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n975"
        }
      ],
