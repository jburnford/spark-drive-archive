      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a pubescent down covering the capsules of *Mallotus philipensis*, used medicinally, and for dyeing orange. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 476]",
        "@language": "en"
