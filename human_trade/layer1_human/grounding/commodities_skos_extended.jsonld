      },
      "oe:observationCount/#resource": 92,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Quicksilver",
      "oe:processingState/#resource": "smelted_semi",
      "oe:ghostAcresDomain/#resource": "minerals_metals_energy",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_67_68_Metals",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "mercury",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "the commercial name for mercury: our imports average $2\\frac{1}{2}$ to 3 $\\frac{1}{2}$ million pounds a year, chiefly from California and Spain. Alloyed with tin-foil, quicksilver forms the reflecting surface of looking-glasses, and by its ready solution of gold or silver, and subsequent dissipation by a moderate heat, it becomes the great instrument in the arts of gilding and silvering copper and brass. The same property makes it so available in extracting these precious metals from their ores. It is also the basis of many very powerful medicines. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 322]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n322"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n841"
        }
      ],
      "oe:firstAttested/#resource": 1800,
      "oe:lastAttested/#resource": 1906,
