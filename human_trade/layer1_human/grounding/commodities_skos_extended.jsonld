    {
      "@id": "htc:doc/doc_nitrate_of_strontia/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Nitrate of Strontia",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "doc_nitrate_of_strontia",
      "skos:prefLabel": {
        "@value": "Nitrate of Strontia",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_industrial_chemicals_alkalis/#concept"
      },
      "oe:attestationBasis/#resource": "document_attested",
      "oe:subsumedInCustomsHeading/#resource": {
        "@id": "htc:05/0506/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:landBasis/#resource": "mineral",
      "oe:harvestMode/#resource": "mineral_extraction",
      "oe:sitcCode/#resource": "SITC4_51_52_Chemicals",
      "skos:definition": {
        "@value": "(_Nitrate de strontiane_, Fr.; _Salpetersaurer strontian_, Germ.) This salt is usually prepared from the sulphuret of strontium, obtained by decomposing sulphate of strontia with charcoal, by strong ignition of the mixed powders in a crucible. This sulphuret being treated with water, and the solution being filtered, is to be neutralized with nitric acid, as indicated by the test of turmeric paper; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 272.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n272"
        }
      ]
    },
