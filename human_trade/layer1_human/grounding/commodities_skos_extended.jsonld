      "oe:observationCount/#resource": 481,
      "oe:groundingStatus/#resource": "grounded_wikidata_v4",
      "oe:substanceHead/#resource": "Meal",
      "oe:processingState/#resource": "milled_ground",
      "oe:ghostAcresDomain/#resource": "food_grain",
