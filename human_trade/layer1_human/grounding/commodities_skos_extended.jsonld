    {
      "@id": "htc:06/0609/#concept",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "rdfs:label": {
        "@value": "Elephants Teeth",
        "@language": "en"
      },
      "skos:inScheme": {
        "@id": "htc:scheme/#resource"
      },
      "skos:notation": "0609",
      "skos:prefLabel": {
        "@value": "Elephants Teeth",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "htc:grp/grp_fertilizers_animal_materials/#concept"
      },
      "oe:observationCount/#resource": 58,
      "oe:groundingStatus/#resource": "local_concept_only",
      "oe:substanceHead/#resource": "Elephants Teeth",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_wild_hunted",
      "oe:harvestMode/#resource": "wild_hunted_fished",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_29_Crude_Animal_Vegetable_Materials",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "elephant ivory",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "The name given to the teeth or tusks of the elephant, and of the walrus or sea-horse. Each male elephant come to maturity has 2 tusks. These are hollow at the root, tapering, and of various sizes, depending principally on the age of the animal. Colour externally yellowish, brownish, and sometimes dark, internally white. The best are large, straight, and light-coloured, without flaws; not very hollow in the stump, but solid and thick. The most esteemed come from Africa, being of a closer texture, and less liable to turn yellow, than those from the East Indies. The trade in London thus divide them:— First sort, weighing 70 lbs. or upwards; second sort, weighing 56 lbs. to 60 lbs.; [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 883]",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — definition use: Previous text was only a cross-reference ('See IVORY').",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n883"
        },
        {
          "@id": "https://archive.org/details/generalcommercia00mort/page/n285"
        }
      ],
      "oe:firstAttested/#resource": 1800,
      "oe:lastAttested/#resource": 1847,
      "prov:hadPrimarySource": [
        {
          "@id": "oe:series_hcpp_other/#resource"
        },
        {
          "@id": "oe:series_kew_cust_5/#resource"
        },
        {
          "@id": "oe:series_kew_cust_4/#resource"
        }
      ]
    },
