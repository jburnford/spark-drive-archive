      "oe:groundingStatus/#resource": "local_concept_only",
      "oe:substanceHead/#resource": "Senna",
      "oe:processingState/#resource": "unspecified",
      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_crop",
      "oe:harvestMode/#resource": "cultivated",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_54_Medicinal_Pharmaceutical",
      "oe:isAggregate/#resource": false,
      "skos:definition": {
        "@value": "the leaflets of several species of *Cassia*, used in medicine for their purgative properties. *C. elongata* and *C. acutifolia*, furnish the Timnevelly and Alexandrian senna, which are the best. The latter constitutes the bulk of the imports into Europe. It is much adulterated with the leaves of *Cynanchum Argel*, *Tephrosia Apollinea*, and *Coriaria myrtifolia*. Our imports average about 150,000 lbs, although they are often much larger. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 348]",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n348"
        },
        {
          "@id": "https://www.gutenberg.org/ebooks/15191"
        },
        {
          "@id": "https://archive.org/details/dictionaryprac00mccu/page/n1352"
        }
      ],
      "oe:firstAttested/#resource": 1800,
      "oe:lastAttested/#resource": 1866,
      "prov:hadPrimarySource": [
