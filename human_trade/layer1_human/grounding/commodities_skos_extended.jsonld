      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "(_Fard_, Fr.) The only cosmetic which can be applied without injury to brighten a lady’s complexion, is that prepared, by the following process, from safflower (_Carthamus tinctorius_). The flowers, after being washed with pure water till it comes off colourless, are dried, pulverized, and digested with a weak solution of crystals of soda, which assumes thereby a yellow colour. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 334.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://www.gutenberg.org/ebooks/44562"
        },
        {
          "@id": "https://archive.org/details/b21780535/page/n334"
        }
      ],
      "oe:sourceTaxon/#resource": [
        {
          "@id": "http://www.wikidata.org/entity/Q156625"
        }
      ]
    },
