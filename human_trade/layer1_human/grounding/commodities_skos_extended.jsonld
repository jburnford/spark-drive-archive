      "skos:altLabel": [
        {
          "@value": "Sesamum Indicum",
          "@language": "en"
        },
        {
          "@value": "Sesamum Seed",
          "@language": "en"
        },
        {
          "@value": "Teel Seed",
          "@language": "en"
        },
        {
          "@value": "Wangala",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "a plant, the *Sesamum orientale*, universally cultivated in the East Indies for the oil expressed from its seeds. We imported, in 1855, 652 quarters of sesame seed. In 1856, 22,790 cwt. of this seed were shipped from Madras alone, besides 2214 cwt. of oil. It is there called Gingely or Gingelle, and the seed is also known in commerce under its vernacular name of teel and til. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 349]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 349, P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854, Project Gutenberg #15191).",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
