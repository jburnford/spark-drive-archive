      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "an instrument for stamping holes; a shape for cutting pastebboard wads for guns; a stone cutter's tool for chipping; a die for making printing-type; a well-known metropolitan weekly humorous publication; an iron lever; a puppet show; a strong mixed beverage made of spirits, wine, water, sugar, lemon, and other flavouring ingredients. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 318]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated (incl. Condiments & Minor Foods)). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 318, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 820.",
        "@language": "en"
      },
      "oe:dictionarySource": [
