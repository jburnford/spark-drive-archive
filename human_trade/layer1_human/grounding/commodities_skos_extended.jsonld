        "@id": "htc:04/0408/#concept"
      },
      "oe:groundingStatus/#resource": "document_attested_local",
      "oe:ghostAcresDomain/#resource": "food_colonial_grocery",
      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "a name for the rind of the pomegranate fruit, which is used in medicine, and in dyeing, on account of its astringency. It is also said to be employed for tanning Morocco leather. The bark of the root is emetic and purgative, and administered for worms. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307.",
        "@language": "en"
      },
      "oe:dictionarySource/#resource": [
        {
          "@id": "https://archive.org/details/b21780535/page/n307"
        }
      ]
    },
    {
