      "oe:landBasis/#resource": "unclassified",
      "oe:harvestMode/#resource": "unclassified",
      "oe:sitcCode/#resource": "oe:sitcUnassigned",
      "skos:definition": {
        "@value": "(GER. *Acaciensaft*. FR. *Suc d'acacia*. IT. *Acacia*. SP. *Acacia verdadera*, *o'de Levante*. PORT. *Acacia*. LAT. *Acacia succus*.) Egyptian thorn, a species of *Mimosæ*, from which the Chinese make that yellow which we see bears washing in their silks and stuffs, and appears with so much elegance in their painting on paper. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 12]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0041 (Bark For Tanners and Dyers Use). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 12, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 14.",
        "@language": "en"
      },
