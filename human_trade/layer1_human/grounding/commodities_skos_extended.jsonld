      "oe:landBasis": "unclassified",
      "oe:sitcCode": "oe:sitcUnassigned",
      "skos:altLabel": [
        {
          "@value": "bitter tree",
          "@language": "en"
        },
        {
          "@value": "bitter wood",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Quassia wood is used to form extracts, infusions, and tinctures. It was classified as a tonic in the Compendium, and was often given to treat green sickness or other uterine ailments. Other uses included treating those suffering from gout, and aiding the digestion of sedentary people. Combining quassia and sugar created a poison for flies. [Danika Drugs Project: British Pharmacopoeia (1867) / Savory (1865)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Danika Drugs.xlsx (British Pharmacopoeia 1867 / Savory 1865), Danika Drugs.xlsx (SKOS Sheet), 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 321, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562).",
        "@language": "en"
      },
      "oe:dictionarySource": [
