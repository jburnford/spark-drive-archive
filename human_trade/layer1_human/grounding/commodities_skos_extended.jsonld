      "oe:ghostAcresDomain/#resource": "drugs_botanicals_chemicals",
      "oe:attestationBasis/#resource": "customs_enumerated",
      "oe:landBasis/#resource": "terrestrial_forest",
      "oe:harvestMode/#resource": "forest_harvest",
      "oe:theodoridisBucket/#resource": "raw_materials",
      "oe:sitcCode/#resource": "SITC4_23_Crude_Rubber",
      "oe:isAggregate/#resource": false,
      "skos:altLabel": [
        {
          "@value": "rubber",
          "@language": "en"
        },
        {
          "@value": "natural rubber",
          "@language": "en"
        },
        {
          "@value": "gum-elastic",
          "@language": "en"
        },
        {
          "@value": "indian-rubber",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "occurs as a milky juice in several plants, such as the _siphonia cahuca_, called also _hevea guianensis_, _cautschuc_, _jatropha elastica_, _castilleja elastica_, _cecropia pellata_, _ficus religiosa_ and _indica_, _urceolaria elastica_, &c. It is, however, extracted chiefly from the first plant, which grows in South America and Java. The tree has incisions made into it through the bark in many places, and it discharges the milky juice, which is spread upon clay moulds, and dried in the sun, or with the smoke of a fire, which blackens it. The juice itself has been of late years imported. It is of a pale yellow colour, and has the consistence of cream. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "19th-century trade appellation for natural rubber latex (Hevea spp.); historically grouped with allied tropical latexes such as Gutta Percha.",
        "@language": "en"
      },
      "skos:editorialNote": [
        {
          "@value": "Curated fields — source_taxon remove: Incidental mention in Ure's list; not a rubber source.",
          "@language": "en"
        }
      ],
      "oe:dictionarySource/#resource": [
