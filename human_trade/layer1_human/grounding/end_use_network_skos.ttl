<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1115__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 58" ;
    dcterms:source <https://archive.org/details/b21780535/page/n58> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Borax used in Metallurgy, Smelting, Brass & Tinplate: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 58"@en ;
    <ontology/quoteText/#resource> "BORAX: the bibrate of soda. This salt is largely imported from India under the name of thical, and after purification forms the refined borix of commerce. It is chiefly used as a flux for metals, and a constituent of the glazes for porcelain."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1115__q2/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 170" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n170> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Borax used in Metallurgy, Smelting, Brass & Tinplate: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 170"@en ;
    <ontology/quoteText/#resource> "BORAX: (GER. DA. SW. FR. and LAT. Borax. DU. Boras. IT. Borrace, Boraso. SP. and PORT. Borrax. RUS. Bura, Borakss. POL. Boraks.) is used as a flux for metals, and enters into the composition of some of the coloured glass pastes made in imitation of gems; but its greatest use is to facilitate the soldering of the more precious metals. It is employed also as a..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1115__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BONE BLACK" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Borax used in Metallurgy, Smelting, Brass & Tinplate: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BONE BLACK"@en ;
    <ontology/quoteText/#resource> "Payen describes an octahedral borax, which contains only 30·64 per cent. of water, and is therefore preferred by the braziers in their soldering processes."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1248/#resource> a <ontology/EndUseAssertion/#resource> ;
    rdfs:label "Charcoal used in Metallurgy, Smelting, Brass & Tinplate"@en ;
    <ontology/assertsCommodity/#resource> <id/12/1248/#concept> ;
    <ontology/assertsIndustry/#resource> <ontology/ind_metallurgy_tinplate/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1248__q1/#resource>, <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1248__q2/#resource>, <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1248__q3/#resource> ;
    <ontology/productionRole/#resource> "solvent_or_fuel" ;
