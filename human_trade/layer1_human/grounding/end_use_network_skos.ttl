    rdfs:label "Evidence for Copperas used in Leather Tanning, Tawing & Currying: McCulloch (1880), Dictionary of Commerce, scan p. 59"@en ;
    oe:quoteText "The bark is sometimes used for tanning, and by the addition of copperas and other ingredients forms a dye for several colours."@en ;
    dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 59" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n59/mode/1up> ;
    oe:retrievalMode "direct_sentence" .

