<ontology/use_glass_ceramics/use_glass_ceramics__1683__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. T, T" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Painters Colours and Pigments White Lead used in Glassmaking, Pottery & Porcelain: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. T, T"@en ;
    <ontology/quoteText/#resource> "The glaze for the second composition is formed of 8 parts of flint glass, 36 of felspar, 40 of white lead, and 20 of silex (ground flints)."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__1683__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 790" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n790/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
