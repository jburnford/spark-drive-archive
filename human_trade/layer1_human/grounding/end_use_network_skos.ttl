    <ontology/hasEvidence/#resource> <ontology/use_soap_manufacture/use_soap_manufacture__0136__q1/#resource>, <ontology/use_soap_manufacture/use_soap_manufacture__0136__q2/#resource>, <ontology/use_soap_manufacture/use_soap_manufacture__0136__q3/#resource> ;
    <ontology/productionRole/#resource> "alkali_or_reagent" ;
    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_soap_manufacture/use_soap_manufacture__0136__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 310" ;
    dcterms:source <https://archive.org/details/b21780535/page/n310> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Pearl and Pot Ashes used in Soap Manufacture: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 310"@en ;
    <ontology/quoteText/#resource> "POTASH: such constituents of burned vegetables as are very soluble in water, and fixed in the fire; the lixivium of the ashes of wood fuel evaporated in iron pots. These ashes are principally used in the manufacture of flint glass, pumice of potash, and soft soap. The imports of pot and pearl ash range from 4000 to 9000 tons a-year."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0136__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. N P" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Pearl and Pot Ashes used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. N P"@en ;
    <ontology/quoteText/#resource> "It is generally supposed that putrid urine acts on the wool by the ammonia which it contains, and that this serves to saponify the remainder of the fatty matter not combined with the potash."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0136__q3/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section THE OIL PALM" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Pearl and Pot Ashes used in Soap Manufacture: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section THE OIL PALM"@en ;
    <ontology/quoteText/#resource> "Spanish or Castile soap is made by mixing olive oil and soda, while soft soap is made by mixing the oil with potash."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0172/#resource> a <ontology/EndUseAssertion/#resource> ;
