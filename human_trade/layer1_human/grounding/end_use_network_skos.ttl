<ontology/use_calico_printing/use_calico_printing__1692__q1/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 45" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n45/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Chemical Manufactures Acetic Acid used in Calico Cloth & Calico Printing: McCulloch (1880), Dictionary of Commerce, scan p. 45"@en ;
    <ontology/quoteText/#resource> "The greater portion of the pyroligneous acid prepared in this country is employed in the manufacture of the acetates, particularly acetate of lead for the use of dyers and calico printers, and only a small portion is purified for household and other purposes."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1692__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Chemical Manufactures Acetic Acid used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F"@en ;
    <ontology/quoteText/#resource> "The cloth ought to be introduced into it in a distended state; because the acetic acid may accumulate in the foldings, and dissolve out the earthy or metallic base of the mordant, causing white and gray spots in such parts of the printed goods."@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

<ontology/use_calico_printing/use_calico_printing__1825/#resource> a <ontology/EndUseAssertion/#resource> ;
