    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Orchal used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. VIOLET DYE"@en ;
    <ontology/quoteText/#resource> "Silk is dyed a fugitive violet with either archil or brazil wood; but a fine fast violet, first by a crimson with cochineal, without tartar or tin mordant, and after washing, it is dipped in the indigo vat."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__0471__q3/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section SAFFLOWER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Orchal used in Woollen, Silk & Worsted Dyeing: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section SAFFLOWER"@en ;
    <ontology/quoteText/#resource> "Various species of Lecanora, particularly L. tartarea, known as cudbear, are used in dyeing woollen yarn."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

