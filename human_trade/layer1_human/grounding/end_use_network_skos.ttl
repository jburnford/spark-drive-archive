<ontology/ind_chocolate_confectionery/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Chocolate & Confectionery"@en ;
    skos:definition "Chocolate bars, drinking chocolate, cocoa butter, and sugar confectionery — combining roasted cacao beans with cane sugar, aromatic spices (vanilla, cinnamon, cloves, cassia), gums, almonds, starches, and milk."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Chocolate & Confectionery"@en ;
