    <ontology/quoteText/#resource> "COPPERAS: (GER. Grüner Vitriol, Elsenvitriol, Kupferwasser. DU. Groene vitriool, Yservitriool, Koperrood, Koperwater. DA. Grøn vitriol, Jernvitriol, Engelskt vitriol, Grønt Kobber. SW. Grön vitriol, Jernvitriol. FR. Vitriol verd, martial ou cuperose. Vitriol de fer, couperose verte. IT. Vitriuolo di marte. SR. Vitriolo de marte. PORT. Vitriolo de marte. RUS...."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__2002__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 59" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n59/mode/1up> ;
