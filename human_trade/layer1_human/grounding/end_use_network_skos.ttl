<ontology/use_calico_printing/use_calico_printing__1322__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 53" ;
    dcterms:source <https://archive.org/details/b21780535/page/n53> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bleaching Materials used in Calico Cloth & Calico Printing: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 53"@en ;
    <ontology/quoteText/#resource> "BLEACHING POWDER: chloride of lime, made by exposing slaked lime to the action of chlorine, which is used for bleaching linens, calicoes, and paper materials: many thousand tons of it are made annually in the kingdom."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1322__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CHLORINE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bleaching Materials used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CHLORINE"@en ;
    <ontology/quoteText/#resource> "In the discharge troughs where printed calicoes are passed through strong solutions of chloride of lime, stalactitic crusts of carbonate of lime come to be formed in this way."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1322__q3/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 724" ;
    dcterms:source <https://archive.org/details/b31361584/page/n724/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bleaching Materials used in Calico Cloth & Calico Printing: Watt (1908), Commercial Products of India, scan p. 724"@en ;
    <ontology/quoteText/#resource> "As a bleaching reagent chloride of lime is extensively employed, such, for example, as in the raising of metallic colours, in discharging Turkey reds, and in calico-printing, etc. In India lime is made into a resist paste with ordinary gum-arabic, and in that form is utilised by the calico-printer."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1375/#resource> a <ontology/EndUseAssertion/#resource> ;
