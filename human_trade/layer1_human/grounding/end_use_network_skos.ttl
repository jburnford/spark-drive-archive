<ontology/use_chocolate_confectionery/use_chocolate_confectionery__0360__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 39" ;
    dcterms:source <https://archive.org/details/b21780535/page/n39> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sugar used in Chocolate & Confectionery: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 39"@en ;
    <ontology/quoteText/#resource> "BARLEY SUGAR: a sweetmeat consisting of sugar boiled until it becomes brittle, and run into lumps or sticks. It was at one time boiled with a decoction of barley, whence the name. See SUGAR CANDY."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_chocolate_confectionery/use_chocolate_confectionery__0360__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CHLORINE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sugar used in Chocolate & Confectionery: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CHLORINE"@en ;
    <ontology/quoteText/#resource> "The chocolate paste has usually in France a little vanilla incorporated with it, and a considerable quantity of sugar, which varies from one third of its weight to equal parts."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_chocolate_confectionery/use_chocolate_confectionery__0360__q3/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 17" ;
    dcterms:source <https://archive.org/details/b31361584/page/n17/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sugar used in Chocolate & Confectionery: Watt (1908), Commercial Products of India, scan p. 17"@en ;
    <ontology/quoteText/#resource> "It is, however, unquestionably edible, and fried with ghi, sugar and spices, is employed in the preparation of certain Native sweetmeats which are very generally eaten after child-birth."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

