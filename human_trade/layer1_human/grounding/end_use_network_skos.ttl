oe:use_calico_printing__0302__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Madder used in Calico Cloth & Calico Printing: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 248"@en ;
    oe:quoteText "MADDER: the root of Rubia tinctoria, which enters largely into commerce, furnishing a fine scarlet colour to dyers and calico-printers."@en ;
    dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 248" ;
    dcterms:source <https://archive.org/details/b21780535/page/n248> ;
