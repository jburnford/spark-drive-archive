<ontology/ind_leather_tanning/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Leather Tanning, Tawing & Currying"@en ;
    skos:definition "Tanning, tawing, and currying raw ox/calf/sheep/goat hides into sole, harness, morocco, Russia, and chamois leather — using oak, hemlock, and mimosa barks, valonia, sumach, cutch, myrabolans, divi-divi, lime, alum, salt, tallow, and fish/train oils."@en ;
