oe:use_woollen_silk_dyeing__0172__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Olive Oil used in Woollen, Silk & Worsted Dyeing: Mortimer (1823), General Commercial Dictionary, scan p. 686"@en ;
    oe:quoteText "Gallipoli, a sea-port town in the province of Otranto, is the place in the kingdom of Naples from which the greatest quantity of olive-oil, and the best quality for the use of the British woollen manufactures is exported."@en ;
    dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 686" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n686/mode/1up> ;
    oe:retrievalMode "direct_sentence" .

