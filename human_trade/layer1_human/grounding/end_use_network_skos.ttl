    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Berries Yellow used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F"@en ;
    <ontology/quoteText/#resource> "Thus, for Yellow.--Take 1 gallon of a decoction, made with 4 libs. of Persian berries: dissolve in it 8 ounces of salt of tin (muriate), and 4 ounces of the nitro-muriatic solution of tin."@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

<ontology/use_calico_printing/use_calico_printing__1304/#resource> a <ontology/EndUseAssertion/#resource> ;
