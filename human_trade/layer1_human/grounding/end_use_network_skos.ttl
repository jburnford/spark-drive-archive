<ontology/use_calico_printing/use_calico_printing__1825__q1/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 71" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n71/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Arsenic used in Calico Cloth & Calico Printing: Mortimer (1823), General Commercial Dictionary, scan p. 71"@en ;
    <ontology/quoteText/#resource> "Sulphuret of arsenic is much used in calico-printing, on account of its property of de-oxidizing indigo, and thus rendering it soluble in an alkaline solution."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1825__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 83" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n83/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Arsenic used in Calico Cloth & Calico Printing: McCulloch (1880), Dictionary of Commerce, scan p. 83"@en ;
    <ontology/quoteText/#resource> "It is obtained tolerably pure as an intermediate product in the manufacture of carbonate of soda from cryolite. Stannate of Soda.—It is extensively used in dyeing and calico printing: it is prepared in a great variety of ways, generally by fusing tin or tin-ore with soda or a salt of soda. Arsenate of Soda.—This is used largely in calico printing 'dunging li..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1825__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Arsenic used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F"@en ;
    <ontology/quoteText/#resource> "They are now to be passed through water, containing from half an ounce to an ounce of white arsenic per piece; 4 turns are sufficient; if it be too long immersed, it will take a yellow tint."@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

<ontology/use_calico_printing/use_calico_printing__1899/#resource> a <ontology/EndUseAssertion/#resource> ;
