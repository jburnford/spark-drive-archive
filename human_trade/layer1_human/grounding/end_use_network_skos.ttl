    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Madder used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F"@en ;
    <ontology/quoteText/#resource> "The madder style, to which the best chintzes belong, in which the mordants are applied to the white cloth with many precautions, and the colours are afterwards brought up in the dye-bath."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__0302__q3/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section MADDER" ;
