<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_nitric_acid__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TIN MORDANTS" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Nitric acid used in Metallurgy, Smelting, Brass & Tinplate: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TIN MORDANTS"@en ;
    <ontology/quoteText/#resource> "Place the tin-plate, slightly heated, over a tub of water, and rub its surface with a sponge dipped in a liquor composed of four parts of aquafortis, and two of distilled water, holding one part of common salt or sal ammoniac in solution."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_nitric_acid__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 883" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n883/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Nitric acid used in Metallurgy, Smelting, Brass & Tinplate: Mortimer (1823), General Commercial Dictionary, scan p. 883"@en ;
    <ontology/quoteText/#resource> "LAT. Sal ammoniacum.) See AMMONIA. SAL PRUNELLA. This name is given to a salt composed of nitric acid, and potash; it may be obtained from common nitre, by fusing it in a crucible, so as to deprive it of some of its water, and nitric acid."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

