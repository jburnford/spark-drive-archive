    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_sal_ammoniac__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 338" ;
    dcterms:source <https://archive.org/details/b21780535/page/n338> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sal Ammoniac used in Metallurgy, Smelting, Brass & Tinplate: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 338"@en ;
    <ontology/quoteText/#resource> "SAL AMMONIAC: the hydrochlorate of ammonia, obtained by saturating the ammoniacal liquor of gas-works with muriatic acid, and afterwards sublimating it. It has many commercial uses; as for medicine, metallurgic operations, thinning and soldering, &c."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_sal_ammoniac__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TIN MORDANTS" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sal Ammoniac used in Metallurgy, Smelting, Brass & Tinplate: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TIN MORDANTS"@en ;
