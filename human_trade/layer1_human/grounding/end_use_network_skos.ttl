<ontology/use_soap_manufacture/use_soap_manufacture__2002__q1/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 936" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n936/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Copperas used in Soap Manufacture: Mortimer (1823), General Commercial Dictionary, scan p. 936"@en ;
    <ontology/quoteText/#resource> "The process above described is that followed in the manufacture of hard soap; in making soft soap, potash is substituted for the soda; the rest of the process is precisely the same as that of which we have been treating. Mottled soap obtains its speckled appearance by dispersing the ley, towards the end of the operation, through the soap, or by adding to it ..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__2002__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Copperas used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP"@en ;
    <ontology/quoteText/#resource> "In France a small quantity of solution of sulphate of iron is added during the boiling of the soap, or rather with the first service of the lyes."@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

