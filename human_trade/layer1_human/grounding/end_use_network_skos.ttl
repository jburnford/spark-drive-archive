<ontology/use_chocolate_confectionery/use_chocolate_confectionery__0097__q1/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 941" ;
    dcterms:source <https://archive.org/details/b31361584/page/n941/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Honey used in Chocolate & Confectionery: Watt (1908), Commercial Products of India, scan p. 941"@en ;
    <ontology/quoteText/#resource> "Honey is largely traded in all over India. Halwa (a sweetmeat, much like \"Turkish-delight\") is said to be prepared from camel's milk and honey, and is brought into India from Afghanistan and ports on the Persian Gulf."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

