<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__0118__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BRAZIL-WOOD" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cochineal used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BRAZIL-WOOD"@en ;
    <ontology/quoteText/#resource> "Brazil-wood is made use of for dyeing silk what is called false crimson, to distinguish it from the crimson made by means of cochineal, which is much more permanent."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__0118__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 361" ;
    dcterms:source <https://archive.org/details/b31361584/page/n361/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cochineal used in Woollen, Silk & Worsted Dyeing: Watt (1908), Commercial Products of India, scan p. 361"@en ;
    <ontology/quoteText/#resource> "Grades. USES AND COMMERCIAL FORMS OF COCHINEAL.—Cochineal was formerly much employed in dyeing wool, silk, and cotton: to-day it is a colour-ingredient of drugs and confectionery, and an artists' pigment."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__0118__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 283" ;
