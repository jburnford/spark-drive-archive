<ontology/use_soap_manufacture/use_soap_manufacture__0257__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 88" ;
    dcterms:source <https://archive.org/details/b21780535/page/n88> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Salt used in Soap Manufacture: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 88"@en ;
    <ontology/quoteText/#resource> "CAT-SALT: a granulated coarse salt formed from the bitter or lencb bruc, used in the manufacture of hard soap."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0257__q2/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 209" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n209> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Salt used in Soap Manufacture: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 209"@en ;
    <ontology/quoteText/#resource> "CAT-SALT: a name given by our salt-workers, to a very beautifully granulated kind of common salt. It is formed out of the bitter or leach-brine, which runs from the salt when taken out of the pan. When the common salt is taken from the boiling-pans, it is put into long wooden troughs, with holes bored at the bottom, for the brine to drain out: under these tr..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0257__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Salt used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP"@en ;
    <ontology/quoteText/#resource> "The soda-ash used by the soap-boiler, contains in general about 36 per cent. of real soda, in the state of dry carbonate, mixed with muriate of soda, and more or less undecomposed sulphate."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

