<ontology/use_candle_manufacture/use_candle_manufacture__0129__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 45" ;
    dcterms:source <https://archive.org/details/b21780535/page/n45> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bees Wax used in Candle Manufacture: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 45"@en ;
    <ontology/quoteText/#resource> "BEES-WAX: the wax-comb after the honey is removed, which is used for making candles, sealing-wax, polishing furniture, &c. We import quantities from India, Africa, and other parts of the world. Two kinds occur in commerce, the yellow and the white or bleached."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_candle_manufacture/use_candle_manufacture__0386/#resource> a <ontology/EndUseAssertion/#resource> ;
    rdfs:label "Train Blubber and Spermaceti (Whale Oils) used in Candle Manufacture"@en ;
    <ontology/assertsCommodity/#resource> <id/03/0386/#concept> ;
    <ontology/assertsIndustry/#resource> <ontology/ind_candle_manufacture/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_candle_manufacture/use_candle_manufacture__0386__q1/#resource>, <ontology/use_candle_manufacture/use_candle_manufacture__0386__q2/#resource> ;
    <ontology/productionRole/#resource> "primary_feedstock" ;
    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_candle_manufacture/use_candle_manufacture__0386__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 366" ;
    dcterms:source <https://archive.org/details/b21780535/page/n366> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Train Blubber and Spermaceti (Whale Oils) used in Candle Manufacture: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 366"@en ;
    <ontology/quoteText/#resource> "SPERMACETI: a kind of waxy body which separates in cold weather from the oil obtained from the head-matter of the sperm whale (Physeter macrocephalus). It is used for making candles with about 3 per cent. of bees'-wax added to prevent crystallization."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_candle_manufacture/use_candle_manufacture__0386__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 939" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n939/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Train Blubber and Spermaceti (Whale Oils) used in Candle Manufacture: Mortimer (1823), General Commercial Dictionary, scan p. 939"@en ;
    <ontology/quoteText/#resource> "Beside the use of spermaceti in medicine, it is employed for making candles, which are of a beautiful colour, and appear to be a medium between wax, and tallow, with respect to the advantages derived from a slender wick. SPICES. (GER. Spezereyen."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

