<ontology/use_pharmaceuticals/use_pharmaceuticals__0951__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 322" ;
    dcterms:source <https://archive.org/details/b21780535/page/n322> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Quinine Sulphate of used in Pharmaceuticals & Druggists' Preparations: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 322"@en ;
    <ontology/quoteText/#resource> "QUININE: a valuable alkaloid, extracted from Cinchona bark, and used as a stimulant and tonic in intermittents. The sulphate of quinine is used to a great extent in medicine, for a medicinal wine, and in other forms."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__0951__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 316" ;
    dcterms:source <https://archive.org/details/b31361584/page/n316/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Quinine Sulphate of used in Pharmaceuticals & Druggists' Preparations: Watt (1908), Commercial Products of India, scan p. 316"@en ;
    <ontology/quoteText/#resource> "It was raised in Paris in 1851 and one plant was presented to the Dutch, by whom it was successfully conveyed to Java ; and in 1873 Dr. van Gorkum reported that it was the chief form grown in Java—its most important alkaloid being QUININE."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

