oe:use_leather_tanning__0041__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Bark For Tanners and Dyers Use used in Leather Tanning, Tawing & Currying: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER"@en ;
    oe:quoteText "Danish leather is made by tanning lamb and kid skins with willow bark, whence it derives an agreeable smell."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
