    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bichromate of Potash used in Calico Cloth & Calico Printing: McCulloch (1880), Dictionary of Commerce, scan p. 84"@en ;
    <ontology/quoteText/#resource> "Bichromate of potash is extensively used in dyeing and calico-printing, in preparing pigments, and in bleaching tallow, palm oil, &c."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

