    dcterms:source <https://archive.org/details/b21780535/page/n378> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Brimstone used in Gunpowder, Explosives & Lucifer Matches: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 378"@en ;
    <ontology/quoteText/#resource> "SULPHUR: a simple inflammable body, of great importance in chemistry and the arts. It is found abundantly in depositions near volcanoes, and is also obtained by the roasting of pyrites. It is used extensively in the manufacture of gunpowder, and of sulphuric acid. We import annually about 75,000 tons."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_gunpowder_matches/use_gunpowder_matches__0430__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GUNPOWDER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Brimstone used in Gunpowder, Explosives & Lucifer Matches: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GUNPOWDER"@en ;
    <ontology/quoteText/#resource> "s much purer than the sulphur obtained by artificial heat from any varieties of pyrites, and may, therefore, by simple processes, be rendered a fit constituent of the best gunpowder."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_gunpowder_matches/use_gunpowder_matches__0430__q3/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 744" ;
