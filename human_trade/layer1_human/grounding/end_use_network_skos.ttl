<ontology/use_soap_manufacture/use_soap_manufacture__0780__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Barilla used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP"@en ;
    <ontology/quoteText/#resource> "The alkali in both states is employed in England; barilla being supposed by many to yield a finer white or curd soap, on account of its freedom from sulphur."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0780__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 370" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n370/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Barilla used in Soap Manufacture: Mortimer (1823), General Commercial Dictionary, scan p. 370"@en ;
    <ontology/quoteText/#resource> "The greatest quantity of oil is made in the kingdom of Valencia. Ashes.—There are three sorts of ashes made in Spain, namely, barilla, bourdina, 560 and aqua-azul; they are used in the manufacture of soap, glass, and crystal."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

