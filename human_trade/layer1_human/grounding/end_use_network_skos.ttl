    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tar used in Varnish, Paint & Lacquer: McCulloch (1880), Dictionary of Commerce, scan p. 212"@en ;
    <ontology/quoteText/#resource> "With certain vegetable oils, naphtha is said to form a good varnish.—2. Petroleum is much thicker than naphtha, resembling in consistence common tar."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

