    oe:hasEvidence oe:use_woollen_silk_dyeing__0677__q1 .

oe:use_woollen_silk_dyeing__0677__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Gum Lac, Seed, Shell, Stick, and Dye used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LAC, LAC-DYE"@en ;
    oe:quoteText "The cakes of lac-dye imported from India, stamped with peculiar marks to designate their different manufacturers, are now employed exclusively in England for dyeing scarlet cloth, and are found to yield an equally brilliant colour, and one less easily affected by perspiration than that produced by cochineal."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LAC, LAC-DYE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    oe:retrievalMode "direct_sentence" .

