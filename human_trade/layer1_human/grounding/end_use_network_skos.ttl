    rdfs:label "Evidence for Copperas used in Leather Tanning, Tawing & Currying: McCulloch (1880), Dictionary of Commerce, scan p. 59"@en ;
    <ontology/quoteText/#resource> "The bark is sometimes used for tanning, and by the addition of copperas and other ingredients forms a dye for several colours."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__2002__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Copperas used in Leather Tanning, Tawing & Currying: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER"@en ;
