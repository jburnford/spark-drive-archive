<ontology/use_calico_printing/use_calico_printing__0975__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SULPHATE OF MANGANESE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sulphuric Acid used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SULPHATE OF MANGANESE"@en ;
    <ontology/quoteText/#resource> "SULPHATE OF MANGANESE, is prepared on the great scale for the calico-printers, by exposing the peroxide of the metal and pitcoal ground together, and made into a paste with sulphuric acid, to a heat of 400° F."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__0975__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 19" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n19/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sulphuric Acid used in Calico Cloth & Calico Printing: Mortimer (1823), General Commercial Dictionary, scan p. 19"@en ;
    <ontology/quoteText/#resource> "Sulphuric acid is much used by dyers and calico-printers, but is not often employed in other arts. Nitric Acid is composed of oxygen, and a peculiar substance termed nitrogen, or azote."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

