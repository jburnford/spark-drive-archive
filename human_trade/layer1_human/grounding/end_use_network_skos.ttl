    <ontology/assertsCommodity/#resource> <id/11/1115/#concept> ;
    <ontology/assertsIndustry/#resource> <ontology/ind_metallurgy_tinplate/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1115__q1/#resource>, <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1115__q2/#resource>, <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1115__q3/#resource> ;
