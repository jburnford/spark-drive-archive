oe:use_woollen_silk_dyeing__1304__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Bark Quercitron used in Woollen, Silk & Worsted Dyeing: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 321"@en ;
    oe:quoteText "QUERCITRON: a name for the black oak (Quercus tinctoria) of the United States, the wood of which is valuable for building, and for cutting into staves: the bark is used for tanning, while the cellular integument is extensively employed in dyeing wool, silk, and paper hangings, and forms an important article of export from Philadelphia."@en ;
    dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 321" ;
    dcterms:source <https://archive.org/details/b21780535/page/n321> ;
    oe:retrievalMode "direct_sentence" .

