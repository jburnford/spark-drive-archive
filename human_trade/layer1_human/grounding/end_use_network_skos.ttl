    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Alum Roach used in Paper Making & Cardboard: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. F, F, F, F"@en ;
