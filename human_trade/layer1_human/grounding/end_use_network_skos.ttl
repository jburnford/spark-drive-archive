<ontology/use_glass_ceramics/use_glass_ceramics__doc_china_clay__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 224" ;
    dcterms:source <https://archive.org/details/b21780535/page/n224> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for China Clay used in Glassmaking, Pottery & Porcelain: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 224"@en ;
    <ontology/quoteText/#resource> "KAOLIN: a porcelain earth derived from the decomposition of the feldspathic granites, and much used for fine pottery. This earth is met with in Assam, Bangalore, Madras, China, and other parts of Asia, whence the name is derived."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__doc_china_clay__q2/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 547" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n547> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for China Clay used in Glassmaking, Pottery & Porcelain: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 547"@en ;
    <ontology/quoteText/#resource> "KAOLIN: the name of an earth which is used as one of the two ingredients in oriental porcelain."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__doc_china_clay__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. KAOLIN" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for China Clay used in Glassmaking, Pottery & Porcelain: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. KAOLIN"@en ;
    <ontology/quoteText/#resource> "KAOLIN: is the name given by the Chinese to the fine white clay with which they fabricate the biscuit of their porcelains. See CLAY. Berthier’s analyses of two porcelain earths are as follows:--"@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

