    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Rosin used in Metallurgy, Smelting, Brass & Tinplate: Mortimer (1823), General Commercial Dictionary, scan p. 937"@en ;
    <ontology/quoteText/#resource> "In the soldering either of gold, silver, copper, or either of the metals above mentioned, there is generally used borax in powder, and sometimes rosin."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

