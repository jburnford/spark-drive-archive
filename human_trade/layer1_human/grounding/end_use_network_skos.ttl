<ontology/use_calico_printing/use_calico_printing__0677__q1/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 893" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n893/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
