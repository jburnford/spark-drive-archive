<ontology/use_brewing_distilling/use_brewing_distilling__1701/#resource> a <ontology/EndUseAssertion/#resource> ;
    rdfs:label "Lignum Quassia used in Brewing, Malting & Distilling"@en ;
    <ontology/assertsCommodity/#resource> <id/17/1701/#concept> ;
    <ontology/assertsIndustry/#resource> <ontology/ind_brewing_distilling/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_brewing_distilling/use_brewing_distilling__1701__q1/#resource>, <ontology/use_brewing_distilling/use_brewing_distilling__1701__q2/#resource>, <ontology/use_brewing_distilling/use_brewing_distilling__1701__q3/#resource> ;
