<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1248__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TABLE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Charcoal used in Metallurgy, Smelting, Brass & Tinplate: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TABLE"@en ;
    <ontology/quoteText/#resource> "If not, fresh charcoal must be again applied, the crucible must be covered, and the heat increased, till fumes are no longer produced, and the surface of the silver becomes tranquil."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1248__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 1512" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n1512/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Charcoal used in Metallurgy, Smelting, Brass & Tinplate: McCulloch (1880), Dictionary of Commerce, scan p. 1512"@en ;
    <ontology/quoteText/#resource> "The ore so obtained is preserved in heaps, and smelted periodically with charcoal in a blast furnace."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1248__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 564" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n564/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Charcoal used in Metallurgy, Smelting, Brass & Tinplate: Mortimer (1823), General Commercial Dictionary, scan p. 564"@en ;
    <ontology/quoteText/#resource> "The genuine quality of red lead may be ascertained by the brightness of its colour; and as it is frequently adulterated, the fraud may be easily detected by mixing equal quantities of minium, and charcoal, in a crucible, and placing the whole over a fire sufficiently intense to melt the lead."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

