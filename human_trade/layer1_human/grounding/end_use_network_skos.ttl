<ontology/use_leather_tanning/use_leather_tanning__0730__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 140" ;
    dcterms:source <https://archive.org/details/b21780535/page/n140> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Divi Divi used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 140"@en ;
    <ontology/quoteText/#resource> "DIVI-DIVI: a commercial name for the wrinkled pods of the Casalpina coriaria, used in tanning."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0730__q2/#resource> dcterms:bibliographicCitation "J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 574" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n574> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Divi Divi used in Leather Tanning, Tawing & Currying: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 574"@en ;
    <ontology/quoteText/#resource> "DIVI DIVI: The commercial name of the pod of the Cesalpinia coriaria, a leguminous plant, found in low, marshy situations in the north parts of South America, principally in New Granada and Venezuela, and in some parts of the West Indies. It is used both for dyeing and tanning, but chiefly for the latter purpose. The pod is from 2 to 3 inches in length by $\\..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0730__q3/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section PRODUCE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Divi Divi used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section PRODUCE"@en ;
    <ontology/quoteText/#resource> "It appears also, from trials made, that one part of divi-divi is sufficient for tanning as much leather as four parts of bark, and the process occupies but one-third of the time."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

