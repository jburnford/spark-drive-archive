oe:use_calico_printing__0185__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Gum Arabic used in Calico Cloth & Calico Printing: Watt (1908), Commercial Products of India, scan p. 27"@en ;
    oe:quoteText "Stokes (speaking of Sind many years ago) says that it is inferior to gum arabic, but is used in medicine, calico-printing, and in paper-making."@en ;
    dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 27" ;
    dcterms:source <https://archive.org/details/b31361584/page/n27/mode/1up> ;
