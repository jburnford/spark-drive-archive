    rdfs:label "Evidence for Bleaching Materials used in Paper Making & Cardboard: McCulloch (1880), Dictionary of Commerce, scan p. 82"@en ;
    <ontology/quoteText/#resource> "This salt was formerly used for removing the last traces of chlorine from the bleached pulp in the manufacture of paper, but is now to a great extent superseded by hyposulphate of soda. Hyposulphite of Soda.—This may be readily prepared by digesting the above-mentioned salt with flowers of sulphur, evaporating, and crystallising."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_paper_making/use_paper_making__1322__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 74" ;
    dcterms:source <https://archive.org/details/b31361584/page/n74/mode/1up> ;
