<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__doc_umber__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 406" ;
    dcterms:source <https://archive.org/details/b21780535/page/n406> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Umber used in Varnish, Paint & Lacquer: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 406"@en ;
    <ontology/quoteText/#resource> "UMBER: a massive mineral pigment, used by painters as a brown colour, and to make varnish dry quickly. It is used either in its natural state, or burnt."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__doc_umber__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. UMBER" ;
