    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_cordage_shipbuilding/use_cordage_shipbuilding__0289__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 204" ;
    dcterms:source <https://archive.org/details/b21780535/page/n204> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Hemp Rough or Undressed used in Shipbuilding, Rope, Cordage & Sailcloth: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 204"@en ;
    <ontology/quoteText/#resource> "HEMP: a fibre obtained from the Cannabis sativa, which is stronger and coarser than flax. It is used for making cordage, canvas for sail-cloth, towelling, &c. The foreign imports are very large. In 1856, we received, chiefly from Russia, 777,998 cwts. of dressed and undressed hemp, besides 15,233 cwts. of tow or codilla. In previous years we had received muc..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_cordage_shipbuilding/use_cordage_shipbuilding__0289__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. HEMP" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Hemp Rough or Undressed used in Shipbuilding, Rope, Cordage & Sailcloth: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. HEMP"@en ;
    <ontology/quoteText/#resource> "HEMP: (Chanvre, Fr.; Hanf, Germ.) is the fibrous rind of the bark of the cannabis sativa, which is spun into strands or yarn for making ropes, sail-cloth, &c. It is prepared for spinning in the same way as flax, which see. Hemp-seed contains an oil which is employed for making soft soap, for painting, and for burning in lamps. See OILS. Importation of undres..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_cordage_shipbuilding/use_cordage_shipbuilding__0289__q3/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 421" ;
    dcterms:source <https://archive.org/details/b31361584/page/n421/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Hemp Rough or Undressed used in Shipbuilding, Rope, Cordage & Sailcloth: Watt (1908), Commercial Products of India, scan p. 421"@en ;
    <ontology/quoteText/#resource> "About the period indicated the East India Company made a great effort to discover a good substitute for Russian hemp, to be employed in the manufacture of ropes and sail canvas."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

