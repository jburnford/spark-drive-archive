oe:ind_metallurgy_tinplate a skos:Concept, crm:E55_Type ;
    rdfs:label "Metallurgy, Smelting, Brass & Tinplate"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Metallurgy, Smelting, Brass & Tinplate"@en ;
    skos:definition "Iron, copper, lead, tin, and zinc smelting, brass founding, type-metal, and tinplate manufacture — combining metallic ores and unwrought metals with coal, coke, charcoal, limestone, borax, plumbago crucibles, sulphuric/muriatic pickling acids, sal ammoniac, and palm oil/tallow tinplate baths."@en ;
