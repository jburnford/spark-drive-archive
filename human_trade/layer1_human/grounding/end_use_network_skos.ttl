    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Atropa Belladonna used in Pharmaceuticals & Druggists' Preparations: Sir George Watt, The Commercial Products of India (1908), scan p. 107"@en ;
    <ontology/quoteText/#resource> "ATROPA BELLADONNA: Linn.; Fl. Br. Ind., iv., 241; SOLANACEÆ. Deadly Nightshade, sangangúr, angúr-shéfa, súchí, girbúti, ustrung, yebraj, luckmuna. A coarse glabrous herb native of the Western Himalaya from Simla to Kashmir at altitudes of 6,000 to 12,000 feet; distributed to Europe and North Persia. D.E.P., i., 351-3. Belladonna. The officinal parts of the p..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__doc_atropa_belladonna__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. HYDROSULPHURETS" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Atropa Belladonna used in Pharmaceuticals & Druggists' Preparations: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. HYDROSULPHURETS"@en ;
    <ontology/quoteText/#resource> "Henbane is a plant used in medicine, from which modern chemistry has extracted a new crystalline vegetable principle called hyosciamine, which is very poisonous, and when applied in solution to the eye, determines a remarkable dilatation of the pupil; as belladonna also does."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

