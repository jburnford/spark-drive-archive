<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__doc_woad__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. INCOMBUSTIBLE CLOTH" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Woad used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. INCOMBUSTIBLE CLOTH"@en ;
    <ontology/quoteText/#resource> "The odour of this vat in its mild but active state is necessarily different from that of the woad vat, as no ammonia is exhaled in the present case, and the sediment is much smaller."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__doc_woad__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 280" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n280/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Woad used in Woollen, Silk & Worsted Dyeing: Mortimer (1823), General Commercial Dictionary, scan p. 280"@en ;
    <ontology/quoteText/#resource> "In the dyeing of wool, woad and bran are commonly employed as vegetable ferments, and lime as the solvent of the green base of the indigo."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

