oe:use_woollen_silk_dyeing__0072__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Galls used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GRAY DYE"@en ;
    oe:quoteText "For dyeing silk gray, fustet, logwood, sumach, and elder-tree bark, are employed instead of galls."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GRAY DYE" ;
