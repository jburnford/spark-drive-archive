    rdfs:label "Evidence for Berries Yellow used in Calico Cloth & Calico Printing: Simmonds (1892), Commercial Dictionary of Trade Products, scan p. 295"@en ;
    <ontology/quoteText/#resource> "PERSIAN-BERRIES, the seeds of Rhamnus infectorius, used as a dye in calico-printing, also called yellow berries."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1265__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F" ;
