    <ontology/hasEvidence/#resource> <ontology/use_calico_printing/use_calico_printing__1825__q1/#resource>, <ontology/use_calico_printing/use_calico_printing__1825__q2/#resource>, <ontology/use_calico_printing/use_calico_printing__1825__q3/#resource> ;
