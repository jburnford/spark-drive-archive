<ontology/use_gunpowder_matches/use_gunpowder_matches__0328__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 272" ;
    dcterms:source <https://archive.org/details/b21780535/page/n272> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Saltpetre used in Gunpowder, Explosives & Lucifer Matches: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 272"@en ;
    <ontology/quoteText/#resource> "NITRE: nitrate of potassa, a natural efflorescence on the surface of the earth in several countries, which is used as saltpetre in the manufacture of gunpowder and of nitric acid."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_gunpowder_matches/use_gunpowder_matches__0328__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GUNPOWDER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Saltpetre used in Gunpowder, Explosives & Lucifer Matches: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GUNPOWDER"@en ;
    <ontology/quoteText/#resource> "At the Waltham Abbey gunpowder works the nitre is rendered so pure by successive solutions and crystallizations, that it causes no opalescence in a solution of nitrate of silver."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_gunpowder_matches/use_gunpowder_matches__0328__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 891" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n891/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Saltpetre used in Gunpowder, Explosives & Lucifer Matches: Mortimer (1823), General Commercial Dictionary, scan p. 891"@en ;
    <ontology/quoteText/#resource> "Saltpetre is of very extensive use in different arts, being the principal ingredient in gunpowder, and serving as an excellent flux to other matters; whence its use in glass-making."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

