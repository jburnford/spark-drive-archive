<ontology/use_brewing_distilling/use_brewing_distilling__0360__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. DISTILLATION" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sugar used in Brewing, Malting & Distilling: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. DISTILLATION"@en ;
    <ontology/quoteText/#resource> "When the distillers first worked from sugar, they only obtained upon an average from 1 cwt. 10·09 gallons imp. of proof spirit; but they afterwards got no less than 11·92 imp. gallons."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_brewing_distilling/use_brewing_distilling__0360__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 427" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n427/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sugar used in Brewing, Malting & Distilling: McCulloch (1880), Dictionary of Commerce, scan p. 427"@en ;
    <ontology/quoteText/#resource> "The price of sugar rapidly declined; and, notwithstanding a forced market was for a while opened to it by substituting it for malt in the distillery, prices did not attain to their former elevation."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

