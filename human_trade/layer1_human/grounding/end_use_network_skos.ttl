<ontology/use_brewing_distilling/use_brewing_distilling__0290__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BEER" ;
