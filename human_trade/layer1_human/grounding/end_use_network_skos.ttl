    <ontology/quoteText/#resource> "It is, in fact, fairly extensively utilised by the Indian jewellers in the manufacture of artificial gems, and with shellac it forms a most valuable varnish."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__0677__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 508" ;
