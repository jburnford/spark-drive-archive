    <ontology/hasEvidence/#resource> <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_sal_ammoniac__q1/#resource>, <ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_sal_ammoniac__q2/#resource> ;
