oe:use_calico_printing__0168__q2 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Starch used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BRIMSTONE"@en ;
    oe:quoteText "The trivial name given to starch, altered by a slight calcination in an oven, whereby it assumes the appearance and acquires the properties of gum, being soluble in cold water, and forming in that state a paste well adapted to thicken the colours of the calico printer."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BRIMSTONE" ;
