<ontology/use_leather_tanning/use_leather_tanning__0041__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bark For Tanners and Dyers Use used in Leather Tanning, Tawing & Currying: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER"@en ;
    <ontology/quoteText/#resource> "Danish leather is made by tanning lamb and kid skins with willow bark, whence it derives an agreeable smell."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0041__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARKS FOR TANNING" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bark For Tanners and Dyers Use used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARKS FOR TANNING"@en ;
    <ontology/quoteText/#resource> "Oak bark contains usually the largest proportion of tannin, and according to Davy's experiments eight-and-a-half pounds of oak bark are equivalent for tanning purposes to two-and-a-quarter of galls, three of sumach, seven-and-a-half of Leicester willow, eleven of Spanish chesnut, eighteen of elm, and twenty-one of common willow bark."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0072/#resource> a <ontology/EndUseAssertion/#resource> ;
    rdfs:label "Galls used in Leather Tanning, Tawing & Currying"@en ;
    <ontology/assertsCommodity/#resource> <id/00/0072/#concept> ;
    <ontology/assertsIndustry/#resource> <ontology/ind_leather_tanning/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_leather_tanning/use_leather_tanning__0072__q1/#resource>, <ontology/use_leather_tanning/use_leather_tanning__0072__q2/#resource>, <ontology/use_leather_tanning/use_leather_tanning__0072__q3/#resource> ;
    <ontology/productionRole/#resource> "tanning_or_curing" ;
    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_leather_tanning/use_leather_tanning__0072__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Galls used in Leather Tanning, Tawing & Currying: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER"@en ;
    <ontology/quoteText/#resource> "For the common purposes of the tanner, 1 pound of it would be equivalent also to 2-1/4 pounds of galls, to 7-1/2 of the Leicester willow, to 11 of the bark of the Spanish chesnut, to 18 of the bark of the common elm, to 21 of the bark of the common willow, and to 3 pounds of sumach."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0072__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARKS FOR TANNING" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Galls used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARKS FOR TANNING"@en ;
    <ontology/quoteText/#resource> "The bitter astringent bark and the galls of several of the Tamarisk tribe are also well suited for the purpose. Mesembryanthemum nodiflorum, one of the numerous indigenous species of the Cape, is used in making morocco leather."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0072__q3/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 48" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n48/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Galls used in Leather Tanning, Tawing & Currying: McCulloch (1880), Dictionary of Commerce, scan p. 48"@en ;
    <ontology/quoteText/#resource> "Its principal use, however, is in the manufacture of sulphuric acid. Tannic Acid or Gallo-tannic Acid.—Tanning principle is contained in gall nuts of the Quercus infectoria, sumach, &c."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

