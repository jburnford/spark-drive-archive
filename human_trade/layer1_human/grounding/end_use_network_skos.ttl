<ontology/use_perfumery_cosmetics/use_perfumery_cosmetics__0573__q1/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 366" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n366/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Spices Cloves used in Perfumery, Pomades & Essential Oils: McCulloch (1880), Dictionary of Commerce, scan p. 366"@en ;
    <ontology/quoteText/#resource> "The use of cloves in cookery is familiar to every one, but they enter also largely into perfumery, and are used in the Pharmacopœias of this country and the United States. (Thomson's Dispensatory; Milburn's Oriental Commerce; British Pharmacopœia, 1867.)"@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_perfumery_cosmetics/use_perfumery_cosmetics__0573__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 542" ;
