<ontology/use_leather_tanning/use_leather_tanning__0028__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Skins Furs Pelts Goat undressed used in Leather Tanning, Tawing & Currying: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER"@en ;
    <ontology/quoteText/#resource> "Curaudau has employed with advantage a steep of dilute sulphuric acid. Morocco leather.--The true morocco leather is goat skin tanned and then dyed on the side of the grain."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0034/#resource> a <ontology/EndUseAssertion/#resource> ;
