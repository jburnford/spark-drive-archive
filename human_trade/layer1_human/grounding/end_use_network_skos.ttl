oe:use_woollen_silk_dyeing__1377__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Turmeric used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TURKEY RED"@en ;
    oe:quoteText "Turmeric is employed by the wool-dyers for compound colours which require an admixture of yellow, as for cheap browns and olives."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TURKEY RED" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    oe:retrievalMode "direct_sentence" .

