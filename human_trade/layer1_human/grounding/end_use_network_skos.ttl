    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_rubber_waterproofing/use_rubber_waterproofing__1216__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 661" ;
    dcterms:source <https://archive.org/details/b31361584/page/n661/mode/1up> ;
