    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Verdigris used in Varnish, Paint & Lacquer: Mortimer (1823), General Commercial Dictionary, scan p. 235"@en ;
    <ontology/quoteText/#resource> "It answers best when used in varnishes. Distilled or crystal-verdigris, is prepared by dissolving common verdigris in vinegar."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__doc_verdigris__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. VERDIGRIS" ;
