<ontology/use_glass_ceramics/use_glass_ceramics__doc_litharge__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 242" ;
    dcterms:source <https://archive.org/details/b21780535/page/n242> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Litharge used in Glassmaking, Pottery & Porcelain: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 242"@en ;
    <ontology/quoteText/#resource> "LITHARGE: semi-crystalline or fused protoxide of lead, obtained in separating silver from lead ore, which enters largely into the composition of flint glass."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__doc_litharge__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. MINIUM" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Litharge used in Glassmaking, Pottery & Porcelain: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. MINIUM"@en ;
    <ontology/quoteText/#resource> "If the lead contains either iron or copper, it affords a minium which cannot be employed with advantage in the manufacture of flint-glass, for pottery glazes, or for house-painting."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__doc_litharge__q3/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 733" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n733/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Litharge used in Glassmaking, Pottery & Porcelain: McCulloch (1880), Dictionary of Commerce, scan p. 733"@en ;
    <ontology/quoteText/#resource> "Litharge, minium, borax, the black oxide of manganese &c. are sometimes used in the manufacture of glass, according to the purposes to which it is to be applied."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

