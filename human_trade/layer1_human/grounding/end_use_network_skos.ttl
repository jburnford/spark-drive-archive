<ontology/use_leather_tanning/use_leather_tanning__0036__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 61" ;
    dcterms:source <https://archive.org/details/b21780535/page/n61> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bran used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 61"@en ;
    <ontology/quoteText/#resource> "BRAN: the refuse of the exterior husk of wheat in grinding, which, besides its nutritious properties, has some commercial value in tanning, in calico-printing, for filling dolls, ensheaths, &c."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0036__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GOLD" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bran used in Leather Tanning, Tawing & Currying: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GOLD"@en ;
    <ontology/quoteText/#resource> "It is finally made quite dry, (after washing in pure water) by being rubbed well with tanners’ dry bark, saw-dust, or bran."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0041/#resource> a <ontology/EndUseAssertion/#resource> ;
