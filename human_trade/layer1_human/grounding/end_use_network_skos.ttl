<ontology/use_perfumery_cosmetics/use_perfumery_cosmetics__0697__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PERFUMERY, ART OF" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Spirits used in Perfumery, Pomades & Essential Oils: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PERFUMERY, ART OF"@en ;
    <ontology/quoteText/#resource> "In making odoriferous extracts and waters, the spirits of the flowers prepared by macerating the flowers in alcohol should be preferred to their distillation, as forming the foundation of good perfumery."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_perfumery_cosmetics/use_perfumery_cosmetics__0697__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 1769" ;
