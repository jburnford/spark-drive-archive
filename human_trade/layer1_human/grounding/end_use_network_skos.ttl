    rdfs:label "Evidence for Sulphuric Acid used in Calico Cloth & Calico Printing: Mortimer (1823), General Commercial Dictionary, scan p. 19"@en ;
    oe:quoteText "Sulphuric acid is much used by dyers and calico-printers, but is not often employed in other arts. Nitric Acid is composed of oxygen, and a peculiar substance termed nitrogen, or azote."@en ;
    dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 19" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n19/mode/1up> ;
