<ontology/use_pharmaceuticals/use_pharmaceuticals__1020__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section ALOES" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Aloes used in Pharmaceuticals & Druggists' Preparations: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section ALOES"@en ;
    <ontology/quoteText/#resource> "According to Dr. Thomson and the \"Materia Medica,\" it is duller in its color than the other kinds, is bitterer, and has a less pleasant aroma than the Socotrine aloes."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__1020__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 39" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n39/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
