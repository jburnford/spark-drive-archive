<ontology/ind_brewing_distilling/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Brewing, Malting & Distilling"@en ;
    skos:definition "Ale, porter, stout, beer brewing, and spirits/gin/whisky/rum distilling — mashing malted barley, grains, sugar, and molasses, bittering with hops (and substitutes like quassia), fining with isinglass, and rectifying gin/cordials with juniper berries, coriander, and spices."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Brewing, Malting & Distilling"@en ;
