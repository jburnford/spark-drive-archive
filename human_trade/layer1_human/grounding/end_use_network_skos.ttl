    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__1216__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 212" ;
