<ontology/use_pharmaceuticals/use_pharmaceuticals__doc_gamboge__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180" ;
    dcterms:source <https://archive.org/details/b21780535/page/n180> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Gamboge used in Pharmaceuticals & Druggists' Preparations: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180"@en ;
    <ontology/quoteText/#resource> "GAMBOGE: a yellow resin used as a pigment, and in medicine as a purgative; obtained in the East from species of Hebradendron and Stalagmites; our supplies come chiefly from Siam."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__doc_gamboge__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section GAMBOGE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Gamboge used in Pharmaceuticals & Druggists' Preparations: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section GAMBOGE"@en ;
    <ontology/quoteText/#resource> "GAMBOGE: This resinous juice, which is a most important article of commerce, is furnished by some of the plants of Gambogia, natives principally of South America. It is a powerful irritant, and is employed medicinally as a drastic and hydragogue cathartic. From its bright yellow color it is also used as a pigment."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__doc_gamboge__q3/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 567" ;
