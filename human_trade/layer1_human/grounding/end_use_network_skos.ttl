    dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 111" ;
    dcterms:source <https://archive.org/details/b21780535/page/n111> ;
    oe:retrievalMode "direct_sentence" .

