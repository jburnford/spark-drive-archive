<ontology/use_leather_tanning/use_leather_tanning__0275__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180" ;
    dcterms:source <https://archive.org/details/b21780535/page/n180> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cutch used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180"@en ;
    <ontology/quoteText/#resource> "GAMBIER: an extract prepared at Singapore from the Uncaria Gambir, and used as a dye and tanning substance. It is misnamed in trade circles Terra Japonica. The imports in the last few years have averaged 6000 tons per annum."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0275__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARKS FOR TANNING" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cutch used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARKS FOR TANNING"@en ;
    <ontology/quoteText/#resource> "Of all the astringent substances we know, catechu appears to contain the largest proportion of tannin, and Mr. Purkis found that one pound was equivalent to seven or eight of oak bark for tanning leather."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_leather_tanning/use_leather_tanning__0275__q3/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 201" ;
    dcterms:source <https://archive.org/details/b31361584/page/n201/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cutch used in Leather Tanning, Tawing & Currying: Watt (1908), Commercial Products of India, scan p. 201"@en ;
    <ontology/quoteText/#resource> "It seems possible that if the bark or wood were utilised as in preparing Catechu, a pure tanning extract might be obtained."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

