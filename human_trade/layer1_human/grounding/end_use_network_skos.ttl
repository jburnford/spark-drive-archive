<ontology/ind_sugar_refining/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Sugar Refining"@en ;
    skos:definition "Refining raw colonial muscovado and beet sugars into loaf and granulated white sugar — clarifying and decolorizing raw cane sugar with lime, bullock's blood/albumen, animal charcoal (bone black), and clay."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
