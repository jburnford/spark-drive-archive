<ontology/use_brewing_distilling/use_brewing_distilling__1520__q1/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 459" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n459/mode/1up> ;
