<ontology/use_gunpowder_matches/use_gunpowder_matches__doc_chlorate_of_potash__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 100" ;
    dcterms:source <https://archive.org/details/b21780535/page/n100> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Chlorate of Potash used in Gunpowder, Explosives & Lucifer Matches: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 100"@en ;
    <ontology/quoteText/#resource> "CHLORATE OF POTASH: a combination of chloric acid with potash. It forms an ingredient of the composition for tipping lucifer matches, is used for bleaching fats and oils, and has lately been introduced into medicine as a tonic and valuable remedy for nervous complaints."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_gunpowder_matches/use_gunpowder_matches__doc_chlorate_of_potash__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GUNPOWDER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Chlorate of Potash used in Gunpowder, Explosives & Lucifer Matches: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GUNPOWDER"@en ;
    <ontology/quoteText/#resource> "When gunpowder is digested with chlorate of potash and dilute muriatic acid, at a moderate heat in a retort, the sulphur is acidified; but this process is disagreeable and slow, and consumes much chlorate."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_gunpowder_matches/use_gunpowder_matches__doc_chlorate_of_potash__q3/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 84" ;
