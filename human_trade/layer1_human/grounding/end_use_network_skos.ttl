    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_soap_manufacture/use_soap_manufacture__0025__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. DEPILATORY" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Lard used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. DEPILATORY"@en ;
    <ontology/quoteText/#resource> "A soap is sometimes made with lard and the above ingredients; or soft soap is combined with them; in either case to form a depilatory pommade."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0025__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 714" ;
    dcterms:source <https://archive.org/details/b31361584/page/n714/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Lard used in Soap Manufacture: Watt (1908), Commercial Products of India, scan p. 714"@en ;
    <ontology/quoteText/#resource> "Lard thus manufactured will keep for about two months only, but formerly for a much longer time—a circumstance due apparently to the fact that fat of the freshest and best quality is not always used. Rendering House. The best quality of lard is much used in cooking and in preparing ointments, etc., the second in the manufacture of lard oil, the third as a lo..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0136/#resource> a <ontology/EndUseAssertion/#resource> ;
