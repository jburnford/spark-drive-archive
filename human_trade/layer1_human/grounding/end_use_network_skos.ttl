    <ontology/quoteText/#resource> "Castor oil is used for lamps in the East Indies, and the Chinese have some mode of depriving it of its medicinal properties, so as to render it suitable for culinary purposes."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__0327__q3/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 203" ;
    dcterms:source <https://archive.org/details/b31361584/page/n203/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Oil Castor used in Pharmaceuticals & Druggists' Preparations: Watt (1908), Commercial Products of India, scan p. 203"@en ;
    <ontology/quoteText/#resource> "Applied externally the powder, made into an ointment with castor oil, is held to be beneficial in hydrocele, and the burnt seeds reduced to a powder are regarded as a valuable DENTIFRICE, especially in spongy gums."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

