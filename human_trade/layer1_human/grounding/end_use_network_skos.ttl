<ontology/use_candle_manufacture/use_candle_manufacture__0835__q1/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 831" ;
    dcterms:source <https://archive.org/details/b31361584/page/n831/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Paraffin used in Candle Manufacture: Watt (1908), Commercial Products of India, scan p. 831"@en ;
    <ontology/quoteText/#resource> "A striking evidence of the prosperity of the Burma candle trade may be had from the existence of an export trade in candles. Candle-making in India.—Except in the new industry of manufacture of candles from the mineral wax and paraffin that has recently assumed considerable proportions both in Rangoon and Calcutta, India cannot be said to possess candle work..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_candle_manufacture/use_candle_manufacture__0910/#resource> a <ontology/EndUseAssertion/#resource> ;
    rdfs:label "Stearine used in Candle Manufacture"@en ;
    <ontology/assertsCommodity/#resource> <id/09/0910/#concept> ;
    <ontology/assertsIndustry/#resource> <ontology/ind_candle_manufacture/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_candle_manufacture/use_candle_manufacture__0910__q1/#resource>, <ontology/use_candle_manufacture/use_candle_manufacture__0910__q2/#resource> ;
    <ontology/productionRole/#resource> "primary_feedstock" ;
    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_candle_manufacture/use_candle_manufacture__0910__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CANDLE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Stearine used in Candle Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CANDLE"@en ;
    <ontology/quoteText/#resource> "Gay Lussac obtained a patent in England for making candles from margaric and stearic acids, improperly called stearine, by converting tallow into the above fat acids by the following process:--Tallow consists, by Chevreul’s researches, of stearine, a solid fat, and elaine, a liquid fat; the former being in much the larger proportion."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_candle_manufacture/use_candle_manufacture__0910__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 1614" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n1614/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Stearine used in Candle Manufacture: McCulloch (1880), Dictionary of Commerce, scan p. 1614"@en ;
    <ontology/quoteText/#resource> "This beautiful wax, one parcel of which varies but little from another, has a bright cream colour, is nearly of the consistence of bees' wax, bears without softening a high degree of atmospheric heat; and as it contains a large percentage of stearine, it is highly suitable for the manufacture of candles, particularly of those known as 'composite,' as well as..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

