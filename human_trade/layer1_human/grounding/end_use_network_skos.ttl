<ontology/use_soap_manufacture/use_soap_manufacture__0625__q1/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 371" ;
    dcterms:source <https://archive.org/details/b31361584/page/n371/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cocoa-nut Oil used in Soap Manufacture: Watt (1908), Commercial Products of India, scan p. 371"@en ;
    <ontology/quoteText/#resource> "As regards the soap industry, cocoanut oil makes a white, hard soap, which is more readily soluble than almost any other in hard or even salt-water."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

