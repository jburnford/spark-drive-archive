    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Amber used in Varnish, Paint & Lacquer: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BITUMEN"@en ;
    <ontology/quoteText/#resource> "A similar varnish may be prepared by dissolving 12 parts of fused amber, 2 parts of rosin, and 2 parts of asphaltum, in 6 parts of linseed oil varnish, to which 12 parts of oil of turpentine have been added."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__doc_amber__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 977" ;
