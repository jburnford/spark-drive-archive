    <ontology/reviewStatus/#resource> "mined_multiple_quotes" .

<ontology/use_soap_manufacture/use_soap_manufacture__0172__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Olive Oil used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP"@en ;
    <ontology/quoteText/#resource> "Three pounds of olive oil afford five pounds of marbled Marseilles soap of good quality, and only four pounds four ounces of white soap; showing that more water is retained by the former than the latter."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0172__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section THE OIL PALM" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Olive Oil used in Soap Manufacture: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section THE OIL PALM"@en ;
    <ontology/quoteText/#resource> "Spanish or Castile soap is made by mixing olive oil and soda, while soft soap is made by mixing the oil with potash."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0172__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 686" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n686/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Olive Oil used in Soap Manufacture: Mortimer (1823), General Commercial Dictionary, scan p. 686"@en ;
    <ontology/quoteText/#resource> "The olive-oil brought from the island of Candia is nearly similar to the Sicilian oils, and is fit only to be employed in the manufacture of soap."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0181/#resource> a <ontology/EndUseAssertion/#resource> ;
