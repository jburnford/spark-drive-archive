    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Flax used in Paper Making & Cardboard: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 466"@en ;
    <ontology/quoteText/#resource> "FLAX WASTE: the tow or refuse collected in the preparation of flax, which is used for papermaking, and as packing for machinery."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_paper_making/use_paper_making__0226__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 448" ;
    dcterms:source <https://archive.org/details/b31361584/page/n448/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Flax used in Paper Making & Cardboard: Watt (1908), Commercial Products of India, scan p. 448"@en ;
    <ontology/quoteText/#resource> "As to the utilisations of the fibre, these may be briefly stated as identical with those of true hemp—namely the production of cordage and canvas, the waste or tow going to the paper mills."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

