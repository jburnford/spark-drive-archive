<ontology/use_glass_ceramics/use_glass_ceramics__1873__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 108" ;
    dcterms:source <https://archive.org/details/b21780535/page/n108> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cobalt Ore used in Glassmaking, Pottery & Porcelain: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 108"@en ;
    <ontology/quoteText/#resource> "COBALT: a mineral, the oxides of which are used for colouring glass and porcelain blue."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__1873__q2/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 227" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n227> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cobalt Ore used in Glassmaking, Pottery & Porcelain: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 227"@en ;
    <ontology/quoteText/#resource> "COBALT: (GER. Kobalt. DU. Kobald. DA. Kobold. SW. Cobolt. FR. Cobalt. IT. SP. and PORT. Cobalto. RUS. and POL. Kobolt. LAT. Cobaltum,) a metal found in the form of an ore, in Saxony, Sweden, in the Mendip Hills in Somersetshire, and in Cornwall. It is principally employed in the state of oxide, in which it is of a beautiful blue colour, called zaffre. There ..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__1873__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. AZURE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cobalt Ore used in Glassmaking, Pottery & Porcelain: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. AZURE"@en ;
    <ontology/quoteText/#resource> "The silicate of cobalt, which precipitates upon mixing the two solutions, is the preparation of cobalt most suitable for painting upon porcelain, and for the manufacture of blue glass."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

