oe:use_soap_manufacture__0562__q2 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Rosin used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP"@en ;
    oe:quoteText "Rosin, although very soluble in alkaline menstrua, is not however susceptible, like fats, of being transformed into an acid, and will not of course saponify, or form a proper soap by itself."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    oe:retrievalMode "direct_sentence" .

oe:use_soap_manufacture__0562__q3 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Rosin used in Soap Manufacture: Mortimer (1823), General Commercial Dictionary, scan p. 936"@en ;
    oe:quoteText "Soap, made with tallow and soda, has a white colour, and therefore known by the name of white soap; but it is usual for soap-makers, in order to lower the price of the article, to mix a considerable portion of rosin with the tallow; this mixture forms the common yellow or turpentine soap."@en ;
    dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 936" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n936/mode/1up> ;
    oe:retrievalMode "direct_sentence" .

