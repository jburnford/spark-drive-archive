oe:use_woollen_silk_dyeing__1899__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Weld used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. FEATHERS"@en ;
    oe:quoteText "After fifteen days’ exposure, they are cleared with soap as above described. Rose colour or pink, is given with safflower and lemon juice. Deep red, by a boiling hot bath of Brazil wood, after aluming. Crimson. The above deep red feathers are passed through a bath of cudbear. Prune de Monsieur. The deep red is passed through an alkaline bath. Blues of every ..."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. FEATHERS" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    oe:retrievalMode "direct_sentence" .

oe:use_woollen_silk_dyeing__0677 a oe:EndUseAssertion ;
