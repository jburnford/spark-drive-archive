    <ontology/reviewStatus/#resource> "mined_single_quote" .

<ontology/use_calico_printing/use_calico_printing__1375__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Gum Senegal used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. C D E F"@en ;
    <ontology/quoteText/#resource> "This solution is to be thickened with 2 libs. of gum senegal, 1 lib. of British gum, and 4 libs. of pipe-clay; adding afterwards, 2 ounces of nitrate of copper--as a deliquescent"@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

