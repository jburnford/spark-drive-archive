    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tin in Blocks Ingots Bars or Slabs used in Metallurgy, Smelting, Brass & Tinplate: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. TIN MORDANTS"@en ;
    <ontology/quoteText/#resource> "They are thence removed, with the adhering grease, into pot No. 1., filled with a melted mixture of block and grain tin, covered with about four inches of tallow, slightly carbonized."@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

