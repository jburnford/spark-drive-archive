<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__doc_minium__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. MINIUM" ;
