<ontology/use_soap_manufacture/use_soap_manufacture__0022__q1/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 955" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n955> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tallow used in Soap Manufacture: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 955"@en ;
    <ontology/quoteText/#resource> "TALLOW: (GER. Talg. DU. Ongel. DA. Tælg, Talg. SW. Talg. FR. Suif. IT. Sevo, Sego. SP. and PORT. Sebo. RUS. Salo toplenoe. POL. Zoy. LAT. Sebum,) a sort of animal fat, melted down and clarified, being used in making soap, and candles, in the dressing of leather, and by salt-boilers for the purpose of imparting a large grain to the salt. Tallow is either yell..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0022__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PINEY TALLOW" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tallow used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PINEY TALLOW"@en ;
    <ontology/quoteText/#resource> "PINEY TALLOW: is a concrete fat obtained by boiling with water the fruit of the Vateria indica, a tree common upon the Malabar coast. It seems to be a substance intermediate between tallow and wax; partaking of the nature of stearine. It melts at 97-1/2° F., is white or yellowish, has a spec. grav. of 0·926; is saponified by alkalies, and forms excellent can..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0022__q3/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 1173" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n1173/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tallow used in Soap Manufacture: McCulloch (1880), Dictionary of Commerce, scan p. 1173"@en ;
    <ontology/quoteText/#resource> "Similar facts may be stated of flax, while the number and variety of substitutes for tallow, as a means for supplying artificial light, and for the manufacture of soap, are even more striking."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0025/#resource> a <ontology/EndUseAssertion/#resource> ;
