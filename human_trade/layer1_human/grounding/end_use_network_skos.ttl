oe:use_woollen_silk_dyeing__0118__q2 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Cochineal used in Woollen, Silk & Worsted Dyeing: Watt (1908), Commercial Products of India, scan p. 361"@en ;
    oe:quoteText "Grades. USES AND COMMERCIAL FORMS OF COCHINEAL.—Cochineal was formerly much employed in dyeing wool, silk, and cotton: to-day it is a colour-ingredient of drugs and confectionery, and an artists' pigment."@en ;
    dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 361" ;
    dcterms:source <https://archive.org/details/b31361584/page/n361/mode/1up> ;
    oe:retrievalMode "direct_sentence" .

oe:use_woollen_silk_dyeing__0118__q3 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Cochineal used in Woollen, Silk & Worsted Dyeing: Mortimer (1823), General Commercial Dictionary, scan p. 283"@en ;
    oe:quoteText "Silk is first dyed crimson, by means of cochineal, and then dipped into the indigo vat."@en ;
    dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 283" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n283/mode/1up> ;
