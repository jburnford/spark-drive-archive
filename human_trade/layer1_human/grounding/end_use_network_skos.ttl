    <ontology/quoteText/#resource> "TALLOW-CANDLE: a mould or dip made of TALLOW-CHANDLER, a dealer in candles."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_candle_manufacture/use_candle_manufacture__0022__q2/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 955" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n955> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tallow used in Candle Manufacture: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 955"@en ;
    <ontology/quoteText/#resource> "TALLOW: (GER. Talg. DU. Ongel. DA. Tælg, Talg. SW. Talg. FR. Suif. IT. Sevo, Sego. SP. and PORT. Sebo. RUS. Salo toplenoe. POL. Zoy. LAT. Sebum,) a sort of animal fat, melted down and clarified, being used in making soap, and candles, in the dressing of leather, and by salt-boilers for the purpose of imparting a large grain to the salt. Tallow is either yell..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_candle_manufacture/use_candle_manufacture__0022__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GAS-LIGHT" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tallow used in Candle Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. GAS-LIGHT"@en ;
    <ontology/quoteText/#resource> "A mould tallow candle, of 6 in the pound, burning for an hour, is equivalent to half a cubic foot of ordinary coal gas, and to four tenths of a foot of good gas."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

