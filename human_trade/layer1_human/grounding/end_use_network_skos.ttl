<ontology/use_pharmaceuticals/use_pharmaceuticals__0285__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. OPIUM" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Opium used in Pharmaceuticals & Druggists' Preparations: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. OPIUM"@en ;
    <ontology/quoteText/#resource> "Of this narcotic alkali not more than 7 parts can be extracted by the most rigid analysis from 100 of the best Turkey opium; a quantity, indeed, somewhat above the average result of many skilful chemists."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__0285__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section THE POPPY" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Opium used in Pharmaceuticals & Druggists' Preparations: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section THE POPPY"@en ;
    <ontology/quoteText/#resource> "A plant known in Jamaica under the name of bull hoof yields a narcotic which has been administered successfully in the shape of tincture and a syrup, instead of opium."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__0285__q3/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 1083" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n1083/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Opium used in Pharmaceuticals & Druggists' Preparations: McCulloch (1880), Dictionary of Commerce, scan p. 1083"@en ;
    <ontology/quoteText/#resource> "East Indian opium has a strong empyreumatic smell; but not much of the peculiar narcotic, heavy odour of the Turkey opium; the taste is more bitter, and equally nauseous, but it has less acrimony."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

