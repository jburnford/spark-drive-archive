<ontology/ind_soap_manufacture/#concept> a crm:E55_Type, skos:Concept ;
    rdfs:label "Soap Manufacture"@en ;
    skos:definition "Hard, soft, yellow, mottled, curd, Castile, and toilet soap manufacture — combining animal tallow and tropical/vegetable oils with caustic alkalis (barilla, kelp, soda ash, potash, lime), rosin, salt for salting out, and essential oils for scenting."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
