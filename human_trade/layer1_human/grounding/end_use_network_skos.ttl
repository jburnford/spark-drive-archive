<ontology/use_calico_printing/use_calico_printing__1304__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. QUERCITRON" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bark Quercitron used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. QUERCITRON"@en ;
    <ontology/quoteText/#resource> "QUERCITRON: is the bark of the Quercus nigra, or yellow oak, a tree which grows in North America, The colouring principle of this yellow dye-stuff has been called Quercitrin, by its discoverer Chevreul. It forms small pale yellow spangles, like those of Aurum musivum, has a faint acid reaction, is pretty soluble in alcohol, hardly in ether, and little in wat..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1304__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 1638" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n1638/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bark Quercitron used in Calico Cloth & Calico Printing: McCulloch (1880), Dictionary of Commerce, scan p. 1638"@en ;
    <ontology/quoteText/#resource> "Hence quercitron bark is now employed in calico printing, to the almost total exclusion of weld."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__1322/#resource> a <ontology/EndUseAssertion/#resource> ;
