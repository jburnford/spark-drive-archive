# ============================================================================
# OPEN EMPIRE — 18-INDUSTRY END-USE OVERLAY NETWORK (LINCS / SKOS / CIDOC-CRM)
# ============================================================================
oe:industry_scheme a skos:ConceptScheme ;
    rdfs:label "Open Empire 19th-Century Manufacturing End-Use Scheme"@en ;
    dcterms:title "Open Empire 19th-Century Manufacturing End-Use Scheme"@en ;
    dcterms:created "2026-11-26"^^xsd:date ;
    skos:hasTopConcept oe:ind_soap_manufacture, oe:ind_calico_printing, oe:ind_woollen_silk_dyeing, oe:ind_chocolate_confectionery, oe:ind_leather_tanning, oe:ind_candle_manufacture, oe:ind_paper_making, oe:ind_varnish_paint_lacquer, oe:ind_glass_ceramics, oe:ind_rubber_waterproofing, oe:ind_brewing_distilling, oe:ind_sugar_refining, oe:ind_cordage_shipbuilding, oe:ind_gunpowder_matches, oe:ind_perfumery_cosmetics, oe:ind_pharmaceuticals, oe:ind_metallurgy_tinplate, oe:ind_hats_brushes_upholstery .

oe:usedInIndustry a owl:ObjectProperty ; rdfs:label "commodity used as input in manufacturing industry"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ; owl:inverseOf oe:usesCommodityInput .
oe:usesCommodityInput a owl:ObjectProperty ; rdfs:label "manufacturing industry employs commodity input"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ; owl:inverseOf oe:usedInIndustry .

oe:EndUseAssertion a owl:Class ; rdfs:label "evidence record for one commodity-to-industry end-use assertion"@en .
oe:EvidenceQuote a owl:Class ; rdfs:label "verbatim primary-source passage offered as evidence"@en .
oe:assertsCommodity a owl:ObjectProperty ; rdfs:label "commodity of the end-use assertion"@en .
oe:assertsIndustry a owl:ObjectProperty ; rdfs:label "industry of the end-use assertion"@en .
oe:hasEvidence a owl:ObjectProperty ; rdfs:label "passage offered as evidence for the assertion"@en .
oe:productionRole a owl:DatatypeProperty ; rdfs:label "role of the commodity in the industry"@en .
oe:reviewStatus a owl:DatatypeProperty ; rdfs:label "reviewed | mined_multiple_quotes | mined_single_quote (keyword-mined, not yet read by a reviewer)"@en .
oe:quoteText a owl:DatatypeProperty ; rdfs:label "verbatim text of the passage"@en .
oe:retrievalMode a owl:DatatypeProperty ; rdfs:label "how the passage was retrieved (direct sentence or essay context)"@en .

oe:use_brewing_distilling__0056 a oe:EndUseAssertion ;
    rdfs:label "Hops used in Brewing, Malting & Distilling"@en ;
    oe:assertsCommodity htc:0056 ;
    oe:assertsIndustry oe:ind_brewing_distilling ;
    oe:productionRole "flavouring_or_scent" ;
    oe:reviewStatus "reviewed" ;
    oe:hasEvidence oe:use_brewing_distilling__0056__q1, oe:use_brewing_distilling__0056__q2 ;
    skos:editorialNote "Review decision (prune): Quote removed: it describes an unnamed adulterant used as a substitute for hops, not hops as an input."@en .

oe:use_brewing_distilling__0056__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Hops used in Brewing, Malting & Distilling: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 208"@en ;
    oe:quoteText "HOP: a climbing plant, the Humulus lupulus, cultivated for its bitter principle, which forms an important element in brewing; the fine hops being used for pale ales, the common, or less fine, for porter. There were, in 1855, nearly 38,000 acres of hop gardens under cultivation in England, which produced about 83,250,000 lbs. of hops. Hop-vines, abounding in ..."@en ;
    dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 208" ;
    dcterms:source <https://archive.org/details/b21780535/page/n208> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0056__q2 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Hops used in Brewing, Malting & Distilling: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BEER"@en ;
    oe:quoteText "After the end of a year or two, hops are reckoned to have lost much of their marketable value, and are then sold to the second-rate porter brewers, under the name of old hops."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BEER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0007 a oe:EndUseAssertion ;
    rdfs:label "Barley used in Brewing, Malting & Distilling"@en ;
    oe:assertsCommodity htc:0007 ;
    oe:assertsIndustry oe:ind_brewing_distilling ;
    oe:productionRole "primary_feedstock" ;
    oe:reviewStatus "reviewed" ;
    oe:hasEvidence oe:use_brewing_distilling__0007__q1, oe:use_brewing_distilling__0007__q2 ;
    skos:editorialNote "Review decision (prune): Quote(s) removed that do not show this use (trade list, different substance, or the commodity as a comparison)."@en .

oe:use_brewing_distilling__0007__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Barley used in Brewing, Malting & Distilling: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 38"@en ;
    oe:quoteText "BARLEY: a common grain, the genus Hordeum, of which there are many cultivated varieties used for human food, for cattle-feeding, and especially for malting. Barley is valuable for culinary purposes, especially for thickening broths, soups, and"@en ;
    dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 38" ;
    dcterms:source <https://archive.org/details/b21780535/page/n38> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0007__q2 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Barley used in Brewing, Malting & Distilling: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARLEY"@en ;
    oe:quoteText "BARLEY: Oats, rye and barley, are the staple crops of northern and mountainous Europe and Asia. In England barley is grown principally in the eastern and some of the midland counties, and chiefly for malting. It is most extensively cultivated in the Himalaya and Thibet, replacing in many districts the wheat, and producing an admirable flour. Since the establ..."@en ;
    dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARLEY" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0239 a oe:EndUseAssertion ;
    rdfs:label "Malt used in Brewing, Malting & Distilling"@en ;
    oe:assertsCommodity htc:0239 ;
    oe:assertsIndustry oe:ind_brewing_distilling ;
    oe:productionRole "primary_feedstock" ;
    oe:reviewStatus "mined_multiple_quotes" ;
    oe:hasEvidence oe:use_brewing_distilling__0239__q1, oe:use_brewing_distilling__0239__q2, oe:use_brewing_distilling__0239__q3 .

oe:use_brewing_distilling__0239__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Malt used in Brewing, Malting & Distilling: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 610"@en ;
    oe:quoteText "MALT: (GER. Maly. DU. Mout. DA. and SW. Malt. FR. Mal, Blégermé. IT. Malto. SP. Cebada retonada ó entallecida. RUS. Solod. POL. Slod. LAT. Malum.) is, correctly, any corn prepared after a particular manner, for brewing the various kinds of beer; but in its general acceptance is applied only to barley so prepared.—Before we proceed to state the method of maki..."@en ;
    dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 610" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n610> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0239__q2 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Malt used in Brewing, Malting & Distilling: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 952"@en ;
    oe:quoteText "MALT: (Ger. maly; Dutch, mout; Fr. mal, blégerme; Ital. malto; Span. cebada retonada ó entallecida; Russ. solod; Lat. maltum). The term malt is applied to designate grain which, being steeped in water, is made to germinate to a certain extent, after which the process is checked by the application of heat. This evolves the saccharine principle of the grain, w..."@en ;
    dcterms:bibliographicCitation "J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 952" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n952> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0239__q3 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Malt used in Brewing, Malting & Distilling: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. MALT"@en ;
    oe:quoteText "MALT: (Eng. and Fr.; Malz, Germ.) is barley-corn, which has been subjected to an artificial process of germination. See BEER. Table of the Quantity of Malt consumed by the undermentioned Brewers of London and Vicinity, from October 10th, 1836, to October 10th, 1837."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. MALT" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0360 a oe:EndUseAssertion ;
    rdfs:label "Sugar used in Brewing, Malting & Distilling"@en ;
    oe:assertsCommodity htc:0360 ;
    oe:assertsIndustry oe:ind_brewing_distilling ;
    oe:productionRole "primary_feedstock" ;
    oe:reviewStatus "reviewed" ;
    oe:hasEvidence oe:use_brewing_distilling__0360__q1, oe:use_brewing_distilling__0360__q2 ;
    skos:editorialNote "Review decision (repoint): Quotes speak of sugar generally; the aggregate statistical line 'Sugar Unrefined Total' was the wrong target."@en .

oe:use_brewing_distilling__0360__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Sugar used in Brewing, Malting & Distilling: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. DISTILLATION"@en ;
    oe:quoteText "When the distillers first worked from sugar, they only obtained upon an average from 1 cwt. 10·09 gallons imp. of proof spirit; but they afterwards got no less than 11·92 imp. gallons."@en ;
    dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. DISTILLATION" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    oe:retrievalMode "direct_sentence" .

oe:use_brewing_distilling__0360__q2 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Sugar used in Brewing, Malting & Distilling: McCulloch (1880), Dictionary of Commerce, scan p. 427"@en ;
    oe:quoteText "The price of sugar rapidly declined; and, notwithstanding a forced market was for a while opened to it by substituting it for malt in the distillery, prices did not attain to their former elevation."@en ;
    dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 427" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n427/mode/1up> ;
    oe:retrievalMode "direct_sentence" .

