<ontology/use_soap_manufacture/use_soap_manufacture__1023__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Mineral Pigment Iron Oxides Ochres &c used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP"@en ;
    <ontology/quoteText/#resource> "Colour:--4 ounces of brown ochre, or Spanish brown. Bitter Almond Soap.--Is made by compounding, with 50 pounds of the best white soap, 10 ounces of the essence of bitter almonds."@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

