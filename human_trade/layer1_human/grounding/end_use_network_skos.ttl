<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_bismuth__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 50" ;
    dcterms:source <https://archive.org/details/b21780535/page/n50> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bismuth used in Metallurgy, Smelting, Brass & Tinplate: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 50"@en ;
    <ontology/quoteText/#resource> "BISMUTH: a reddish-white metal, occurring in brilliant plates, obtained chiefly in Saxony, and used as an alloy in type-metal and pewter. It is sometimes called by workmen tin-glass."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_bismuth__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BISMUTH" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bismuth used in Metallurgy, Smelting, Brass & Tinplate: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BISMUTH"@en ;
    <ontology/quoteText/#resource> "An alloy of 1 bismuth, 2 tin, and 1 lead, is employed as a soft solder by the pewterers; and the same has been proposed as a bath for tempering steel instruments."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_bismuth__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 937" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n937/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bismuth used in Metallurgy, Smelting, Brass & Tinplate: Mortimer (1823), General Commercial Dictionary, scan p. 937"@en ;
    <ontology/quoteText/#resource> "The pewterers use a kind of solder made with two parts of tin, and one of bismuth; this composition melts with the least heat of any of the solders."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

