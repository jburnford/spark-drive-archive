oe:use_woollen_silk_dyeing__0975 a oe:EndUseAssertion ;
    rdfs:label "Sulphuric Acid used in Woollen, Silk & Worsted Dyeing"@en ;
    oe:assertsCommodity htc:0975 ;
    oe:assertsIndustry oe:ind_woollen_silk_dyeing ;
