<ontology/use_leather_tanning/use_leather_tanning__0022__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tallow used in Leather Tanning, Tawing & Currying: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. LEATHER"@en ;
    <ontology/quoteText/#resource> "With this view the hides are hung upon the poles in the close stove room, then laid upon the table, and besmeared with the tallow melted till it begins to crackle."@en ;
    <ontology/retrievalMode/#resource> "essay_context" .

