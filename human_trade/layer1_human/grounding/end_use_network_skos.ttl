<ontology/use_soap_manufacture/use_soap_manufacture__0181__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 285" ;
    dcterms:source <https://archive.org/details/b21780535/page/n285> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Palm Oil used in Soap Manufacture: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 285"@en ;
    <ontology/quoteText/#resource> "PALM-OIL: a dark-yellow oil obtained from the fruit of the oil-palm of the west coast of Africa, the Elais Guineensis. It is used with other solid oils for making soap and candles. Our imports amount to about 40,000 tons a year."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0181__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PALM OIL" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Palm Oil used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PALM OIL"@en ;
    <ontology/quoteText/#resource> "PALM OIL: (Huile de palme, Fr.; Palmöl, Germ.); is obtained, in Guinea and Guyana, by expressing, as also by boiling, the fruit of the avoira elais. It has an orange colour, a smell of violets, a bland taste, is lighter than water, melts at 84° Fahr., becomes rancid and pale by exposure to air, dissolves in boiling alcohol, and consists of 69 parts of oleine..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__0181__q3/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section FOREIGN VEGETABLE OILS IMPORTED" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Palm Oil used in Soap Manufacture: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section FOREIGN VEGETABLE OILS IMPORTED"@en ;
    <ontology/quoteText/#resource> "It is a white solid oil, fusible at a temperature of 97 degrees, and makes excellent candles, especially when saponified and distilled in the manner now adopted with palm oil, &c."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

