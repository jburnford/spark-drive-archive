<ontology/use_glass_ceramics/use_glass_ceramics__1451__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 301" ;
    dcterms:source <https://archive.org/details/b21780535/page/n301> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Clay unmanufactured used in Glassmaking, Pottery & Porcelain: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 301"@en ;
    <ontology/quoteText/#resource> "PIPE-CLAY: an adhesive and plastic unctuous earth, containing about 96 $\\frac{1}{2}$ per cent. of alumina with 61 $\\frac{1}{2}$ silica, which is used for moulding clay tobacco-pipes for smokers, for making various kinds of earthenware, and as a detergent for scouring cloth. From Kingsteignton, in"@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__1451__q2/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 759" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n759> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Clay unmanufactured used in Glassmaking, Pottery & Porcelain: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 759"@en ;
    <ontology/quoteText/#resource> "PIPE-CLAY: (GER. Pfeifenthon. DU. Pypåarde. DA. Pihejord. SW. Piplera. FR. Terre à pipes. IT. Terra da pippe. SP. Tierra de pipa. PORT. Terra de cachimbos.) The difference between the porcelain clay, and those of more moderate purity, called pipe-clays, of which we have plenty in Devonshire, is commonly, that the former remains white when burned in an open f..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__1451__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. T, T" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Clay unmanufactured used in Glassmaking, Pottery & Porcelain: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. T, T"@en ;
    <ontology/quoteText/#resource> "It preserves for an indefinite time the glassy lustre, and is not subject to crack and exfoliate, like most of the Continental stoneware, made from common pipe-clay."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__1683/#resource> a <ontology/EndUseAssertion/#resource> ;
