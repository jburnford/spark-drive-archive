<ontology/use_soap_manufacture/use_soap_manufacture__1895__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. IODINE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Kelp used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. IODINE"@en ;
    <ontology/quoteText/#resource> "Iodine is most economically procured from the mother-water of kelp, as furnished by those manufacturers of soap in Scotland and elsewhere who employ this crude alkaline matter."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__1895__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 886" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n886/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Kelp used in Soap Manufacture: McCulloch (1880), Dictionary of Commerce, scan p. 886"@en ;
    <ontology/quoteText/#resource> "The purification of kelp, so as to render it fit for soap-making, is a much more troublesome and expensive process than the decomposition of salt; and the greatest quantity of alkali used is now obtained by the latter method."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_soap_manufacture/use_soap_manufacture__1895__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 464" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n464/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Kelp used in Soap Manufacture: Mortimer (1823), General Commercial Dictionary, scan p. 464"@en ;
    <ontology/quoteText/#resource> "It is composed of kelp, or the refuse of soap-boilers, and common sand."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

