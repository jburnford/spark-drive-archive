oe:use_gunpowder_matches__doc_chlorate_of_potash__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Chlorate of Potash used in Gunpowder, Explosives & Lucifer Matches: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 100"@en ;
    oe:quoteText "CHLORATE OF POTASH: a combination of chloric acid with potash. It forms an ingredient of the composition for tipping lucifer matches, is used for bleaching fats and oils, and has lately been introduced into medicine as a tonic and valuable remedy for nervous complaints."@en ;
    dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 100" ;
    dcterms:source <https://archive.org/details/b21780535/page/n100> ;
