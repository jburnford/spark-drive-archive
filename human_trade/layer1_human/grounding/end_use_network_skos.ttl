<ontology/use_brewing_distilling/use_brewing_distilling__0007__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 38" ;
    dcterms:source <https://archive.org/details/b21780535/page/n38> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Barley used in Brewing, Malting & Distilling: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 38"@en ;
    <ontology/quoteText/#resource> "BARLEY: a common grain, the genus Hordeum, of which there are many cultivated varieties used for human food, for cattle-feeding, and especially for malting. Barley is valuable for culinary purposes, especially for thickening broths, soups, and"@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_brewing_distilling/use_brewing_distilling__0007__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARLEY" ;
    dcterms:source <https://www.gutenberg.org/ebooks/15191> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Barley used in Brewing, Malting & Distilling: P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section BARLEY"@en ;
    <ontology/quoteText/#resource> "BARLEY: Oats, rye and barley, are the staple crops of northern and mountainous Europe and Asia. In England barley is grown principally in the eastern and some of the midland counties, and chiefly for malting. It is most extensively cultivated in the Himalaya and Thibet, replacing in many districts the wheat, and producing an admirable flour. Since the establ..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

