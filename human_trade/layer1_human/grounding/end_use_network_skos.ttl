    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cotton Raw used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CALICO-PRINTING"@en ;
    <ontology/quoteText/#resource> "CALICO-PRINTING (Impression d’Indiennes, Fr.; Zeugdruckerei, Germ.) is the art of impressing cotton cloth with topical dyes of more or less permanence."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__0141__q2/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 795" ;
