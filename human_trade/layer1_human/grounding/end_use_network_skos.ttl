<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__1451__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CRUCIBLES" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Clay unmanufactured used in Metallurgy, Smelting, Brass & Tinplate: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. CRUCIBLES"@en ;
    <ontology/quoteText/#resource> "The Hessian crucibles from Great Almerode and Epterode are made from a fire clay which contains a little iron, but no lime; it is incorporated with siliceous sand."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

