<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__1504__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. IVORY" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Oil Seed used in Varnish, Paint & Lacquer: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. IVORY"@en ;
    <ontology/quoteText/#resource> "Callot’s etching ground for copper plates, is made by dissolving with heat 4 oz. of mastick in 4 oz. of very fine linseed oil; filtering the varnish through a rag, and bottling it for use."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__1504__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 680" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n680/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Oil Seed used in Varnish, Paint & Lacquer: Mortimer (1823), General Commercial Dictionary, scan p. 680"@en ;
    <ontology/quoteText/#resource> "Linseed-oil, nut-oil, poppy-oil, and hemp-seed-oil, possess this property; but linseed-oil is almost the only one of these liquids employed in this country as drying oil."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__1504__q3/#resource> dcterms:bibliographicCitation "Watt (1908), Commercial Products of India, scan p. 514" ;
