    <ontology/quoteText/#resource> "In Formosa it was formerly thrown away as worthless, but the Japanese used and still use it to a considerable extent in connection with lacquer and varnish-work, besides extracting a considerable residue of camphor from it."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__1790__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 978" ;
