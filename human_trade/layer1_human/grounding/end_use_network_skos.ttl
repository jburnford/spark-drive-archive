<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__0136__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. INCOMBUSTIBLE CLOTH" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Pearl and Pot Ashes used in Woollen, Silk & Worsted Dyeing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. INCOMBUSTIBLE CLOTH"@en ;
    <ontology/quoteText/#resource> "It is said that cloth dyed in the potash indigo vat, requires one third less soap in the washing at the fulling mill, and does not soil the hands after being dressed."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

