<ontology/use_calico_printing/use_calico_printing__0168__q2/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. BRIMSTONE" ;
