<ontology/use_calico_printing/use_calico_printing__doc_prussian_blue__q1/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PRUSSIAN BLUE" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Prussian Blue used in Calico Cloth & Calico Printing: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. PRUSSIAN BLUE"@en ;
    <ontology/quoteText/#resource> "For the mode of applying this pigment in dyeing, see CALICO-PRINTING. Sesquiferrocyanate of potash, is prepared by passing chlorine gas through a solution of ferrocyanide of potassium, till it becomes red, and ceases to precipitate the peroxide salts of iron."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_calico_printing/use_calico_printing__doc_prussian_blue__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 84" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n84/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Prussian Blue used in Calico Cloth & Calico Printing: McCulloch (1880), Dictionary of Commerce, scan p. 84"@en ;
    <ontology/quoteText/#resource> "Ferrocyanide of potassium is manufactured in large quantities for use in dyeing and calico-printing."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

