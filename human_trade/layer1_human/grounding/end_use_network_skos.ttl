    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Pearl and Pot Ashes used in Glassmaking, Pottery & Porcelain: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 788"@en ;
    <ontology/quoteText/#resource> "POT-ASH: (GER. Pottasche. DU. Potas. DA. Potaske. SW. Potaska. FR. Potasse. IT. Potassa. SP. and PORT. Potassa. RUS. Potash. POL. Potasz. LAT. Cineres clavellati,) an alkaline salt, chiefly procured by lixiviation, from the ashes of burnt wood, and other vegetable substances. When pure, it is in form of a whitish powder, of a highly acrid taste, and quickly ..."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_glass_ceramics/use_glass_ceramics__0136__q3/#resource> dcterms:bibliographicCitation "Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. ENAMELS" ;
    dcterms:source <https://www.gutenberg.org/ebooks/44562> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Pearl and Pot Ashes used in Glassmaking, Pottery & Porcelain: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. ENAMELS"@en ;
    <ontology/quoteText/#resource> "In either case, the mixture is put into a crucible, or laid simply on a stratum of sand, quicklime spontaneously slacked, or wood-ashes, placed under a pottery or porcelain kiln."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

