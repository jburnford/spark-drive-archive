# ============================================================================
# OPEN EMPIRE — 18-INDUSTRY END-USE OVERLAY NETWORK (LINCS / SKOS / CIDOC-CRM)
# ============================================================================
oe:industry_scheme a skos:ConceptScheme ;
    rdfs:label "Open Empire 19th-Century Manufacturing End-Use Scheme"@en ;
    dcterms:title "Open Empire 19th-Century Manufacturing End-Use Scheme"@en ;
    dcterms:created "2026-11-25"^^xsd:date ;
    skos:hasTopConcept oe:ind_soap_manufacture, oe:ind_calico_printing, oe:ind_woollen_silk_dyeing, oe:ind_chocolate_confectionery, oe:ind_leather_tanning, oe:ind_candle_manufacture, oe:ind_paper_making, oe:ind_varnish_paint_lacquer, oe:ind_glass_ceramics, oe:ind_rubber_waterproofing, oe:ind_brewing_distilling, oe:ind_sugar_refining, oe:ind_cordage_shipbuilding, oe:ind_gunpowder_matches, oe:ind_perfumery_cosmetics, oe:ind_pharmaceuticals, oe:ind_metallurgy_tinplate, oe:ind_hats_brushes_upholstery .

oe:usedInIndustry a owl:ObjectProperty ; rdfs:label "commodity used as input in manufacturing industry"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ; owl:inverseOf oe:usesCommodityInput .
oe:usesCommodityInput a owl:ObjectProperty ; rdfs:label "manufacturing industry employs commodity input"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ; owl:inverseOf oe:usedInIndustry .

oe:ind_soap_manufacture a skos:Concept, crm:E55_Type ;
    rdfs:label "Soap Manufacture"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Soap Manufacture"@en ;
    skos:definition "Hard, soft, yellow, mottled, curd, Castile, and toilet soap manufacture — combining animal tallow and tropical/vegetable oils with caustic alkalis (barilla, kelp, soda ash, potash, lime), rosin, salt for salting out, and essential oils for scenting."@en ;
    oe:usesCommodityInput htc:0136, htc:0172, htc:0181, htc:0022, htc:0557, htc:1895, htc:0562, htc:0025, htc:0445, htc:0257, htc:0780, htc:2002, htc:0910, htc:0460, htc:doc_bergamot, htc:1504, htc:doc_musk, htc:0573, htc:doc_ochre, htc:doc_neem_oil, htc:0719, htc:0625, htc:0138, htc:0250 .

oe:ind_calico_printing a skos:Concept, crm:E55_Type ;
    rdfs:label "Calico Cloth & Calico Printing"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Calico Cloth & Calico Printing"@en ;
    skos:definition "Cotton weaving, bleaching, dyeing, and calico printing — combining raw cotton with bleaching powder and alkalis, botanical/insect/mineral/coal-tar dyestuffs, metallic mordants, and gum/starch thickeners."@en ;
    oe:usesCommodityInput htc:0302, htc:0136, htc:0141, htc:1932, htc:2002, htc:1322, htc:0267, htc:doc_bichromate_of_potash, htc:0062, htc:doc_citric_acid, htc:0364, htc:1825, htc:0852, htc:0168, htc:0036, htc:doc_prussian_blue, htc:1142, htc:1304, htc:0096, htc:0118, htc:0975, htc:doc_oxalic_acid, htc:doc_nitric_acid, htc:0557, htc:0185, htc:1692, htc:0172, htc:0275, htc:1265, htc:0536, htc:0677, htc:doc_blue_vitriol, htc:0299, htc:0203, htc:0109, htc:0348, htc:0008, htc:doc_muriatic_acid, htc:doc_sal_ammoniac, htc:0257, htc:doc_verdigris, htc:1375, htc:0072, htc:0587, htc:0562, htc:doc_albumin, htc:1758, htc:0524, htc:1492, htc:0339, htc:1115, htc:0986, htc:doc_chlorate_of_potash, htc:1899, htc:doc_orpiment .

oe:ind_woollen_silk_dyeing a skos:Concept, crm:E55_Type ;
    rdfs:label "Woollen, Silk & Worsted Dyeing"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Woollen, Silk & Worsted Dyeing"@en ;
    skos:definition "Woollen, worsted, and silk scouring, fulling, and dyeing — employing raw wool and silk with scarlet/crimson insect dyes (cochineal, lac dye, kermes), lichen dyes (orchal, archil, cudbear), indigo/woad vats, alum/tartar/tin mordants, olive oil, and fuller's earth."@en ;
    oe:usesCommodityInput htc:0021, htc:0062, htc:1932, htc:0118, htc:0471, htc:0263, htc:0302, htc:0536, htc:2002, htc:1142, htc:doc_woad, htc:0339, htc:0136, htc:doc_prussian_blue, htc:0364, htc:doc_nitric_acid, htc:0109, htc:0096, htc:1377, htc:0072, htc:0975, htc:doc_citric_acid, htc:1899, htc:0677, htc:0172, htc:1304 .

oe:ind_chocolate_confectionery a skos:Concept, crm:E55_Type ;
    rdfs:label "Chocolate & Confectionery"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Chocolate & Confectionery"@en ;
    skos:definition "Chocolate bars, drinking chocolate, cocoa butter, and sugar confectionery — combining roasted cacao beans with cane sugar, aromatic spices (vanilla, cinnamon, cloves, cassia), gums, almonds, starches, and milk."@en ;
    oe:usesCommodityInput htc:doc_vanilla, htc:0138, htc:0103, htc:0719, htc:0008, htc:0855, htc:0185, htc:0168, htc:1492, htc:0460, htc:0573, htc:1639, htc:doc_musk, htc:doc_ambergris, htc:0695, htc:0118, htc:0097 .

oe:ind_leather_tanning a skos:Concept, crm:E55_Type ;
    rdfs:label "Leather Tanning, Tawing & Currying"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Leather Tanning, Tawing & Currying"@en ;
    skos:definition "Tanning, tawing, and currying raw ox/calf/sheep/goat hides into sole, harness, morocco, Russia, and chamois leather — using oak, hemlock, and mimosa barks, valonia, sumach, cutch, myrabolans, divi-divi, lime, alum, salt, tallow, and fish/train oils."@en ;
    oe:usesCommodityInput htc:doc_oak_bark, htc:0109, htc:0275, htc:0072, htc:0132, htc:1932, htc:0730, htc:0975, htc:2002, htc:0180, htc:0036, htc:0041, htc:0034, htc:0020, htc:0008, htc:0022, htc:0028, htc:0257, htc:doc_mimosa_bark, htc:0348, htc:0250 .

oe:ind_candle_manufacture a skos:Concept, crm:E55_Type ;
    rdfs:label "Candle Manufacture"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Candle Manufacture"@en ;
    skos:definition "Dipped, mould, composite, stearine, wax, spermaceti, and paraffin candle manufacture — combining tallow, palm/coconut stearine, beeswax, spermaceti, and paraffin with cotton wicks and sulphuric acid/borax treatments."@en ;
    oe:usesCommodityInput htc:0022, htc:0910, htc:doc_spermaceti, htc:0025, htc:0835, htc:0129 .

oe:ind_paper_making a skos:Concept, crm:E55_Type ;
    rdfs:label "Paper Making & Cardboard"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Paper Making & Cardboard"@en ;
    skos:definition "Paper, pasteboard, and millboard manufacture — pulping linen/cotton rags, esparto grass, wood pulp, straw, hemp, and jute, bleached with chloride of lime, sized with rosin/alum/gelatine/starch, and loaded or tinted with kaolin, smalt, and ultramarine."@en ;
    oe:usesCommodityInput htc:0822, htc:0168, htc:1015, htc:0557, htc:1322, htc:0226, htc:0289, htc:0136, htc:0562, htc:1932, htc:0066, htc:0529 .

oe:ind_varnish_paint_lacquer a skos:Concept, crm:E55_Type ;
    rdfs:label "Varnish, Paint & Lacquer"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Varnish, Paint & Lacquer"@en ;
    skos:definition "Spirit and oil varnishes, japans, lacquers, French polish, and house/marine paints — dissolving tropical resins (copal, dammar, shellac, mastic, sandarac, amber, elemi, rosin) in linseed oil, turpentine, and spirits, pigmented with white lead, vermilion, ochre, umber, ultramarine, and chrome yellow."@en ;
    oe:usesCommodityInput htc:0860, htc:0077, htc:0578, htc:0543, htc:0677, htc:1504, htc:1538, htc:doc_umber, htc:1790, htc:doc_sandarac, htc:doc_amber, htc:1216, htc:0015, htc:0062, htc:0207, htc:doc_verdigris, htc:0118, htc:0267, htc:doc_ochre, htc:0562, htc:doc_gamboge, htc:0427, htc:doc_gum_dammar, htc:doc_vermilion, htc:1683, htc:1599, htc:0129, htc:doc_prussian_blue, htc:doc_bichromate_of_potash, htc:1377, htc:doc_elemi .

oe:ind_glass_ceramics a skos:Concept, crm:E55_Type ;
    rdfs:label "Glassmaking, Pottery & Porcelain"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Glassmaking, Pottery & Porcelain"@en ;
    skos:definition "Crown, plate, bottle, and flint glassmaking plus earthenware and bone-china porcelain — fusing sand/flint and kaolin/china clay with soda ash, barilla, kelp, potash, lime, red lead/litharge, manganese, borax, cobalt/smalt, and calcined bone ash."@en ;
    oe:usesCommodityInput htc:0702, htc:0136, htc:0267, htc:doc_kaolin, htc:1873, htc:1451, htc:1115, htc:0299, htc:1683, htc:0257, htc:1895, htc:0557, htc:0328, htc:0348, htc:1825, htc:0364, htc:0162, htc:0807 .

oe:ind_rubber_waterproofing a skos:Concept, crm:E55_Type ;
    rdfs:label "India-Rubber, Gutta-Percha & Waterproofing"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "India-Rubber, Gutta-Percha & Waterproofing"@en ;
    skos:definition "Vulcanized india-rubber goods, mackintosh waterproof fabrics, elastic webbing, and gutta-percha submarine telegraph cable insulation — combining caoutchouc and gutta-percha with sulphur, coal-tar naphtha, turpentine, white lead, zinc, and woven cotton/linen."@en ;
    oe:usesCommodityInput htc:0015, htc:1216, htc:0696, htc:0207, htc:1504 .

oe:ind_brewing_distilling a skos:Concept, crm:E55_Type ;
    rdfs:label "Brewing, Malting & Distilling"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Brewing, Malting & Distilling"@en ;
    skos:definition "Ale, porter, stout, beer brewing, and spirits/gin/whisky/rum distilling — mashing malted barley, grains, sugar, and molasses, bittering with hops (and substitutes like quassia), fining with isinglass, and rectifying gin/cordials with juniper berries, coriander, and spices."@en ;
    oe:usesCommodityInput htc:0056, htc:0007, htc:0239, htc:0103, htc:0135, htc:1639, htc:1701, htc:1520, htc:0290, htc:doc_coriander, htc:0695, htc:doc_cocculus_indicus .

oe:ind_sugar_refining a skos:Concept, crm:E55_Type ;
    rdfs:label "Sugar Refining"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Sugar Refining"@en ;
    skos:definition "Refining raw colonial muscovado and beet sugars into loaf and granulated white sugar — clarifying and decolorizing raw cane sugar with lime, bullock's blood/albumen, animal charcoal (bone black), and clay."@en ;
    oe:usesCommodityInput htc:0103, htc:0162, htc:1248, htc:0135, htc:0348, htc:doc_albumin .

oe:ind_cordage_shipbuilding a skos:Concept, crm:E55_Type ;
    rdfs:label "Shipbuilding, Rope, Cordage & Sailcloth"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Shipbuilding, Rope, Cordage & Sailcloth"@en ;
    skos:definition "Wooden ship construction, spars, sails, caulking, and marine cordage — combining oak, teak, greenheart, pine/fir masts, and copper sheathing with hemp, manila/abaca, coir, sisal, flax, oakum, tar, pitch, turpentine, and rosin."@en ;
    oe:usesCommodityInput htc:0289, htc:0207, htc:0022, htc:0578, htc:0543, htc:0562, htc:0394, htc:0226, htc:doc_manila_hemp, htc:0529, htc:0126, htc:doc_coir, htc:0029 .

oe:ind_gunpowder_matches a skos:Concept, crm:E55_Type ;
    rdfs:label "Gunpowder, Explosives & Lucifer Matches"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Gunpowder, Explosives & Lucifer Matches"@en ;
    skos:definition "Black gunpowder, blasting powder, guncotton, and lucifer/congreve friction matches — compounding saltpetre (potassium/sodium nitrate), brimstone (sulphur), and willow/alder charcoal, plus phosphorus, chlorate of potash, pine splints, paraffin, and glue for matches."@en ;
    oe:usesCommodityInput htc:1248, htc:0328, htc:0430, htc:0136, htc:doc_chlorate_of_potash, htc:1015, htc:doc_nitric_acid, htc:doc_glycerine, htc:doc_phosphorus .

oe:ind_perfumery_cosmetics a skos:Concept, crm:E55_Type ;
    rdfs:label "Perfumery, Pomades & Essential Oils"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Perfumery, Pomades & Essential Oils"@en ;
    skos:definition "Eau de Cologne, scented spirits, pomades, incense, and cosmetics — infusing alcohol, lard, and olive/almond oils with essential oils (bergamot, otto of roses, lavender, citronella, sandalwood), animal fixatives (musk, ambergris, castor), and fragrant resins/spices (benzoin, myrrh, olibanum, vanilla, cloves)."@en ;
    oe:usesCommodityInput htc:0573, htc:0077, htc:1599, htc:0339, htc:0719, htc:doc_vanilla, htc:0025, htc:1914, htc:0445, htc:doc_otto_of_roses, htc:0172, htc:doc_musk, htc:0618, htc:0625, htc:doc_sandal_wood, htc:doc_storax, htc:doc_ambergris, htc:1702, htc:doc_alkanet .

oe:ind_pharmaceuticals a skos:Concept, crm:E55_Type ;
    rdfs:label "Pharmaceuticals & Druggists' Preparations"@en ;
    skos:inScheme oe:industry_scheme ;
    skos:topConceptOf oe:industry_scheme ;
    skos:prefLabel "Pharmaceuticals & Druggists' Preparations"@en ;
    skos:definition "19th-century apothecary, pharmacopoeia, and fine-chemical drug manufacture (e.g., Howard & Sons, Allen & Hanburys) — extracting alkaloids and preparing tinctures, pills, plasters, and ointments from cinchona/quinine, opium/morphia/laudanum, coca/cocaine, nux vomica/strychnine, quicksilver/calomel, ipecacuanha, jalap, senna, rhubarb, aloes, camphor, castor/cod-liver oils, and iodine."@en ;
