oe:use_brewing_distilling__1520__q1 a oe:EvidenceQuote ;
    rdfs:label "Evidence for Juniper Berries used in Brewing, Malting & Distilling: Mortimer (1823), General Commercial Dictionary, scan p. 459"@en ;
    oe:quoteText "The best is said to be made by distilling a second time Scotch whiskey with the addition of juniper berries; but for the ordinary sort, oil of turpentine is substituted in the manufactory instead of the juniper."@en ;
    dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 459" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n459/mode/1up> ;
    oe:retrievalMode "direct_sentence" .

