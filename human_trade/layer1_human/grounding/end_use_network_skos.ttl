    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tar used in Shipbuilding, Rope, Cordage & Sailcloth: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 302"@en ;
