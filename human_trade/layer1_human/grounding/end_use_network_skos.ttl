    <ontology/quoteText/#resource> "CASTOR-OIL: a mild purgative fixed oil, obtained from the seeds of Ricinus communis, used in medicine, for lamps, and other purposes."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_pharmaceuticals/use_pharmaceuticals__0327__q2/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854; Project Gutenberg #15191), section CASTOR OIL PLANT" ;
