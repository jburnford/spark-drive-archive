    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_woollen_silk_dyeing/use_woollen_silk_dyeing__0062__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 280" ;
