    <ontology/quoteText/#resource> "MASTIC: a choice and valuable white resin obtained from the Pistacia lentiscus, which forms the basis of a varnish for paper; a building cement made from Portland stone, sand, and a small quantity of litharge."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .

<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__1538__q2/#resource> dcterms:bibliographicCitation "Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 627" ;
