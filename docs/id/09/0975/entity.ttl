<id/09/0975/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Sulphuric Acid"@en ;
    skos:broadMatch <customs-1866/chemical/#concept> ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:definition "one of the most important chemical agents used in the arts and manufactures, made by conducting the burning lumps of sulphur through a leaden vessel, exposed to the action of an oxide, water, and steam. It is used in the manufacture of soda-ash, in bleaching woolens, straw, &c., and for a variety of chemical productions, to the extent of 300,000 tons per annum. It is also called oil of vitriol. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 379]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0975" ;
    skos:prefLabel "Sulphuric Acid"@en ;
