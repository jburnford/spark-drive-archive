    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0436" ;
    skos:prefLabel "Castor"@en ;
    skos:scopeNote "Historical boundary object: in 1800–1852 British/Canadian customs ledgers (measured in lbs from Canada/Hudson's Bay), 'Castor' denotes beaver castoreum (North American beaver, Castor canadensis), not castor oil."@en ;
