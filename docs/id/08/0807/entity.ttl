<id/08/0807/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Smalts"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a vitreous substance obtained by melting together zaffres, a regulus of cobalt, potash and siliceous matter, and grinding the produce to a fine powder, commercially known as powder-blue. It is employed to give a blue tinge to writing-paper, linen, and starch, and, not being affected by fire, is much employed in painting earthenware. Some is made in this country, but the bulk used, about 60 tons a-year, comes from Holland. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 362]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0807" ;
    skos:prefLabel "Smalts"@en ;
