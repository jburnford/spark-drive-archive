<id/doc/doc_gamboge/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Gamboge"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a yellow resin used as a pigment, and in medicine as a purgative; obtained in the East from species of *Hebradendron* and *Stalagmites*; our supplies come chiefly from Siam. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_gamboge" ;
    skos:prefLabel "Gamboge"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 468."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n180>, <https://archive.org/details/b21780535/page/n468>, <https://archive.org/details/generalcommercia00mort/page/n456> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q2043769> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_pharmaceuticals/#concept>, <ontology/ind_varnish_paint_lacquer/#concept> .
