<id/doc/doc_sugar_of_lead/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Sugar of Lead"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:definition "properly _Acetate of lead_, (_Acetate de plomb_; _Sel de Saturne_, Fr.; _Essigsaures Bleioxyd_, _Bleizucker_, Germ.) is prepared by dissolving pure litharge, with heat, in strong vinegar, made of malt, wood, or wine, till the acid be saturated. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_sugar_of_lead" ;
    skos:prefLabel "Sugar of Lead"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 378."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n378>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_06_Sugars_and_Honey" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_calico_printing/#concept> .
