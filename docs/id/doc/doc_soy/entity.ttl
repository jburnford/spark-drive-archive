<id/doc/doc_soy/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Soy"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "is a liquid condiment, or sauce, imported chiefly from China. It is prepared with a species of white haricots, wheat flour, common salt, and water; in the proportions respectively of 50, 60, 50, and 250 pounds. The haricots are washed, and boiled in water till they become so soft as to yield to the fingers. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_soy" ;
    skos:prefLabel "Soy"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
