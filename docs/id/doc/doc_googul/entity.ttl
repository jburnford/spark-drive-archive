<id/doc/doc_googul/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Googul"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:definition "a resinous substance resembling myrrh, met with in India, believed to be the bdellium of commerce, and probably the produce of *Commiphora Madagascariensis*. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 188]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_googul" ;
    skos:prefLabel "Googul"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 188."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n188> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
