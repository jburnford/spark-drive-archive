<id/doc/doc_woad/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Woad"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "(_Vouëde_, _Pastel_, Fr.; _Waid_, Germ; _Isatis tinctoria_, Linn.); the _glastum_ of the antient Gauls and Germans; is an herbaceous plant which was formerly much cultivated, as affording a permanent blue dye, but it has been in modern times well nigh superseded by _indigo_. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_woad" ;
    skos:prefLabel "Woad"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 1018."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n1018>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_53_Dyeing_Tanning_Colouring" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q212547> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_woollen_silk_dyeing/#concept> .
