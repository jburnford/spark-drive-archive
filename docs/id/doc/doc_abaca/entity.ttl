<id/doc/doc_abaca/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Abaca"@en ;
    skos:altLabel "Manila Hemp"@en ;
    skos:broader <id/grp/grp_bast_plant_fibres/#concept> ;
    skos:definition "The Indian name of the hemp of the Philippine Islands. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 43]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_abaca" ;
    skos:prefLabel "Abaca"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 43."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
