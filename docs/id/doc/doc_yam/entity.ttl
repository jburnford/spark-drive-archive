<id/doc/doc_yam/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Yam"@en ;
    skos:altLabel "Affoo Yam"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q8047551> ;
    skos:definition "a climbing plant, with large tuberous roots, forming one of the bread-stuffs of the W. Indies, and other tropical regions, of which there are several species. The roots are very rich in nutritive fecula; hence they are much used as articles of diet. The common yam is the *Dioscorea sativa*; the wing-stalked or red-yam (*D. alata*); the prickly-yam (*D. aculeata*); [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 430]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_yam" ;
    skos:prefLabel "Yam"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0085 (Vegetables Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 430."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n430> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q21873832> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0085/#concept> .
