<id/doc/doc_elder/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Elder"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "the *Sambucus nigra*, a tree common in Britain and the South of Europe. The wood, which is remarkable for its hardness, is often used for carpenters' rules, weavers' shuttles, meat-skewers, &c. The light pith of the branches is used for electrical purposes. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 151]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_elder" ;
    skos:prefLabel "Elder"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 151."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n151> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q22701> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
