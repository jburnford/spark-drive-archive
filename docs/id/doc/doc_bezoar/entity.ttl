<id/doc/doc_bezoar/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Bezoar"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "a morbid concretion found in the stomachs of some animals, and possessing many fanciful medicinal properties. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 47]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_bezoar" ;
    skos:prefLabel "Bezoar"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 47, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 122."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n47>, <https://archive.org/details/b31361584/page/n143>, <https://archive.org/details/generalcommercia00mort/page/n122> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
