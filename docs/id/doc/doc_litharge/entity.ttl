    skos:definition "semi-crystalline or fused protoxide of lead, obtained in separating silver from lead ore, which enters largely into the composition of flint glass. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 242]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_litharge" ;
