<id/doc/doc_karri/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Karri"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "an Australian colossal tree, the *Eucalyptus diversicolor*; also a name for *Labeo calbasu*. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 477]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_karri" ;
    skos:prefLabel "Karri"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 477, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 224."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
