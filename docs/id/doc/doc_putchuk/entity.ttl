<id/doc/doc_putchuk/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Putchuk"@en ;
    skos:altLabel "costus"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "an Eastern name for the roots of *Aucklandia Costus*, the *Costus Arabicus* of the ancients. About two million pounds are annually collected on the mountains of Cashmere. It is chiefly exported to China, where it is used as incense. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 319]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_putchuk" ;
    skos:prefLabel "Putchuk"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 319, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 497."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n319>, <https://archive.org/details/b21780535/page/n497>, <https://www.gutenberg.org/ebooks/15191> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q14568379>, <http://www.wikidata.org/entity/Q24850280> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
