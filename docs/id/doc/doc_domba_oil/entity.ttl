<id/doc/doc_domba_oil/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Domba Oil"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:definition "a fragrant fixed oil obtained in India from the seeds of the Alexandrian laurel (*Calophyllum inophyllum*). It is used for burning and for medicinal purposes, being considered a cure for the itch. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 142]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_domba_oil" ;
    skos:prefLabel "Domba Oil"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 142, P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854, Project Gutenberg #15191)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n142>, <https://www.gutenberg.org/ebooks/15191> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_42_Fixed_Vegetable_Fats_and_Oils" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q311471> ;
