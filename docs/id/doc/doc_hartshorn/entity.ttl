<id/doc/doc_hartshorn/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Hartshorn"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q5675278> ;
    skos:definition "rasplings from the horn of the deer, which are used medicinally. When boiled to a jelly it is nutritive, and a pungent volatile spirit was formerly obtained by distillation from the horn, but it is now made from carbonate of ammonia and similar products of bone. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 201]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_hartshorn" ;
    skos:prefLabel "Hartshorn"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 201, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n201>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> .
