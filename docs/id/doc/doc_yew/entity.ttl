<id/doc/doc_yew/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Yew"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a well-known tree. The wood of the European species, *Taxus baccata*, and its varieties, is occasionally used for the construction of bows, handles to furniture and cabinet work. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 432]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_yew" ;
    skos:prefLabel "Yew"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 432."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n432> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q179729> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
