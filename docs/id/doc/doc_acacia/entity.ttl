@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_acacia/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Acacia"@en ;
    skos:broader <id/grp/grp_vegetable_tannins/#concept> ;
    skos:definition "(GER. *Acaciensaft*. FR. *Suc d'acacia*. IT. *Acacia*. SP. *Acacia verdadera*, *o'de Levante*. PORT. *Acacia*. LAT. *Acacia succus*.) Egyptian thorn, a species of *Mimosæ*, from which the Chinese make that yellow which we see bears washing in their silks and stuffs, and appears with so much elegance in their painting on paper. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 12]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_acacia" ;
    skos:prefLabel "Acacia"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0041 (Bark For Tanners and Dyers Use). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 12, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 14."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n14>, <https://archive.org/details/b31361584/page/n14>, <https://archive.org/details/generalcommercia00mort/page/n12> ;
    <ontology/ghostAcresDomain/#resource> "tannins_leather" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0041/#concept> .
