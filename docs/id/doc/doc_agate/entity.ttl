<id/doc/doc_agate/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Agate"@en ;
    skos:broader <id/grp/grp_industrial_minerals/#concept> ;
    skos:definition "popularly CORNELIAN (Ger. *achat*; Dutch, *achaat*; Fr. *agate*; Ital. *agata*; Russ. *agat*; Lat. *achates*). A genus of semi-pellucid gems, so called from the Greek *ἀγάτης*, because originally found on the banks of the river of that name in Italy. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 58]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_agate" ;
    skos:prefLabel "Agate"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0653 (Precious Stones Unset). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 58, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 28."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n17>, <https://archive.org/details/dictionaryprac00mccu/page/n58>, <https://archive.org/details/generalcommercia00mort/page/n28> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_27_Crude_Fertilizers_and_Minerals" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/06/0653/#concept> .
