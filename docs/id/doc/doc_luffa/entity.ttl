<id/doc/doc_luffa/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Luffa"@en ;
    skos:broader <id/grp/grp_bast_plant_fibres/#concept> ;
    skos:definition "A genus of climbing plants, native of the warmer regions of the Old World and one indigenous in America. Four or five are wild in India. *L. acutangula*, Roxb.; Duthie and Fuller, *Field and Garden Crops*, 1883, ii., 60, t. lxii; *Rec. Bot. Surv. Ind.*, iii., 61, 216. *The taroi (torai), jhingá, satpatiya, shirálá,* *pikunkai*, etc. [Sir George Watt, The Commercial Products of India (1908), scan p. 766]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_luffa" ;
    skos:prefLabel "Luffa"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 766."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b31361584/page/n766> ;
    <ontology/ghostAcresDomain/#resource> "fibres_textiles" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/08/0822/#concept> .
