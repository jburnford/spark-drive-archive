<id/doc/doc_mai_tikien/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Mai Tikien"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a valuable timber of Siam, obtained from the *Metrosideros vera*; a wood used in ship-building, as when submerged it is superior to teak. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 483]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_mai_tikien" ;
    skos:prefLabel "Mai Tikien"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 483."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n483> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
