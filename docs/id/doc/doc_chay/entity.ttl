<id/doc/doc_chay/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Chay"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a red dye-stuff obtained in India from the root of *Hedyotis umbellata*, and used by dyers for the same purposes as madder. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 96]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_chay" ;
    skos:prefLabel "Chay"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 96, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 354."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n96>, <https://archive.org/details/dictionaryprac00mccu/page/n354> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q7085552> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
