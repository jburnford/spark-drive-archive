<id/doc/doc_bismuth/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Bismuth"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q942> ;
    skos:definition "a reddish-white metal, occurring in brilliant plates, obtained chiefly in Saxony, and used as an alloy in type-metal and pewter. It is sometimes called by workmen tin-glass. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 50]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_bismuth" ;
    skos:prefLabel "Bismuth"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 50, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n50>, <https://archive.org/details/dictionaryprac00mccu/page/n211>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
