<id/doc/doc_blackwood/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Blackwood"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a valuable furniture wood obtained in Malabar, the best being from the *Dalbergia latifolia*. It is locally called rose-wood. The blackwood of New South Wales, also known as light wood, is the *Acacia melanoxylon*. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 52]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_blackwood" ;
    skos:prefLabel "Blackwood"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 52."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n52> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q386585>, <http://www.wikidata.org/entity/Q726420> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
