<id/doc/doc_violet_wood/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Violet Wood"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a turnery wood of Guiana, the produce of *Andira violacea*. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 518]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_violet_wood" ;
    skos:prefLabel "Violet Wood"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 518."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n518> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "forest_harvest" ;
    <ontology/landBasis/#resource> "terrestrial_forest" ;
    <ontology/sitcCode/#resource> "SITC4_24_Cork_and_Wood" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
