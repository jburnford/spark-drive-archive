<id/doc/doc_oleanthic_ether/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Oleanthic Ether"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:definition "the name given to the essential oil, or substance to which the smell and a great part of the taste of many wines are due, and which, being volatile, is distilled over in the manufacture of brandy from such wines, contributing largely to the flavour of cognac. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 275]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_oleanthic_ether" ;
    skos:prefLabel "Oleanthic Ether"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 275."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n275> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> .
