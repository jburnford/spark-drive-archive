<id/doc/doc_mordant/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Mordant"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q5857145> ;
    skos:definition "a chemical base used in calico-printing to fix the colours, such as alum; a liquid mixture, used in dyeing, which enables the colour to combine permanently with the textile fabric. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 264]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_mordant" ;
    skos:prefLabel "Mordant"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 264, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n264>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
