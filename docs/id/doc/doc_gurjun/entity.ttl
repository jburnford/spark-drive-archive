<id/doc/doc_gurjun/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Gurjun"@en ;
    skos:altLabel "Wood Oil"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:definition "an oleo-resin; a thin balsam or wood oil, obtained in Burmah and the Eastern archipelago, from *Diplocarpus latis*, and other species. It is used medi- [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 196]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_gurjun" ;
    skos:prefLabel "Gurjun"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 196."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n196> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0124/#concept> .
