<id/doc/doc_elm_bark/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Elm Bark"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "the bark of the slippery elm of the United States (*Ulmus fulva*), sold by herbalists as an emollient, diuretic, and tonic; that of the British elm (*U. campestris*), is stated to have analogous properties, but much less active. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 464]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_elm_bark" ;
    skos:prefLabel "Elm Bark"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 464."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n464> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "forest_harvest" ;
    <ontology/landBasis/#resource> "terrestrial_forest" ;
    <ontology/sitcCode/#resource> "SITC4_24_Cork_and_Wood" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q50873850> ;
