<id/doc/doc_dikamali/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Dikamali"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:definition "a fragrant resinous gum which in India exudes from the tops of the branches of the *Gardenia lucida*. It is extensively used as a dressing for slight injuries and wounds, and is sold in some parts as googul. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 139]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_dikamali" ;
    skos:prefLabel "Dikamali"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 139."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n139> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
