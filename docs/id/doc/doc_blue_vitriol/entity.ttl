    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:definition "the sulphate of copper, which is used medicinally and to burn off proud flesh, for dyeing and electrolyzing. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 54]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_blue_vitriol" ;
    skos:prefLabel "Blue Vitriol"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 54, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
