<id/doc/doc_colocynthis/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Colocynthis"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "COLOQUINTIDA, or BITTER CUCUMBER (Ger. koloquinten, coloquinten apfel; Dutch, bitter-appelen; Fr. coloquintes; Ital. coloquintida; Span. coloquintidas; Arab. and Pers. Hunzil). The produce of an annual plant (*Cucumis colocynthis*, Linn.; Nat. Order *Cucurbitaceæ*) growing in Turkey, Nubia, India, and other places, much resembling the cucumber in herbage. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 410]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_colocynthis" ;
    skos:prefLabel "Colocynthis"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 410, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 233."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/dictionaryprac00mccu/page/n410>, <https://archive.org/details/generalcommercia00mort/page/n233> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q21872946> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
