<id/doc/doc_agave/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Agave"@en ;
    skos:broader <id/grp/grp_bast_plant_fibres/#concept> ;
    skos:definition "a genus of plants producing fibre, and furnishing an intoxicating beverage, known in Mexico as pulque. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 17]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_agave" ;
    skos:prefLabel "Agave"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 17, Sir George Watt, The Commercial Products of India (1908), scan p. 42."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n17>, <https://archive.org/details/b31361584/page/n42> ;
    <ontology/ghostAcresDomain/#resource> "fibres_textiles" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/08/0822/#concept> .
