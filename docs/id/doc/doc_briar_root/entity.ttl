<id/doc/doc_briar_root/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Briar Root"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a name for *Smilax rotundifolia*, the root of which is much used for howls of tobacco pipes. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 447]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_briar_root" ;
    skos:prefLabel "Briar Root"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 447."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n447> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q7544559> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
