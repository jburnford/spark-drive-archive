<id/doc/doc_sesame/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Sesame"@en ;
    skos:altLabel "Sesamum Indicum"@en, "Sesamum Seed"@en, "Teel Seed"@en, "Wangala"@en ;
    skos:broader <id/grp/grp_oilseeds/#concept> ;
    skos:definition "a plant, the *Sesamum orientale*, universally cultivated in the East Indies for the oil expressed from its seeds. We imported, in 1855, 652 quarters of sesame seed. In 1856, 22,790 cwt. of this seed were shipped from Madras alone, besides 2214 cwt. of oil. It is there called Gingely or Gingelle, and the seed is also known in commerce under its vernacular name of teel and til. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 349]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_sesame" ;
    skos:prefLabel "Sesame"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 349, P. L. Simmonds, The Commercial Products of the Vegetable Kingdom (1854, Project Gutenberg #15191)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n349>, <https://www.gutenberg.org/ebooks/15191> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_22_Oil_Seeds_and_Oleaginous_Fruits" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q17813478> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0012/#concept> .
