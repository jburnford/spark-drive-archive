<id/doc/doc_cape_aloes/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Cape Aloes"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "an inspissated juice obtained chiefly from *Aloe spicata* and *Commelini*, species of Aloe growing wild in the Cape colony. The odour is stronger and more disagreeable than that of the product made in Barbados and Socotra. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 79]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_cape_aloes" ;
    skos:prefLabel "Cape Aloes"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 79."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n79> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_54_Medicinal_Pharmaceutical" ;
