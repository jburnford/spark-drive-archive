    rdfs:label "Crin Vegetal"@en ;
    skos:broader <id/grp/grp_bast_plant_fibres/#concept> ;
    skos:definition "(French), a name for the curled twisted fibre of the dwarf palm. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 459]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_crin_vegetal" ;
    skos:prefLabel "Crin Vegetal"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 459."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
