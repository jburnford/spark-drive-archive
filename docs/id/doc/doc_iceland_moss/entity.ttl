<id/doc/doc_iceland_moss/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Iceland Moss"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "a lichen, the *Cetraria islandica*, yielding a nutritious starch, used in medicine, and forming an important article of commerce. It has to go through a long process before it can be rendered sufficiently palatable to be used as food; it is first soaked in water till the bitterness is extracted, and then boiled with milk; a kind of bread is also said to be prepared from it. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 212]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_iceland_moss" ;
    skos:prefLabel "Iceland Moss"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 212, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 510."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n212>, <https://archive.org/details/generalcommercia00mort/page/n510> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q21976087>, <http://www.wikidata.org/entity/Q582664> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
