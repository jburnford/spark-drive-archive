<id/doc/doc_curry_leaf/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Curry Leaf"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "a name for the fragrant leaves of *Murraya koenigii*, largely used in India, fresh or dried, as a condiment in seasoning native curries. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 460]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_curry_leaf" ;
    skos:prefLabel "Curry Leaf"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 460."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n460> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q244731> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
