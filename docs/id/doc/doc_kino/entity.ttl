<id/doc/doc_kino/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Kino"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q6414155> ;
    skos:definition "is an extractive matter obtained from the _nauclea gambir_, a shrub which grows at Bancoul and Sumatra, but principally in Prince of Wales’ Island. It is of a reddish-brown colour, has a bitter styptic taste, and consists chiefly of tannin. It is used only as an astringent in medicine. Kino is often called a gum, but most improperly. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_kino" ;
    skos:prefLabel "Kino"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 227."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n227>, <https://archive.org/details/generalcommercia00mort/page/n549>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "forest_harvest" ;
    <ontology/landBasis/#resource> "terrestrial_forest" ;
    <ontology/sitcCode/#resource> "SITC4_29_Crude_Animal_Vegetable_Materials" ;
