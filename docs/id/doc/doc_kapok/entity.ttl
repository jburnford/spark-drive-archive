<id/doc/doc_kapok/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Kapok"@en ;
    skos:broader <id/grp/grp_bast_plant_fibres/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q1728687> ;
    skos:definition "a name, in the Eastern archipelago for the cotton down enveloping the seeds of the silk cotton-tree, *Bombax pentandrum*. It is used by the poor inhabitants for stuffing chairs, pillows, &c., but is seldom or never used for beds, it being thought unwholesome to sleep upon. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 224]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_kapok" ;
    skos:prefLabel "Kapok"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 224."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n224> ;
    <ontology/ghostAcresDomain/#resource> "fibres_textiles" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q21872040> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/08/0822/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_hats_brushes_upholstery/#concept> .
