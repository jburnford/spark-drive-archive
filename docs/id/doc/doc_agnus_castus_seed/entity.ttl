<id/doc/doc_agnus_castus_seed/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Agnus Castus Seed"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:definition "(GER. *Schafmüllen*. Du. *Kuischboomzaad*. DA. and SW. *Agnus-Castus frö*. FR. *Petit poivre*. IT. *Semenza d'agnocasto*. LAT. *Agni-Casti Semen*,) also called vitex seed, from the chaste tree. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 30]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_agnus_castus_seed" ;
    skos:prefLabel "Agnus Castus Seed"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 30, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 438."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n438>, <https://archive.org/details/generalcommercia00mort/page/n30> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_22_Oil_Seeds_and_Oleaginous_Fruits" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0124/#concept> .
