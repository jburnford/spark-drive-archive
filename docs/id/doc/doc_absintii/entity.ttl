<id/doc/doc_absintii/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Absintii"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "or wormwood, is the produce of *Artemisia absinthium*, which is much used in medicine for its bitter properties. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 14]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_absintii" ;
    skos:prefLabel "Absintii"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 14."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
