<id/doc/doc_tacamahac/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Tacamahac"@en ;
    skos:altLabel "Tacamahaca"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q2389105> ;
    skos:definition "A resin obtained chiefly from the *Fagara ootandra*; and formerly in use for fumigation and plasters. There are two sorts, the West and East Indian, the latter being, however, uncommon. It is of a light brown colour, very brittle, and easily melted when heated. When pure, it has an aromatic smell, between that of lavender and musk; [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1471]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_tacamahac" ;
    skos:prefLabel "Tacamahac"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1471, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/dictionaryprac00mccu/page/n1471>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/02/0220/#concept> .
