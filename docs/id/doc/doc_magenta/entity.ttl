<id/doc/doc_magenta/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Magenta"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a coal tar colour, prepared by adding anhydrous bichloride of tin by degrees to aniline, or by acting upon aniline with nitrate of mercury. This colour first became of commercial importance in 1860. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 482]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_magenta" ;
    skos:prefLabel "Magenta"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0756 (Coal Tar Dyes Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 482."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n482> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_53_Dyeing_Tanning_Colouring" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/07/0756/#concept> .
