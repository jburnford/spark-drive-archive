<id/doc/doc_red_sanders_wood/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Red Sanders Wood"@en ;
    skos:altLabel "Sandal"@en, "Sanders Wood"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "an East Indian dye-wood, the produce of the *Pterocarpus santalinus*, a hard heavy wood imported from Madras and Calcutta. In 1856 117,901 Indian maunds (86,426 tons) of this wood were shipped from Madras. Besides its use as a dye-wood it is employed as the basis of various dentifrice mixtures. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 328]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_red_sanders_wood" ;
    skos:prefLabel "Red Sanders Wood"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 328."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n328> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "forest_harvest" ;
    <ontology/landBasis/#resource> "terrestrial_forest" ;
    <ontology/sitcCode/#resource> "SITC4_24_Cork_and_Wood" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q2392887> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
