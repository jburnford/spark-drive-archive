<id/doc/doc_croton_oil/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Croton Oil"@en ;
    skos:altLabel "Croton"@en, "Oil (not seed)"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q456053> ;
    skos:definition "The expressed oil from the seeds of the *Croton tiglium*, a small tree growing in Hindostan, Ceylon, and the Moluccas, and belonging to the Natural Order *Euphorbiaceæ*. The whole plant contains an acrid, purgative principle. The seeds have been known in Europe from the beginning of the 17th century, under the name of *grana Molucca* and *grana tiglia*. [J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 555]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_croton_oil" ;
    skos:prefLabel "Croton Oil"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 555."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/dictionaryprac00mccu/page/n555> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q2089847> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0124/#concept> .
