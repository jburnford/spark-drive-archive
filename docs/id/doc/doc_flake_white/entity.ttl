<id/doc/doc_flake_white/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Flake White"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:definition "a sub-nitrate of bismuth; oxidised carbonate of lead in the form of scales or plates; when levigated, it is called body white. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 168]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_flake_white" ;
    skos:prefLabel "Flake White"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 168, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n168>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> .
