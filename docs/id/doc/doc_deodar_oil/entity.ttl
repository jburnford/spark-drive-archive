@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_deodar_oil/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Deodar Oil"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "an empyreumatic medicinal oil obtained from *Erythroxylon areolatum*; deodar is also the name for a species of pine of the Himalayas, the turpentine of which is used as a stimulant to foul ulcers. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 136]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_deodar_oil" ;
    skos:prefLabel "Deodar Oil"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 136."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n136> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
