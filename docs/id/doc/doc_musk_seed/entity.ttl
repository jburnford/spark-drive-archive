<id/doc/doc_musk_seed/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Musk Seed"@en ;
    skos:altLabel "Amber Seed"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "the seeds of *Abelmoschus moschatus*, of Wight and Arnott; the *Hibiscus abelmoschus* of Linnæus, which are stimulating, cordial, and stomachic, and made into a tincture by the Arabs, against serpent bites. See ABELMOSCHUS. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 267]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_musk_seed" ;
    skos:prefLabel "Musk Seed"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 267, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 651."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n267>, <https://archive.org/details/generalcommercia00mort/page/n651> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_22_Oil_Seeds_and_Oleaginous_Fruits" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q2086536>, <http://www.wikidata.org/entity/Q21874501> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
