    rdfs:label "Sienna"@en ;
    skos:altLabel "Terra Sienna"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a brown pigment; a brown mottled marble. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 505]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_sienna" ;
    skos:prefLabel "Sienna"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 505."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
