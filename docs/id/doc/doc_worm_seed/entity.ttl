<id/doc/doc_worm_seed/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Worm Seed"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "a commercial substance composed principally of the flower-buds of some doubtful species of *Artemisia*, largely used in medical practice in Germany, and imported into this country. The American worm-seed, or \"Jerusalem oak,\" *Chenopodium anthelminticum*, is a very common weed: the herb and seeds contain a peculiar essential oil, of very strong vermifuge properties. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 428]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_worm_seed" ;
    skos:prefLabel "Worm Seed"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 428."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n428> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_22_Oil_Seeds_and_Oleaginous_Fruits" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q21872299> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
