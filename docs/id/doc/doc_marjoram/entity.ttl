<id/doc/doc_marjoram/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Marjoram"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "the *Origanum vulgare*, used as a seasoning in cookery, the powder as an ermine, the tea for nervousness. This plant also yields what is called the oil of thyme in the shops, a common remedy for tooth-ache. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 253]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_marjoram" ;
    skos:prefLabel "Marjoram"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 253, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 622."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n253>, <https://archive.org/details/generalcommercia00mort/page/n622> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q134283> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
