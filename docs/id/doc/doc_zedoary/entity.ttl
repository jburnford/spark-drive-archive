<id/doc/doc_zedoary/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Zedoary"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "a general name for the roots of several species of *Zingiber* and *Curcuma*. The yellow zedoary is the rhizomes of the *Zingiber Cassumunari*, which have a hot and bitterish taste, but are now very little used; the long zedoary of pharmacy is the palmate and tuberous roots of *Curcuma Zerumbet*, and the round zedoary, *C. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 433]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_zedoary" ;
    skos:prefLabel "Zedoary"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 433, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n433>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q111243081> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
