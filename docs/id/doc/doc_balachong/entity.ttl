<id/doc/doc_balachong/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Balachong"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "a preparation in the Eastern seas, consisting of small fish with prawns [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 33]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_balachong" ;
    skos:prefLabel "Balachong"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 33, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 127."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n33>, <https://archive.org/details/dictionaryprac00mccu/page/n127> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
