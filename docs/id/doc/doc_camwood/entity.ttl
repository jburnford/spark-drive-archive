<id/doc/doc_camwood/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Camwood"@en ;
    skos:altLabel "african sandalwood"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a red dyeing wood, the produce of *Baphia nitida* imported from the West coast of Africa. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 76]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_camwood" ;
    skos:prefLabel "Camwood"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 76, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 303."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
