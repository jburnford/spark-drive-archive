<id/doc/doc_caviar/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Caviar"@en ;
    skos:broader <id/grp/grp_fish_seafood/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q186385> ;
    skos:definition "a preparation of the dried spawn or salted roe of fish; a single sturgeon will sometimes yield as much as 120 lbs. of roe. Caviar is principally consumed in Russia, Germany, and Italy, by the Greeks during their long fasts; and also in England. The black caviar is made from the roe of the sturgeon; [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 89]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_caviar" ;
    skos:prefLabel "Caviar"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0351 (Fisheries Articles Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 89."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n89> ;
    <ontology/ghostAcresDomain/#resource> "fisheries_marine" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "wild_hunted_fished" ;
    <ontology/landBasis/#resource> "marine" ;
    <ontology/sitcCode/#resource> "SITC4_03_Fish_and_Seafood" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/03/0351/#concept> .
