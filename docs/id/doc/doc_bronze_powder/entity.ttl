<id/doc/doc_bronze_powder/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Bronze powder"@en ;
    skos:altLabel "mosaic gold"@en, "stannic sulfide"@en ;
    skos:broader <id/grp/grp_metals_semi_finished/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q693323> ;
    skos:definition "a metallic powder resembling gold-dust. The principal uses of bronze colours are for japanning and bronzing tin and iron goods, statues, castings, paper machine work, printing, ornamental painting, and such like purposes. *See LEAF METAL. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 64]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_bronze_powder" ;
    skos:prefLabel "Bronze powder"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0010 (Other Articles). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 64."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n64> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_67_68_Metals" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0010/#concept> .
