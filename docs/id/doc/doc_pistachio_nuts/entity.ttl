<id/doc/doc_pistachio_nuts/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Pistachio Nuts"@en ;
    skos:broader <id/grp/grp_oilseeds/#concept> ;
    skos:definition "the small almonds or nuts in the drupe of the *Pistacia vera*, and its varieties, natives of Syria, which are imported in small quantities from Messina, Sicily, and other ports in the Mediterranean, either shelled or unshelled. The kernels are small, pale green, with a flavour like sweet almonds. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 301]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_pistachio_nuts" ;
    skos:prefLabel "Pistachio Nuts"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 301."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n301> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
