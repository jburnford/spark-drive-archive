<id/doc/doc_kola_nuts/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Kola Nuts"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "the brown seed of the *Sterculia acuminata*, about the size of a pigeon's egg, which are very highly esteemed in Africa. When chewed or sucked, they are said to enhance the flavour of any thing eaten afterwards, and also to purify putrid water. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 229]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_kola_nuts" ;
    skos:prefLabel "Kola Nuts"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 229."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n229> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q39238141> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
