<id/doc/doc_bowstring_hemp/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Bowstring Hemp"@en ;
    skos:altLabel "Sansevieria Roxburghiana"@en, "Sansevieria Zeylanica"@en ;
    skos:broader <id/grp/grp_bast_plant_fibres/#concept> ;
    skos:definition "a name given by Dr. Roxburgh to the strong silky fibres of the *Sanseveira zeylanica*, a lilaceous plant, because the natives of the East make their best bowstrings of it. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 60]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_bowstring_hemp" ;
    skos:prefLabel "Bowstring Hemp"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 60."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n60> ;
    <ontology/ghostAcresDomain/#resource> "fibres_textiles" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_26_Textile_Fibres" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/08/0822/#concept> .
