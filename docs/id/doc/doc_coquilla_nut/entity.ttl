<id/doc/doc_coquilla_nut/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Coquilla Nut"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:definition "the fruit of the *Attalea funifera*, a South American palm. These hard mottled nuts, which take a fine polish, are largely imported for the purposes of the turner, who shapes them into various small ornamental and useful articles, especially the handles of bell-pulls, the knobs of walking-sticks, umbrellas, &c. The same palm furnishes the piassaba fibre of commerce. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 118]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_coquilla_nut" ;
    skos:prefLabel "Coquilla Nut"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0352 (Nuts and Kernels Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 118."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n118> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q379397> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/03/0352/#concept> .
