@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_carmine/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Carmine"@en ;
    skos:altLabel "Polish cochineal"@en, "crimson lake"@en, "natural red 4"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a beautiful lako pigment, a fine bright crimson inclining to scarlet, formed by a combination of cochineal, alumina, and oxide of tin. In consequence of being more transparent than other colours, it is chiefly used for miniature painting, artificial-flower tinting, and water-colour drawing. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 82]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_carmine" ;
    skos:prefLabel "Carmine"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 82, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 204."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n82>, <https://archive.org/details/dictionaryprac00mccu/page/n336>, <https://archive.org/details/generalcommercia00mort/page/n204> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
