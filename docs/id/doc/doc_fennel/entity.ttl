<id/doc/doc_fennel/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Fennel"@en ;
    skos:altLabel "Fennel Seed"@en ;
    skos:broader <id/grp/grp_oilseeds/#concept> ;
    skos:definition "an umbelliferous plant, the *Anethum fœniculum dulce*, cultivated on the Continent as a pot-herb, and for the seeds and essential oil obtained from them. The seed is used in the manufacture of gin, and in medicine as a carminative. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 162]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_fennel" ;
    skos:prefLabel "Fennel"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 162."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n162> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0012/#concept> .
