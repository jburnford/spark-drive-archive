<id/doc/doc_vulture_feathers/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Vulture Feathers"@en ;
    skos:broader <id/grp/grp_animal_fibres/#concept> ;
    skos:definition "feathers of species of *Accipitres*, imported from Bombay, and sold for stuffing beds, &c., the larger ones for making artificial flowers, &c. \\* [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 415]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_vulture_feathers" ;
    skos:prefLabel "Vulture Feathers"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1590 (Feathers of other sorts Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 415, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 518."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n415>, <https://archive.org/details/b21780535/page/n518> ;
    <ontology/ghostAcresDomain/#resource> "fibres_textiles" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "animal_husbandry" ;
    <ontology/landBasis/#resource> "terrestrial_pasture" ;
    <ontology/sitcCode/#resource> "SITC4_26_Textile_Fibres" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/15/1590/#concept> .
