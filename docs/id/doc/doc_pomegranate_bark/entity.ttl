<id/doc/doc_pomegranate_bark/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Pomegranate Bark"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "a name for the rind of the pomegranate fruit, which is used in medicine, and in dyeing, on account of its astringency. It is also said to be employed for tanning Morocco leather. The bark of the root is emetic and purgative, and administered for worms. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_pomegranate_bark" ;
    skos:prefLabel "Pomegranate Bark"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n307> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
