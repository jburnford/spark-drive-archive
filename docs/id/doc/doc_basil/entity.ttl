@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_basil/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Basil"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "the *Ocymum basilicum*, a favourite pot-herb among French cooks, being used, from its aromatic odour and pungency, to give a further zest to highly seasoned dishes, and for flavouring soups and salads; an aromatic ethereal oil is obtained from the root. Tanned sheep's skin; also the angle at which a cutting tool is ground. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 40]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_basil" ;
    skos:prefLabel "Basil"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 40, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 115."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n40>, <https://archive.org/details/generalcommercia00mort/page/n115> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
