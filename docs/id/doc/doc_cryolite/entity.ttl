<id/doc/doc_cryolite/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Cryolite"@en ;
    skos:broader <id/grp/grp_industrial_minerals/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q193502> ;
    skos:definition "a mineral only found on the west coast of Greenland, lately imported as a source of aluminium; which it is said can be afforded at a price as low as silver. Besides this metal and crystals of soda, a clay is obtainable which will be valuable to calico printers as a substitute for a compound of alum and sugar of lead. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 127]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_cryolite" ;
    skos:prefLabel "Cryolite"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1905 (Minerals Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 127."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n127> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_27_Crude_Fertilizers_and_Minerals" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/19/1905/#concept> .
