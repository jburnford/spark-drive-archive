<id/doc/doc_cuttle_bone/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Cuttle Bone"@en ;
    skos:broader <id/grp/grp_furs_marine_pelts/#concept> ;
    skos:definition "a name given to the calcareous plate which strengthens the back of the cuttle fish (*Sepia officinalis*). It was formerly much prized in medicine as an absorbent; it is now almost solely employed for polishing of paint, varnish, wood, or the softer metals, and for making pounce and tooth powder. Large supplies are received at Bombay from the Persian gulf. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 131]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_cuttle_bone" ;
    skos:prefLabel "Cuttle Bone"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0071 (Furs Unenumerated Undressed). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 131."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n131> ;
    <ontology/ghostAcresDomain/#resource> "tannins_leather" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "animal_husbandry" ;
    <ontology/landBasis/#resource> "terrestrial_pasture" ;
    <ontology/sitcCode/#resource> "SITC4_29_Crude_Animal_Vegetable_Materials" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0071/#concept> .
