@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_verditer/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Verditer"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "(GER. *Bergblau*, *Kupferblau*. DU. *Bergblaauw*. DA. *Biergblaat*. SW. *Bergblätt*. FR. *Cendres bleues*. IT. *Azzurro di montagna*. SP. *Verde-Tierra*. PORT. *Verdemontanha azul*. RUS. *Golubez*, *Medndia lazur*. LAT. *Cæruleum montanum*,) a kind of mineral substance, used by painters, &c for a blue; but more usually mixed with a yellow for a green colour. Verditer, according to M. Savary, ought to be made of the *lapis armenus*; or at least of an earthy substance much like it, brought from the mountains of Hungary, &c. only prepared by powdering it, and cleansing it by lotion. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 980]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_verditer" ;
    skos:prefLabel "Verditer"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 980, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 411."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n411>, <https://archive.org/details/generalcommercia00mort/page/n980>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
