<id/doc/doc_phosphorus/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Phosphorus"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q674> ;
    skos:definition "a simple substance, much resembling wax in consistence; when pure, it is nearly of the transparency of gum-copal, varying from amber-red to the faintest straw colour, highly combustible, and when oxygenated, producing a strong and peculiar acid. It was discovered by a German chemist, of the name of Brandt, about 160 years since. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 750]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_phosphorus" ;
    skos:prefLabel "Phosphorus"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 750."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n750> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_gunpowder_matches/#concept> .
