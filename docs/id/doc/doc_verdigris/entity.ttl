@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_verdigris/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Verdigris"@en ;
    skos:altLabel "verdigres"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q2351119> ;
    skos:definition "the acetate of copper; obtained by exposing thin plates of copper, for some time, to the action of the air or more of the wine-presses in the South of France. Besides the French verdigris, there are green distilled, common, and crystallized verdigris. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 411]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_verdigris" ;
    skos:prefLabel "Verdigris"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Danika Drugs.xlsx (British Pharmacopoeia 1867 / Savory 1865), 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 411, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1621. Research note: Subacetate of copper of commerce, used in pigment, and chemical testing. Not much else for drugs.."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n411>, <https://archive.org/details/dictionaryprac00mccu/page/n1621>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_calico_printing/#concept>, <ontology/ind_hats_brushes_upholstery/#concept>, <ontology/ind_varnish_paint_lacquer/#concept> .
