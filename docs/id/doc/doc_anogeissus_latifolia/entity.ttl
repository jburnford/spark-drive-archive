<id/doc/doc_anogeissus_latifolia/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Anogeissus Latifolia"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "The *dhaura*, *dhauri*, *dhavada*, *hesel*, *bákli*, *arma*, *vellay naga*, *chiriman*, etc. A large deciduous pas Tree tree of the Sub-Himalayan tracts from the Ravi eastward to Central and Southern India. Ascends to 3,000 feet in altitude. Dhaura GUM is used in calico-printing and has been suggested as likely to be useful to dyers in England (*Journ. Chem. Soc. [Sir George Watt, The Commercial Products of India (1908), scan p. 82]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_anogeissus_latifolia" ;
    skos:prefLabel "Anogeissus Latifolia"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 82."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b31361584/page/n82> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
