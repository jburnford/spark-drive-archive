<id/doc/doc_morinda/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Morinda"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "A genus of erect or climbing shrubs or trees which comprises about 40 species, all tropical. Of these seven are natives of India. *M. angustifolia*, Roxb. ; *Rec. Bot. Surv. Ind.*, i., 248, 347. The *dáru haridrá*, *asugach*, *chenung*, *ban hardi*, *yiyo*, etc. An evergreen bush of the Eastern Himalaya ascending the hills to 6,000 feet in altitude ; Assam ; [Sir George Watt, The Commercial Products of India (1908), scan p. 794]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_morinda" ;
    skos:prefLabel "Morinda"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 794."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b31361584/page/n794> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
