<id/doc/doc_mango/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Mango"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q169> ;
    skos:definition "a tropical fruit, the produce of trees of the *Mangifera* family, of which there are many cultivated varieties, although only two distinct species of tree. The fruit of the finer kinds have a rich perfumed grateful flavour; while others are so stringy and unpleasant as not to be eatable. The fruit is pickled and preserved, and made into a cloutney. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 250]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_mango" ;
    skos:prefLabel "Mango"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0402 (Fruit Raw unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 250."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n250> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0402/#concept> .
