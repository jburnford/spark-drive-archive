<id/doc/doc_bergamot/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Bergamot"@en ;
    skos:altLabel "mentha citrata"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:definition "an essential oil obtained by distillation from *Mentha citrata*, and also from the rind of a fragrant species of citron (*Citrus Bergamia*); large quantities of this essence are imported. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 46]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_bergamot" ;
    skos:prefLabel "Bergamot"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 46, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 122."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n46>, <https://archive.org/details/generalcommercia00mort/page/n122> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q2607185> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0124/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_soap_manufacture/#concept> .
