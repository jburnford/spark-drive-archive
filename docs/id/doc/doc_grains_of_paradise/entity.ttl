<id/doc/doc_grains_of_paradise/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Grains of paradise"@en ;
    skos:altLabel "Aframomum melegueta"@en, "alligator pepper"@en, "grans of paradise"@en, "guinea grains"@en, "guinea peper"@en, "melegueta pepper"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "the aromatic pungent seeds of the Malaguetin pepper (*Amomum Grana Paradisi*), obtained on the coast of Guinea; a spicy condiment, used in veterinary practice, and in the illegal preparation of malt liquors, &c. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 190]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_grains_of_paradise" ;
    skos:prefLabel "Grains of paradise"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 190, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 474."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n190>, <https://archive.org/details/generalcommercia00mort/page/n474> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_07_Coffee_Tea_Cocoa_Spices" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
