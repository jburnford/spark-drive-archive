<id/doc/doc_lavender/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Lavender"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "the floral leaves of the *Lavandula vera*, which are very fragrant. The compound spirit or tincture of lavender, is given in falutness or looseness of spirits, as a stimulant cordial. It is known as red lavender drops. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 235]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_lavender" ;
    skos:prefLabel "Lavender"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 235, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 561."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n235>, <https://archive.org/details/generalcommercia00mort/page/n561> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q12179080>, <http://www.wikidata.org/entity/Q50844456> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
