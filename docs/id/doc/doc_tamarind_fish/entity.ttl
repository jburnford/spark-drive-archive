<id/doc/doc_tamarind_fish/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Tamarind Fish"@en ;
    skos:broader <id/grp/grp_fish_seafood/#concept> ;
    skos:definition "a preparation of white poulrets, a famous Indian fish, which is much esteemed as a breakfast relish. The fish are cut in transverse slices, and preserved in kegs with the acid pulp of the tamarind fruit. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 383]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_tamarind_fish" ;
    skos:prefLabel "Tamarind Fish"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0351 (Fisheries Articles Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 383."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n383> ;
    <ontology/ghostAcresDomain/#resource> "fisheries_marine" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "wild_hunted_fished" ;
    <ontology/landBasis/#resource> "marine" ;
    <ontology/sitcCode/#resource> "SITC4_03_Fish_and_Seafood" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/03/0351/#concept> .
