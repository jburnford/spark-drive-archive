<id/doc/doc_copperas_white/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Copperas White"@en ;
    skos:altLabel "copperas while"@en, "coquimbite"@en, "goslarite"@en, "zink sulfate"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_copperas_white" ;
    skos:prefLabel "Copperas White"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0010 (Other Articles). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab). Research note: goslarite and coquimbite are not the same thing, but a dictionary pointed to both for copperas white."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
