<id/doc/doc_cassava_cakes/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Cassava Cakes"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "thin cakes baked on a griddle or the embers of a wood fire, made of the pulp or starchy matter of the roots of the cassava or manioc, which form a considerable article of food in tropical countries. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 86]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_cassava_cakes" ;
    skos:prefLabel "Cassava Cakes"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 86."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n86> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
