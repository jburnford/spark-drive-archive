    rdfs:label "Zephyr yarn"@en ;
    skos:broader <id/grp/grp_yarns_cordage/#concept> ;
    skos:definition "a name for dyed yarn or worsted; in England usually called Berlin wool. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 522]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_zephyr_yarn" ;
    skos:prefLabel "Zephyr yarn"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0010 (Other Articles). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 522."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
