<id/doc/doc_pomegranate/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Pomegranate"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q13222088> ;
    skos:definition "the fruit of the *Punica Granatum*, the juice of which is acridulous and sweet, and makes a pleasant sherbet for fever patients. The tree is common now in almost all warm climates. *See DALIM. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_pomegranate" ;
    skos:prefLabel "Pomegranate"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0402 (Fruit Raw unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 307, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1210."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n307>, <https://archive.org/details/dictionaryprac00mccu/page/n1210> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0402/#concept> .
