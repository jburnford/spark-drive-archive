<id/doc/doc_sapucaia_nuts/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Sapucaia Nuts"@en ;
    skos:broader <id/grp/grp_oilseeds/#concept> ;
    skos:definition "the edible seeds of some species of *Locystis*, probably *L. zabucayo*, *grandiflora*, and *ollaria*. In the Indian language, *sapucai* is a fowl. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 502]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_sapucaia_nuts" ;
    skos:prefLabel "Sapucaia Nuts"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 502."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n502> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0012/#concept> .
