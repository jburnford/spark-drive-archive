<id/doc/doc_tonka_bean/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Tonka Bean"@en ;
    skos:altLabel "Tonquin Bean"@en ;
    skos:broader <id/grp/grp_oilseeds/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q27688451> ;
    skos:definition "the fruit of the _Dipterix odorata_, affords a concrete crystalline volatile oil (_stearoptène_), called _coumarine_ by the French. It is extracted by digestion with alcohol, which dissolves the stearoptène, and leaves a fat oil. It has an agreeable smell, and a warm taste. It is fusible at 122° Fahrenheit, and volatile at higher heats. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_tonka_bean" ;
    skos:prefLabel "Tonka Bean"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0012/#concept> .
