<id/doc/doc_black_amber/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Black Amber"@en ;
    skos:broader <id/grp/grp_industrial_minerals/#concept> ;
    skos:definition "(GER. *Gagat*. DU. *Git*. DA. and SW. *Gagat*. FR. *Jois*, *Juyet*. IT. *Gagata*, *Lustrino*. SW. *Axabache*. PORT. *Azeviche*. RUS. *Gagat*. POL. *Gagatek*. LAT. *Gugas*, *Gagates*.) See JET. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 149]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_black_amber" ;
    skos:prefLabel "Black Amber"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1905 (Minerals Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 149."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n149> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_27_Crude_Fertilizers_and_Minerals" ;
