<id/doc/doc_guava/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Guava"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q3181909> ;
    skos:definition "a common name for the *Psidium pomiferum* and *pyrifera*, the fruit is much esteemed, either stewed in wine or made into a jelly. The aromatic leaves are used in the Eastern islands medicinally, and as a substitute for the leaf of the betel pepper. The wood, when old, is tough and close-grained, taking a good polish: in India it is used for gun-stocks. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 194]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_guava" ;
    skos:prefLabel "Guava"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0402 (Fruit Raw unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 194."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n194> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q50855224> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0402/#concept> .
