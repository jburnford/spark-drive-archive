<id/doc/doc_tungsten/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Tungsten"@en ;
    skos:broader <id/grp/grp_metallic_ores/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q743> ;
    skos:definition "(Eng. and Fr.; _Wolfram_, Germ.); is a peculiar metal, which occurs in the state of an acid (the _tungstic_), combined with various bases, as with lime, the oxides of iron, manganese, and lead. The metal is obtained by reduction of the ore, or the deoxidizement of the acid, in the form of a dark steel-gray powder, which assumes under the burnisher a feeble metallic lustre. Its specific gravity is 17·22. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_tungsten" ;
    skos:prefLabel "Tungsten"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0382 (Ore Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 515."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n515>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_28_Metalliferous_Ores" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/03/0382/#concept> .
