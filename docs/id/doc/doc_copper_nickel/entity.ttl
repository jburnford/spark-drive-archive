<id/doc/doc_copper_nickel/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Copper Nickel"@en ;
    skos:broader <id/grp/grp_metallic_ores/#concept> ;
    skos:definition "an ore found on the Continent, which consists of a compound of arsenic with nickel. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 117]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_copper_nickel" ;
    skos:prefLabel "Copper Nickel"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0382 (Ore Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 117."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n117> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_28_Metalliferous_Ores" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/03/0382/#concept> .
