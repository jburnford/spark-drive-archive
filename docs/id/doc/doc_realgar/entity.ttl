<id/doc/doc_realgar/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Realgar"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q109746> ;
    skos:definition "or **ROSALGAR**, (GER. *Rauschgelb*. DU. and DA. *Rusgeel*. SW. *Rauschgelb*. FR. *Réalgar*, *Réagal*. IT. *Risigallo*. SP. *Rejalgar*. PORT. *Rosalgar*. RUS. *Krasnoi arsenik*. POL. *Sandaraka*. LAT. *Risigallum*,) generally called *redorpiment*, is of two kinds, native and factitious. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 845]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_realgar" ;
    skos:prefLabel "Realgar"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 845, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 327."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n327>, <https://archive.org/details/generalcommercia00mort/page/n845> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
