<id/doc/doc_opoponax/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Opoponax"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:definition "an acrid medicinal gum-resin, obtained from the juice of the roots of *Opoponax Chironium*, in the Levant. In most of its properties it closely resembles asafoetida. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 278]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_opoponax" ;
    skos:prefLabel "Opoponax"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 278, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1087."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n278>, <https://archive.org/details/dictionaryprac00mccu/page/n1087>, <https://archive.org/details/generalcommercia00mort/page/n689> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/02/0220/#concept> .
