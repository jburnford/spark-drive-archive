@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_curry_stuff/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Curry Stuff"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "a name for the various condiments used to form curries, many of which are transported from place to place in the East, forming extensive articles of commerce. The principal ingredients used by the lower classes for their rice is red pepper, salt, lime juice, and the dried skin of the gorka. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 129]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_curry_stuff" ;
    skos:prefLabel "Curry Stuff"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 129."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n129> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
