<id/doc/doc_carbolic_acid/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Carbolic Acid"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:definition "a tar creosote, which possesses extraordinary antiseptic properties, and has been used to preserve bodies for dissection, and the skins of animals intended to be stuffed. A valuable dye-stuff is also made from it, called carboazotic acid, which gives magnificent straw-coloured yellows on silk and woolen fabrics. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 81]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_carbolic_acid" ;
    skos:prefLabel "Carbolic Acid"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 81."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n81> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_51_52_Chemicals" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> .
