@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_pareira_brava/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Pareira Brava"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "(GER. *Amerikanische Grieswurzels*. DU. *Graveelwortel*. DA. *Amerikansk grususrod*. SW. *Grusrot*. FR. and IT. *Pareira-brava*. SP. *Parreira-brava*, *Butua*. PORT. and LAT. *Pareira brava*.) a hard, woody, crooked root, of a dark colour on the outside, and marked with various wrinkles, which run longitudinally and circularly. Its internal substance is of a dull yellowish colour, and interwoven with ligneous fibres. This root has no smell, but a little bitterish taste, blended with a sweetness, like that of licorice. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 732]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_pareira_brava" ;
    skos:prefLabel "Pareira Brava"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 732."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n732> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
