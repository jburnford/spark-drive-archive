<id/doc/doc_citric_acid/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Citric Acid"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q159683> ;
    skos:definition "(_Acide citrique_, Fr.; _Citronensäure_, Germ.) Scheele first procured this acid in its pure state from lemon juice, by the following process. The juice put into a large tub, is to be saturated with dry chalk in fine powder, noting carefully the quantity employed. The citrate of lime which precipitates being freed from the supernatant foul liquor, is to be well washed with repeated affusion and decantation of water. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_citric_acid" ;
    skos:prefLabel "Citric Acid"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 103."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n103>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_51_52_Chemicals" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_calico_printing/#concept> .
