<id/doc/doc_narwhal/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Narwhal"@en ;
    skos:broader <id/grp/grp_furs_marine_pelts/#concept> ;
    skos:definition "a fish, the *Monodon monoceros*, the long spiral horn or tusk of which furnishes ivory, although seldom used in manufacture. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 269]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_narwhal" ;
    skos:prefLabel "Narwhal"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0071 (Furs Unenumerated Undressed). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 269."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n269> ;
    <ontology/ghostAcresDomain/#resource> "tannins_leather" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0071/#concept> .
