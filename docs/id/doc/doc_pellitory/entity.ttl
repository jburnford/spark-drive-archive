@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_pellitory/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Pellitory"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "a name for the root of *Anthemis Pyrethrum*, which is used as a masticatory to relieve toothache; it enters into the composition of certain snuffs, and the powder is used in large quantities by the Mohammedans to excite transpiration, being rubbed upon the skin. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 293]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_pellitory" ;
    skos:prefLabel "Pellitory"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 293, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1152."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n293>, <https://archive.org/details/dictionaryprac00mccu/page/n1152> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q21870236> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
