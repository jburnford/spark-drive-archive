<id/doc/doc_archangel/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Archangel"@en ;
    skos:altLabel "Anchilica"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:definition "the green stalks are sold as an aromatic candy, the fruitlets for flavouring gin and cordials. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 440]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_archangel" ;
    skos:prefLabel "Archangel"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 440, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 115."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n440>, <https://archive.org/details/dictionaryprac00mccu/page/n115> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> .
