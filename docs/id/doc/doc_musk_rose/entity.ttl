    skos:notation "doc_musk_rose" ;
    skos:prefLabel "Musk Rose"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 267."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
