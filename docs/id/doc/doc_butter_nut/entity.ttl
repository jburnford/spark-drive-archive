<id/doc/doc_butter_nut/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Butter Nut"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:definition "a species of walnut, the produce of *Juglans cinerea*, imported from North America. The kernels of the hard oblong nuts are very oily; the Indians formerly pounded and boiled them, and separating the oily substance which floated on the surface, mixed it with their food; hence the name. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 69]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_butter_nut" ;
    skos:prefLabel "Butter Nut"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0352 (Nuts and Kernels Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 69."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n69> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q630288> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/03/0352/#concept> .
