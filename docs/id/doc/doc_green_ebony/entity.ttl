<id/doc/doc_green_ebony/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Green Ebony"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a wood obtained from the *Jacaranda ovalifolia*, a native of the West Indies, and used both as a hard turning wood and as a dye-stuff: about 600 or 700 tons are imported annually. See **EBONY**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 191]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_green_ebony" ;
    skos:prefLabel "Green Ebony"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 191."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n191> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "forest_harvest" ;
    <ontology/landBasis/#resource> "terrestrial_forest" ;
    <ontology/sitcCode/#resource> "SITC4_24_Cork_and_Wood" ;
