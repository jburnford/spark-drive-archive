<id/doc/doc_blende/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Blende"@en ;
    skos:broader <id/grp/grp_metallic_ores/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q883749> ;
    skos:definition "native sulphuret of zinc, the Black Jack of miners, of little value owing to the difficulty of extracting the metal from the ore. Purple or antimony blende is the mineral kermes. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 53]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_blende" ;
    skos:prefLabel "Blende"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0427 (Zinc Ore). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 53, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n53>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_28_Metalliferous_Ores" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0427/#concept> .
