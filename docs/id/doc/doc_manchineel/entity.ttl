<id/doc/doc_manchineel/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Manchineel"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a large tree, the *Hippomane Mancinella*, a native of the West Indies, the wood of which is hard and durable; very close, yellow-brown, and beautifully clouded. The sap is, however, a most deadly poison. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 250]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_manchineel" ;
    skos:prefLabel "Manchineel"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 250."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n250> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q636480> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
