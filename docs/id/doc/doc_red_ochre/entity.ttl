@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_red_ochre/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Red Ochre"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "**BROWN RED**, or **SPANISH RED**, (GER. *Braunroth*. DU. *Bruinrood*. DA. *Bruunrødt*. Sw. *Brunröd*. FR. *Brun rouge, Rouge brun. It. Rosso bruno. Sr. Almagre colorado, Almazarron. PORT. Almagre, Almagra,*) is produced by subjecting the species of earth called yellow ochre, to the action of fire, till it becomes perfectly red or nearly brown. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 848]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_red_ochre" ;
    skos:prefLabel "Red Ochre"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 848."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n848> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
