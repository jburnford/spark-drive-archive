    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "this dyewood is now referred to *Pterocarpus angolensis*. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 443]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_barwood" ;
    skos:prefLabel "Barwood"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 443."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
