<id/doc/doc_liquid_amber/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Liquid Amber"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:definition "is obtained from the _liquidambar styraciflua_, a tree which grows in Mexico, Louisiana, and Virginia. Some specimens are thin, like oil, and others are thickish, like turpentine. It is transparent, amber coloured, has an agreeable and powerful smell, and an aromatic taste, which feels pungent in the throat. Boiling alcohol dissolves it almost entirely. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_liquid_amber" ;
    skos:prefLabel "Liquid Amber"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 587."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/generalcommercia00mort/page/n587>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q469652> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/02/0220/#concept> .
