<id/doc/doc_natron/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Natron"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
