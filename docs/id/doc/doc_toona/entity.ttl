<id/doc/doc_toona/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Toona"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "the Hindustani name for the *Cedrela Toona*, a valuable tree, of large size, abundant in Travancore, and other parts of India. The reddish-coloured wood, used all over India in cabinet-making, is scarcely inferior to mahogany, but lighter, and not so close in the grain. It is often sold under the general name of Chittagong wood. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 396]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_toona" ;
    skos:prefLabel "Toona"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 396."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n396> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q50838988> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
