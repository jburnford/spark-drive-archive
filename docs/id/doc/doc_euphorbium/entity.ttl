<id/doc/doc_euphorbium/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Euphorbium"@en ;
    skos:altLabel "Gum Euphorbium"@en, "euphorbia candelabrum"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:definition "a concrete gum-resin obtained from several species of *Euphorbia* in the East, and used medicinally. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 157]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_euphorbium" ;
    skos:prefLabel "Euphorbium"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 157."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n157> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
