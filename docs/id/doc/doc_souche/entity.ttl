<id/doc/doc_souche/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Souche"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "a kind of free-stone; a French name for the pendulous mucilaginous tubers of the *Cyperus esculentus*, which are cultivated in the South of Europe, and eaten like nuts, being nutritive, restorative, and stimulant. They are also employed in the preparation of orgeat. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 365]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_souche" ;
    skos:prefLabel "Souche"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 365."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n365> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q1165724> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
