<id/doc/doc_anchovy_pear/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Anchovy Pear"@en ;
    skos:broader <id/grp/grp_fruits_nuts_vegetables/#concept> ;
    skos:definition "the *Persa gratissima*, an esteemed edible butyraceous fruit of the tropics. See **AVOCADO**. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 23]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_anchovy_pear" ;
    skos:prefLabel "Anchovy Pear"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0402 (Fruit Raw unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 23."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n23> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0402/#concept> .
