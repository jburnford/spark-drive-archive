@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_greenheart/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Greenheart"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a common tree of Guiana, the *Nectandra Rodiei*; its timber, squaring from 18 to 24 inches, can be procured without a knot from 60 to 70 feet long. It is a fine-grained hard wood, well adapted for the planking of vessels, house frames, wharves, bridges, and other purposes, where great strength and durability are required. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 192]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_greenheart" ;
    skos:prefLabel "Greenheart"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 192."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n192> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q87635658> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
