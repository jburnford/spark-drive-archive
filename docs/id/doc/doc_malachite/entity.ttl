<id/doc/doc_malachite/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Malachite"@en ;
    skos:broader <id/grp/grp_metallic_ores/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q164411> ;
    skos:definition "or _mountain green_, is native carbonate of copper of a beautiful green colour, with variegated radiations and zones; spec. grav. 3·5; it scratches calc-spar, but not fluor; by calcination it affords water and turns black. Its solution in the acids, deposits copper upon a plate of iron plunged into it. It consists of carbonic acid 18·5; deutoxide of copper 72·2; water 9·3. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_malachite" ;
    skos:prefLabel "Malachite"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0382 (Ore Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 249."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n249>, <https://archive.org/details/generalcommercia00mort/page/n610>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_28_Metalliferous_Ores" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/03/0382/#concept> .
