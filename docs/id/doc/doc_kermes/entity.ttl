<id/doc/doc_kermes/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Kermes"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q906954> ;
    skos:definition "an insect produced on the *Quercus coccifera*, which furnishes a red colouring matter. Also the name for a brick-red mineral powder, a fictitious sulphuret of antimony, for dyeing, and formerly used in medicine. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 225]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_kermes" ;
    skos:prefLabel "Kermes"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 225, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 548."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n225>, <https://archive.org/details/generalcommercia00mort/page/n548> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q158178> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0054/#concept> .
