<id/doc/doc_crab_wood/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Crab Wood"@en ;
    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:definition "a light wood obtained in Guiana from the *Carapa Guianensis*, which takes a high polish, and is used for masts and spars, floorings, partitions, and doors of houses. There are two varieties, the red and the white. It may be cut from 40 to 60 feet in length, with a square of 14 or 16 inches. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 124]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_crab_wood" ;
    skos:prefLabel "Crab Wood"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0070 (Wood Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 124."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n124> ;
    <ontology/ghostAcresDomain/#resource> "timber_forestry" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "forest_harvest" ;
    <ontology/landBasis/#resource> "terrestrial_forest" ;
    <ontology/sitcCode/#resource> "SITC4_24_Cork_and_Wood" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q309552> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/00/0070/#concept> .
