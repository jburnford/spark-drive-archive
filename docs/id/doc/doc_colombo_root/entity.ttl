<id/doc/doc_colombo_root/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Colombo Root"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "an esteemed medicinal root obtained in eastern Africa from the *Cocculus palmatus* of Linnæus, the *Menispermum palmatum* of others, and which is a most valuable antiseptic and tonic. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 111]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_colombo_root" ;
    skos:prefLabel "Colombo Root"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 111."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n111> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
