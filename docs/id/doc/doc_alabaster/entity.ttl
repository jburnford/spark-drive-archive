<id/doc/doc_alabaster/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Alabaster"@en ;
    skos:broader <id/grp/grp_industrial_minerals/#concept> ;
    skos:definition "is a stone usually white, and soft enough to be scratched by iron. There are two kinds of it: the gypseous, which is merely a natural semi-crystalline sulphate of lime; and the calcareous alabaster, which is a carbonate of lime. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_alabaster" ;
    skos:prefLabel "Alabaster"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0205 (Stone). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 18."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n18>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_27_Crude_Fertilizers_and_Minerals" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/02/0205/#concept> .
