<id/doc/doc_cashew_nut/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Cashew Nut"@en ;
    skos:altLabel "Cashew Nuts"@en ;
    skos:broader <id/grp/grp_oilseeds/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q7885904> ;
    skos:definition "a nut attached to the fruit of *Anacardium occidentale*, the sweet kernels of which are used as an edible fruit. An oil is obtained from the inner shell, and the bark of the tree has been used for tanning. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 86]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_cashew_nut" ;
    skos:prefLabel "Cashew Nut"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0012 (Seeds Unenumerated Other Sorts). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 86."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n86> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
