<id/doc/doc_bush_tea/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Bush Tea"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "the leaflets of a species of *Cyclopia*, probably *C. latifolia*, native of the Cape of Good Hope, supposed to possess expectorant and restorative properties; a few bags of this drug have been imported into London. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 68]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_bush_tea" ;
    skos:prefLabel "Bush Tea"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 68."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n68> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_07_Coffee_Tea_Cocoa_Spices" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
