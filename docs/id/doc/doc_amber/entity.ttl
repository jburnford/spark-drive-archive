    skos:definition "a valuable fossil resin used in the arts, in pharmacy, and for articles of personal decoration. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 22]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_amber" ;
    skos:prefLabel "Amber"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 22, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 41."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n22>, <https://archive.org/details/dictionaryprac00mccu/page/n88>, <https://archive.org/details/generalcommercia00mort/page/n41> ;
