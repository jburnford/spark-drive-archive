<id/doc/doc_sarcocolla/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Sarcocolla"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "a medicinal gum, now little used and scarce, obtained from the *Penica mucronata*, a native of Persia and Arabia. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 340]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_sarcocolla" ;
    skos:prefLabel "Sarcocolla"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 340, J. R. McCulloch, Dictionary of Commerce and Commercial Navigation (1880), scan p. 1325."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n340>, <https://archive.org/details/dictionaryprac00mccu/page/n1325> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
