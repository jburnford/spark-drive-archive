<id/doc/doc_atropa_belladonna/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Atropa Belladonna"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "*Linn.*; *Fl. Br. Ind.*, iv., 241; **SOLANACEÆ.** Deadly Nightshade, *sangangúr*, *angúr-shéfa*, *súchí*, *girbúti*, *ustrung*, *yebraj*, *luckmuna*. A coarse glabrous herb native of the Western Himalaya from Simla to Kashmir at altitudes of 6,000 to 12,000 feet; distributed to Europe and North Persia. D.E.P., i., 351-3. [Sir George Watt, The Commercial Products of India (1908), scan p. 107]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_atropa_belladonna" ;
    skos:prefLabel "Atropa Belladonna"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Sir George Watt, The Commercial Products of India (1908), scan p. 107."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b31361584/page/n107> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_pharmaceuticals/#concept> .
