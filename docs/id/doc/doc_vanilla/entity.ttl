<id/doc/doc_vanilla/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Vanilla"@en ;
    skos:broader <id/grp/grp_spices_condiments/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q13241> ;
    skos:definition "an exquisite perfume and aromatic, the thin pod-like capsule of the *Vanilla planifolia*, a native of South America. Vanilla is one of the most esteemed of all aromatics, and very expensive, costing five or six guineas the pound. It is used to flavour chocolate and confectioneries, and is much esteemed on the Continent as an ingredient in some stimulating and tonic remedies. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 409]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_vanilla" ;
    skos:prefLabel "Vanilla"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0408 (Spices Unenumerated). Attested in: 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 409, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 976."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n409>, <https://archive.org/details/generalcommercia00mort/page/n976>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "food_colonial_grocery" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_07_Coffee_Tea_Cocoa_Spices" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q7224923> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/04/0408/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_chocolate_confectionery/#concept>, <ontology/ind_perfumery_cosmetics/#concept> .
