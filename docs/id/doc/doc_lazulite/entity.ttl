<id/doc/doc_lazulite/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Lazulite"@en ;
    skos:broader <id/grp/grp_industrial_minerals/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q412651> ;
    skos:definition "(Eng. and Fr.; _Lazulith_, Germ.); is a blue vitreous mineral, crystallizing in rhomboidal dodecahedrons; spec. grav. 2·76 to 2·94; scratches glass; affords a little water by calcination; fusible into a white glass; dissolves in acids with loss of colour; solution leaves an alkaline residuum, after being treated with carbonate of ammonia, filtered, evaporated, and calcined. It consists of silica, 35·8; [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_lazulite" ;
    skos:prefLabel "Lazulite"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1905 (Minerals Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 236."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n236>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "minerals_metals_energy" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "mineral_extraction" ;
    <ontology/landBasis/#resource> "mineral" ;
    <ontology/sitcCode/#resource> "SITC4_27_Crude_Fertilizers_and_Minerals" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/19/1905/#concept> .
