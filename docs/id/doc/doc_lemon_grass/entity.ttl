<id/doc/doc_lemon_grass/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Lemon Grass"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:definition "a name for the *Andropogon citratum* of Decandolle. From its fragrant smell and pleasant taste, it is in common use in the West Indies as a substitute for Chinese tea, and is frequently employed as a sudorific in febrile diseases. The white succulent centre or pith of the leaves is used in India to give an agreeable flavour to curries. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 238]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_lemon_grass" ;
    skos:prefLabel "Lemon Grass"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 238, P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 480."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n238>, <https://archive.org/details/b21780535/page/n480> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "cultivated" ;
    <ontology/landBasis/#resource> "terrestrial_crop" ;
    <ontology/sitcCode/#resource> "SITC4_05_Vegetables_and_Fruit" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q39544145> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0124/#concept> .
