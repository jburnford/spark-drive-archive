<id/doc/doc_cedra/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Cedra"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:definition "a species of Italian citron having a thick rind which contains much essential oil, and is used for making perfumes, and for flavouring liqueurs. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 90]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_cedra" ;
    skos:prefLabel "Cedra"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 90, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n90>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0124/#concept> .
