<id/doc/doc_dragon_s_blood/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Dragon's Blood"@en ;
    skos:altLabel "Gum Dragon's Blood"@en, "sanguis draconis"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:definition "a resinous astringent extract, of a deep red colour, obtained from the fleshy fruits of the *Calamus Draco*, a plant of Sumatra and the Malay islands. It is chiefly used as a colouring ingredient for spirit and turpentine varnishes and paints, for staining marble, preparing gold lacker, dentifrices, &c. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 144]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_dragon_s_blood" ;
    skos:prefLabel "Dragon's Blood"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 144, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 275."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n144>, <https://archive.org/details/generalcommercia00mort/page/n275> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/sourceTaxon/#resource> <http://www.wikidata.org/entity/Q21248456> ;
    <ontology/subsumedInCustomsHeading/#resource> <id/02/0220/#concept> .
