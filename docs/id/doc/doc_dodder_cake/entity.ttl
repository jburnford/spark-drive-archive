    skos:definition "an oil cake made in Lubeck from the mare of the seed of the *Camelina sativa*. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 141]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_dodder_cake" ;
    skos:prefLabel "Dodder Cake"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:1026 (Oil Seed Cake Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 141."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
