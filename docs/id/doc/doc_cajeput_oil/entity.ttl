<id/doc/doc_cajeput_oil/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Cajeput Oil"@en ;
    skos:altLabel "Cajeput"@en ;
    skos:broader <id/grp/grp_vegetable_oils/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q857162> ;
    skos:definition "is obtained from the leaves of the tree called Melaleuca Leucadendron by Linnæus, which grows upon the mountains of Amboyna, and in other of the Molucca islands. It is procured by distillation of the dried leaves along with water, is prepared in great quantities in the island of Banda, and sent to Holland in copper flasks. Hence as it comes to us, it has a green colour. [Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_cajeput_oil" ;
    skos:prefLabel "Cajeput Oil"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0124 (Oil Unenumerated). Attested in: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "fats_oils_soap" ;
    <ontology/groundingStatus/#resource> "document_attested_grounded" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0124/#concept> .
