<id/doc/doc_sal_ammoniac/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Sal Ammoniac"@en ;
    skos:broader <id/grp/grp_industrial_chemicals_alkalis/#concept> ;
    skos:definition "the hydrochlorate of ammonia, obtained by saturating the ammoniacal liquor of gas-works with muriatic acid, and afterwards sublimating it. It has many commercial uses; as for medicine, metallurgic operations, thinning and soldering, &c. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 338]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_sal_ammoniac" ;
    skos:prefLabel "Sal Ammoniac"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0506 (Chemical Manufactures and Products Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 338."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n338> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/05/0506/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_metallurgy_tinplate/#concept> .
