<id/doc/doc_labdanum/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Labdanum"@en ;
    skos:broader <id/grp/grp_gums_resins_naval_stores/#concept> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q909160> ;
    skos:definition "a scarce and expensive medicinal resin, obtained from the surface of the leaves of *Cistus Creticus* in Candia, &c. It is used in plasters, in perfumery, for pastilles, and as an expectorant. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 231]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_labdanum" ;
    skos:prefLabel "Labdanum"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0220 (Gum Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 231, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n231>, <https://www.gutenberg.org/ebooks/44562> ;
