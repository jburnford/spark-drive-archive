<id/doc/doc_silk_cotton/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Silk Cotton"@en ;
    skos:broader <id/grp/grp_bast_plant_fibres/#concept> ;
    skos:definition "a name given to tho silky down or fibre obtained from the *Bombax*, *Calotropis*, *Cryptostegia*, and other plants, which is useful for stuffing pillows, paper-making, &c. *See* KAPOK. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 356]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_silk_cotton" ;
    skos:prefLabel "Silk Cotton"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0822 (Esparto and other Vegetable Fibres for making Paper). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 356."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n356> ;
    <ontology/ghostAcresDomain/#resource> "fibres_textiles" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "animal_husbandry" ;
    <ontology/landBasis/#resource> "terrestrial_pasture" ;
    <ontology/sitcCode/#resource> "SITC4_26_Textile_Fibres" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/08/0822/#concept> .
