@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<id/doc/doc_musk/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Musk"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "Musk is used to denote a class of substances that emit a strong scent that is commonly used as a base note in perfumes. The name was originally derived from the gland secretions from the mush deer, but can now also be used to refer to scents obtained from other animals and plants. (https://en.wikipedia.org/wiki/Musk) Musk is used as an antispasmodic and stimulant in the Compendium, being noted as “one of the stronges [Danika Drugs Project: British Pharmacopoeia (1867) / Savory (1865)]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_musk" ;
    skos:prefLabel "Musk"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: Danika Drugs.xlsx (British Pharmacopoeia 1867 / Savory 1865), 1866 British Customs Commodities List (Danika / HGIS Lab), P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 267, Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 651."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n267>, <https://archive.org/details/dictionaryprac00mccu/page/n999>, <https://archive.org/details/generalcommercia00mort/page/n651> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> ;
    <ontology/usedInIndustry/#resource> <ontology/ind_chocolate_confectionery/#concept>, <ontology/ind_perfumery_cosmetics/#concept>, <ontology/ind_soap_manufacture/#concept> .
