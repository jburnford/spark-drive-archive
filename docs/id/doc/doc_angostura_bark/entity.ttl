<id/doc/doc_angostura_bark/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Angostura Bark"@en ;
    skos:altLabel "Cusparia Bark"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "an aromatic bitter bark, obtained in South America from the *Galipea cusparia*, or *officinalis*; a false Angostura bark, of dangerous properties, is peeled from the *Strychnos nux vomica* in India. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 24]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_angostura_bark" ;
    skos:prefLabel "Angostura Bark"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 24."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n24> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
