<id/doc/doc_kermes_mineral/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Kermes Mineral"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:definition "a compound of sulphuret of antimony and potash. It is principally employed for medicinal purposes. [Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 548]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_kermes_mineral" ;
    skos:prefLabel "Kermes Mineral"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0054 (Dye Stuffs Unenumerated). Attested in: Thomas Mortimer (rev. Dickinson), A General Commercial Dictionary (1823), scan p. 548."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
