<id/doc/doc_opobalsam/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Opobalsam"@en ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "an oleo-resin obtained from the *Amyris Gileadensis*, and *A. Opobalsam*, which has a fragrant odour, and is used medicinally. It is sometimes called balm of Gilead, and is chiefly used as a cosmetic by the Turkish ladies. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 278]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "doc_opobalsam" ;
    skos:prefLabel "Opobalsam"@en ;
    skos:scopeNote "Document-attested minor 19th-century commodity absent as a standalone line in Layer-1 British/Canadian customs ledgers; typically subsumed under htc:0122 (Drugs Unenumerated). Attested in: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 278, Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (Project Gutenberg #44562)."@en ;
    <ontology/attestationBasis/#resource> "document_attested" ;
    <ontology/dictionarySource/#resource> <https://archive.org/details/b21780535/page/n278>, <https://www.gutenberg.org/ebooks/44562> ;
    <ontology/ghostAcresDomain/#resource> "drugs_botanicals_chemicals" ;
    <ontology/groundingStatus/#resource> "document_attested_local" ;
    <ontology/harvestMode/#resource> "unclassified" ;
    <ontology/landBasis/#resource> "unclassified" ;
    <ontology/sitcCode/#resource> "oe:sitcUnassigned" ;
    <ontology/subsumedInCustomsHeading/#resource> <id/01/0122/#concept> .
