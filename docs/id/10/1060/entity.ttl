    skos:broader <id/grp/grp_hewn_round_timber/#concept> ;
    skos:editorialNote "Curated classification (group=grp_hewn_round_timber): Hop poles, hoop/telegraph poles and piling are round timber; classifier matched 'hop' (the brewing crop) or left the heading in residuals. Layer-1 observations: 23 rows, 1893–1897. Series: CSP_Canadian_Exports_BlankSeries (inferred, series not printed) ×23. Units: (no unit) ×23. Top routes: Canada → United States ×3; Canada → All Countries ×3; Quebec → All Countries ×3; Nova Scotia → All Countries ×3."@en, "Curated fields — definition drop: 'Piling' as stowage of staves; heading is timber piles (Canada 1893–97)."@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "1060" ;
    skos:prefLabel "Piling"@en ;
