    skos:prefLabel "Cutch"@en ;
    skos:related <id/02/0206/#concept> ;
    skos:scopeNote "Historical South/Southeast Asian vegetable tanning and dyeing extract (Senegalia catechu); 19th-century customs clerks frequently conflated cutch and gambier under 'Terra Japonica'."@en ;
