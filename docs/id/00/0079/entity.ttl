<id/00/0079/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Maple Sugar"@en ;
    skos:broader <id/grp/grp_sugars_sweeteners/#concept> ;
    skos:definition "sugar prepared from the sap of the *Acer saccharinum*, which is largely made for home consumption by the settlers in parts of the United States and British North American Provinces: usually it is of a dark treacle colour, as it does not granulate readily; but it is occasionally refined and bleached. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 252]"@en ;
    skos:editorialNote "Curated fields — source_taxon remove: Silver maple; maple sugar is from Acer saccharum."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q402587> ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0079" ;
    skos:prefLabel "Maple Sugar"@en ;
    skos:related <id/03/0360/#concept>, <id/16/1644/#concept> ;
    skos:scopeNote "North American forest-derived sweetener (Acer saccharum); assigned oe:landBasis 'terrestrial_forest' to distinguish sugarbush forest harvest from arable cane/beet cropland."@en ;
