<id/17/1763/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Rock Moss"@en ;
    skos:broader <id/grp/grp_natural_dyestuffs/#concept> ;
    skos:editorialNote "Curated classification (group=grp_natural_dyestuffs): Named dye or pigment (annotto, orchella, weld, rock moss = orchil lichen per Mortimer 1823 s.v. ROCK MOSS 'See ORCHILLA', vermilion, zaffre, verdigris, lampblack) left in the residual bin. Layer-1 observations: 5 rows, 1800–1800. Series: KEW_CUST 5 ×5. Units: Tons ×5. Top routes: Sweden → United Kingdom ×1; World → United Kingdom ×1; Germany → United Kingdom ×1; Channel Islands → United Kingdom ×1."@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "1763" ;
    skos:prefLabel "Rock Moss"@en ;
