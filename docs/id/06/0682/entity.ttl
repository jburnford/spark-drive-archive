<id/06/0682/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Rhubarb"@en ;
    skos:broadMatch <customs-1866/vegetable/#concept> ;
    skos:broader <id/grp/grp_drugs_medicinal_botanicals/#concept> ;
    skos:definition "a genus of plants, the *Rheum*, of extensive use, the stalks of some British varieties being used for making ples and wine. As much as 100,000 dozen bundles are annually sold in London; while the roots of many exotic varieties form an important drug. In 1855 we imported 65,591 lbs. of rhubarb. [P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 330]"@en ;
    skos:inScheme <id/scheme/#resource> ;
    skos:notation "0682" ;
    skos:prefLabel "Rhubarb"@en ;
