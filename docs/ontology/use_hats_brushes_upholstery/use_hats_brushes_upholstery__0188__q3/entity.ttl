    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Skins Furs Pelts Beaver used in Hat-Making, Brushes, Upholstery & Turnery: Mortimer (1823), General Commercial Dictionary, scan p. 302"@en ;
    <ontology/quoteText/#resource> "The finest is used as a substitute for beaver in the manufacture of hats, and the coarser or stronger sort is employed in the fabrication of a stuff, which resembles a fine woollen cloth."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
