@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<ontology/definesConcept/#resource> a owl:ObjectProperty ;
    rdfs:label "archival concept defined by this dictionary source page"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/dictionarySource/#resource> .
