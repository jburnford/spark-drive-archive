<ontology/use_cordage_shipbuilding/use_cordage_shipbuilding__0207__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 874" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n874/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Tar used in Shipbuilding, Rope, Cordage & Sailcloth: Mortimer (1823), General Commercial Dictionary, scan p. 874"@en ;
    <ontology/quoteText/#resource> "We have hitherto confined our observations only to the manufacture of ropes themselves; we must now say a few words on the adventitious aid sought from tar, and other things, in order to augment the strength and durability of cordage."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
