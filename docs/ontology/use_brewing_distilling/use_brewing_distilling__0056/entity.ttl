<ontology/use_brewing_distilling/use_brewing_distilling__0056/#resource> a <ontology/EndUseAssertion/#resource> ;
    rdfs:label "Hops used in Brewing, Malting & Distilling"@en ;
    skos:editorialNote "Review decision (prune): Quote removed: it describes an unnamed adulterant used as a substitute for hops, not hops as an input."@en ;
    <ontology/assertsCommodity/#resource> <id/00/0056/#concept> ;
    <ontology/assertsIndustry/#resource> <ontology/ind_brewing_distilling/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_brewing_distilling/use_brewing_distilling__0056__q1/#resource>, <ontology/use_brewing_distilling/use_brewing_distilling__0056__q2/#resource> ;
    <ontology/productionRole/#resource> "flavouring_or_scent" ;
    <ontology/reviewStatus/#resource> "reviewed" .
