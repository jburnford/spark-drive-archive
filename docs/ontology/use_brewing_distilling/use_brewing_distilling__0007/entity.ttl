    <ontology/assertsIndustry/#resource> <ontology/ind_brewing_distilling/#concept> ;
    <ontology/hasEvidence/#resource> <ontology/use_brewing_distilling/use_brewing_distilling__0007__q1/#resource>, <ontology/use_brewing_distilling/use_brewing_distilling__0007__q2/#resource> ;
