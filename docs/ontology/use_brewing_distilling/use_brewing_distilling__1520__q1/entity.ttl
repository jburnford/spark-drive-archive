<ontology/use_brewing_distilling/use_brewing_distilling__1520__q1/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 459" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n459/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Juniper Berries used in Brewing, Malting & Distilling: Mortimer (1823), General Commercial Dictionary, scan p. 459"@en ;
    <ontology/quoteText/#resource> "The best is said to be made by distilling a second time Scotch whiskey with the addition of juniper berries; but for the ordinary sort, oil of turpentine is substituted in the manufactory instead of the juniper."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
