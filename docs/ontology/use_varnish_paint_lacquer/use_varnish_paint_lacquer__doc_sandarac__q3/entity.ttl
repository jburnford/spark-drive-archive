<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__doc_sandarac__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 978" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n978/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Sandarac used in Varnish, Paint & Lacquer: Mortimer (1823), General Commercial Dictionary, scan p. 978"@en ;
    <ontology/quoteText/#resource> "If the varnish is to produce a red colour, more of the lac, and less of the sandarach should be used, and a little dragon's blood should be added."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
