<ontology/use_varnish_paint_lacquer/use_varnish_paint_lacquer__0467__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 303" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n303/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Asphalt or Bitumen used in Varnish, Paint & Lacquer: Mortimer (1823), General Commercial Dictionary, scan p. 303"@en ;
    <ontology/quoteText/#resource> "The varnish ought always to be harder in summer than winter, and it will become so, if it be permitted to boil longer, or a greater portion of the asphaltum be used."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
