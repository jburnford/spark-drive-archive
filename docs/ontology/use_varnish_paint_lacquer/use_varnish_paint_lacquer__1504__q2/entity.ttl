    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Oil Seed used in Varnish, Paint & Lacquer: Mortimer (1823), General Commercial Dictionary, scan p. 680"@en ;
    <ontology/quoteText/#resource> "Linseed-oil, nut-oil, poppy-oil, and hemp-seed-oil, possess this property; but linseed-oil is almost the only one of these liquids employed in this country as drying oil."@en ;
