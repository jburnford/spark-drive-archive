@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<ontology/matchedObservationCount/#resource> a owl:DatatypeProperty ;
    rdfs:domain <ontology/ScopedReading/#resource> ;
    rdfs:label "Layer-1 rows falling inside the scope of a reading"@en ;
    rdfs:range <http://www.w3.org/2001/XMLSchema#integer> .
