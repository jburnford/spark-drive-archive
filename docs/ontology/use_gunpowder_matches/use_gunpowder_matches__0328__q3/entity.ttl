<ontology/use_gunpowder_matches/use_gunpowder_matches__0328__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 891" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n891/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Saltpetre used in Gunpowder, Explosives & Lucifer Matches: Mortimer (1823), General Commercial Dictionary, scan p. 891"@en ;
    <ontology/quoteText/#resource> "Saltpetre is of very extensive use in different arts, being the principal ingredient in gunpowder, and serving as an excellent flux to other matters; whence its use in glass-making."@en ;
