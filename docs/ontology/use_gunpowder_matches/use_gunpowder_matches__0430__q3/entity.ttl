<ontology/use_gunpowder_matches/use_gunpowder_matches__0430__q3/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 744" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n744/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Brimstone used in Gunpowder, Explosives & Lucifer Matches: McCulloch (1880), Dictionary of Commerce, scan p. 744"@en ;
    <ontology/quoteText/#resource> "The proportions of the ingredients vary very considerably; but good gunpowder may be composed of the following: viz. 76 parts of nitre, 15 of charcoal, and 10 of sulphur."@en ;
