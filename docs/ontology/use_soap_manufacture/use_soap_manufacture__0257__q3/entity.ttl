    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Salt used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. SOAP"@en ;
    <ontology/quoteText/#resource> "The soda-ash used by the soap-boiler, contains in general about 36 per cent. of real soda, in the state of dry carbonate, mixed with muriate of soda, and more or less undecomposed sulphate."@en ;
