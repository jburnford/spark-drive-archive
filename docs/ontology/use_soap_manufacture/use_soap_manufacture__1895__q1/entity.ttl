    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Kelp used in Soap Manufacture: Andrew Ure, A Dictionary of Arts, Manufactures, and Mines (2nd ed., 1840; Project Gutenberg #44562), s.v. IODINE"@en ;
    <ontology/quoteText/#resource> "Iodine is most economically procured from the mother-water of kelp, as furnished by those manufacturers of soap in Scotland and elsewhere who employ this crude alkaline matter."@en ;
