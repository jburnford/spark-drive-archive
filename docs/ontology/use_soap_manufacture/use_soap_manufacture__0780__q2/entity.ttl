<ontology/use_soap_manufacture/use_soap_manufacture__0780__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 370" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n370/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Barilla used in Soap Manufacture: Mortimer (1823), General Commercial Dictionary, scan p. 370"@en ;
    <ontology/quoteText/#resource> "The greatest quantity of oil is made in the kingdom of Valencia. Ashes.—There are three sorts of ashes made in Spain, namely, barilla, bourdina, 560 and aqua-azul; they are used in the manufacture of soap, glass, and crystal."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
