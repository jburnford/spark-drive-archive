<ontology/use_soap_manufacture/use_soap_manufacture__0136__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 310" ;
    dcterms:source <https://archive.org/details/b21780535/page/n310> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Pearl and Pot Ashes used in Soap Manufacture: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 310"@en ;
    <ontology/quoteText/#resource> "POTASH: such constituents of burned vegetables as are very soluble in water, and fixed in the fire; the lixivium of the ashes of wood fuel evaporated in iron pots. These ashes are principally used in the manufacture of flint glass, pumice of potash, and soft soap. The imports of pot and pearl ash range from 4000 to 9000 tons a-year."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
