<ontology/ind_paper_making/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Paper Making & Cardboard"@en ;
    skos:definition "Paper, pasteboard, and millboard manufacture — pulping linen/cotton rags, esparto grass, wood pulp, straw, hemp, and jute, bleached with chloride of lime, sized with rosin/alum/gelatine/starch, and loaded or tinted with kaolin, smalt, and ultramarine."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Paper Making & Cardboard"@en ;
    skos:topConceptOf <ontology/industry_scheme/#resource> ;
