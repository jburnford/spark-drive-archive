    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n686/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Olive Oil used in Woollen, Silk & Worsted Dyeing: Mortimer (1823), General Commercial Dictionary, scan p. 686"@en ;
    <ontology/quoteText/#resource> "Gallipoli, a sea-port town in the province of Otranto, is the place in the kingdom of Naples from which the greatest quantity of olive-oil, and the best quality for the use of the British woollen manufactures is exported."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
