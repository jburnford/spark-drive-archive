<ontology/ind_woollen_silk_dyeing/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Woollen, Silk & Worsted Dyeing"@en ;
    skos:definition "Woollen, worsted, and silk scouring, fulling, and dyeing — employing raw wool and silk with scarlet/crimson insect dyes (cochineal, lac dye, kermes), lichen dyes (orchal, archil, cudbear), indigo/woad vats, alum/tartar/tin mordants, olive oil, and fuller's earth."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Woollen, Silk & Worsted Dyeing"@en ;
    skos:topConceptOf <ontology/industry_scheme/#resource> ;
