<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__0196__q1/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 880" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n880/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Iron Ore Including Chrome used in Metallurgy, Smelting, Brass & Tinplate: McCulloch (1880), Dictionary of Commerce, scan p. 880"@en ;
    <ontology/quoteText/#resource> "Soon after this, Edward, Lord Dudley, invented a process for smelting iron ore with pit-coal instead of timber; and it is difficult to point out many inventions that have been so advantageous."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
