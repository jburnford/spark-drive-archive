<ontology/use_metallurgy_tinplate/use_metallurgy_tinplate__doc_bismuth__q3/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 937" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n937/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bismuth used in Metallurgy, Smelting, Brass & Tinplate: Mortimer (1823), General Commercial Dictionary, scan p. 937"@en ;
    <ontology/quoteText/#resource> "The pewterers use a kind of solder made with two parts of tin, and one of bismuth; this composition melts with the least heat of any of the solders."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
