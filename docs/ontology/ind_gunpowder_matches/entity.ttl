<ontology/ind_gunpowder_matches/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Gunpowder, Explosives & Lucifer Matches"@en ;
    skos:definition "Black gunpowder, blasting powder, guncotton, and lucifer/congreve friction matches — compounding saltpetre (potassium/sodium nitrate), brimstone (sulphur), and willow/alder charcoal, plus phosphorus, chlorate of potash, pine splints, paraffin, and glue for matches."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Gunpowder, Explosives & Lucifer Matches"@en ;
    skos:topConceptOf <ontology/industry_scheme/#resource> ;
    <ontology/usesCommodityInput/#resource> <id/03/0328/#concept>, <id/04/0430/#concept>, <id/12/1248/#concept>, <id/14/1474/#concept>, <id/doc/doc_chlorate_of_potash/#concept>, <id/doc/doc_nitric_acid/#concept>, <id/doc/doc_phosphorus/#concept> .
