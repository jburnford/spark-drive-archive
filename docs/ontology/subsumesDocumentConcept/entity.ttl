@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<ontology/subsumesDocumentConcept/#resource> a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:label "document-attested minor commodity subsumed inside this unenumerated customs heading"@en ;
    rdfs:range skos:Concept ;
    owl:inverseOf <ontology/subsumedInCustomsHeading/#resource> .
