<ontology/use_calico_printing/use_calico_printing__doc_citric_acid__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 103" ;
    dcterms:source <https://archive.org/details/b21780535/page/n103> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Citric Acid used in Calico Cloth & Calico Printing: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 103"@en ;
    <ontology/quoteText/#resource> "CITRIC ACID: the juice of limes neutralized with chalk, and the citrate of lime thus formed decomposed by sulphuric acid. It is largely made for domestic use and for calico-printing."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
