<ontology/use_calico_printing/use_calico_printing__1304__q2/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 1638" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n1638/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Bark Quercitron used in Calico Cloth & Calico Printing: McCulloch (1880), Dictionary of Commerce, scan p. 1638"@en ;
    <ontology/quoteText/#resource> "Hence quercitron bark is now employed in calico printing, to the almost total exclusion of weld."@en ;
