<ontology/use_calico_printing/use_calico_printing__doc_chlorate_of_potash__q1/#resource> dcterms:bibliographicCitation "McCulloch (1880), Dictionary of Commerce, scan p. 84" ;
    dcterms:source <https://archive.org/details/dictionaryprac00mccu/page/n84/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Chlorate of Potash used in Calico Cloth & Calico Printing: McCulloch (1880), Dictionary of Commerce, scan p. 84"@en ;
    <ontology/quoteText/#resource> "As an oxidising agent, chlorate of potash is used by the calico printer for heightening the intensity of 'steam colours;' and in the laboratory it is in constant request."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
