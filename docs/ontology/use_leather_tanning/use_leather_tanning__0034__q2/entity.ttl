<ontology/use_leather_tanning/use_leather_tanning__0034__q2/#resource> dcterms:bibliographicCitation "Mortimer (1823), General Commercial Dictionary, scan p. 378" ;
    dcterms:source <https://archive.org/details/generalcommercia00mort/page/n378/mode/1up> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Skins Furs Pelts Sheep Undressed used in Leather Tanning, Tawing & Currying: Mortimer (1823), General Commercial Dictionary, scan p. 378"@en ;
    <ontology/quoteText/#resource> "There is a dock-yard for ship-building, a large tannery, and a bleach-field. Kelso — has large manufactures of woollen cloth, and many hands are here employed in dressing sheep and lamb skins."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
