<ontology/use_leather_tanning/use_leather_tanning__0275__q1/#resource> dcterms:bibliographicCitation "P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180" ;
    dcterms:source <https://archive.org/details/b21780535/page/n180> ;
    a <ontology/EvidenceQuote/#resource> ;
    rdfs:label "Evidence for Cutch used in Leather Tanning, Tawing & Currying: P. L. Simmonds, The Commercial Dictionary of Trade Products (1892), scan p. 180"@en ;
    <ontology/quoteText/#resource> "GAMBIER: an extract prepared at Singapore from the Uncaria Gambir, and used as a dye and tanning substance. It is misnamed in trade circles Terra Japonica. The imports in the last few years have averaged 6000 tons per annum."@en ;
    <ontology/retrievalMode/#resource> "direct_sentence" .
