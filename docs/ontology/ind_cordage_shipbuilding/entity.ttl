<ontology/ind_cordage_shipbuilding/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Shipbuilding, Rope, Cordage & Sailcloth"@en ;
    skos:definition "Wooden ship construction, spars, sails, caulking, and marine cordage — combining oak, teak, greenheart, pine/fir masts, and copper sheathing with hemp, manila/abaca, coir, sisal, flax, oakum, tar, pitch, turpentine, and rosin."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Shipbuilding, Rope, Cordage & Sailcloth"@en ;
    skos:topConceptOf <ontology/industry_scheme/#resource> ;
