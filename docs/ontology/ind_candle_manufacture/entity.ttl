<ontology/ind_candle_manufacture/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Candle Manufacture"@en ;
    skos:definition "Dipped, mould, composite, stearine, wax, spermaceti, and paraffin candle manufacture — combining tallow, palm/coconut stearine, beeswax, spermaceti, and paraffin with cotton wicks and sulphuric acid/borax treatments."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Candle Manufacture"@en ;
    skos:topConceptOf <ontology/industry_scheme/#resource> ;
