<ontology/ind_pharmaceuticals/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Pharmaceuticals & Druggists' Preparations"@en ;
    skos:definition "19th-century apothecary, pharmacopoeia, and fine-chemical drug manufacture (e.g., Howard & Sons, Allen & Hanburys) — extracting alkaloids and preparing tinctures, pills, plasters, and ointments from cinchona/quinine, opium/morphia/laudanum, coca/cocaine, nux vomica/strychnine, quicksilver/calomel, ipecacuanha, jalap, senna, rhubarb, aloes, camphor, castor/cod-liver oils, and iodine."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Pharmaceuticals & Druggists' Preparations"@en ;
    skos:topConceptOf <ontology/industry_scheme/#resource> ;
