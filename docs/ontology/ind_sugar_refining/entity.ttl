@base <https://jimclifford.ca/spark-drive-archive/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<ontology/ind_sugar_refining/#concept> a <http://www.cidoc-crm.org/cidoc-crm/E55_Type>, skos:Concept ;
    rdfs:label "Sugar Refining"@en ;
    skos:definition "Refining raw colonial muscovado and beet sugars into loaf and granulated white sugar — clarifying and decolorizing raw cane sugar with lime, bullock's blood/albumen, animal charcoal (bone black), and clay."@en ;
    skos:inScheme <ontology/industry_scheme/#resource> ;
    skos:prefLabel "Sugar Refining"@en ;
    skos:topConceptOf <ontology/industry_scheme/#resource> ;
    <ontology/usesCommodityInput/#resource> <id/01/0162/#concept>, <id/03/0348/#concept>, <id/12/1248/#concept>, <id/doc/doc_albumen/#concept> .
